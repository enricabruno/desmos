     -->

    


    <!-- https://example.org/desmos/ontology/core/ConstraintOriginScheme -->

    <owl:NamedIndividual rdf:about="https://example.org/desmos/ontology/core/ConstraintOriginScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <skos:definition xml:lang="it">Vocabolario controllato per descrivere l’origine concettuale di una costrizione (tradizionale o invenzione autoriale).</skos:definition>
        <skos:definition xml:lang="en">Controlled vocabulary used to describe the conceptual origin of a constraint (tradition or authorial invention).</skos:definition>
        <skos:prefLabel xml:lang="it">Schema dell’origine della costrizione</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Constraint origin scheme</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://example.org/desmos/ontology/core/ConstraintScopeScheme -->

    <owl:NamedIndividual rdf:about="https://example.org/desmos/ontology/core/ConstraintScopeScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <skos:definition xml:lang="it">Vocabolario controllato per l’ambito testuale principalmente interessato da una costrizione letteraria.</skos:definition>
        <skos:definition xml:lang="en">Controlled vocabulary for the main textual scope affected by a literary constraint.</skos:definition>
        <skos:prefLabel xml:lang="it">Schema dell’ambito della costrizione</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Constraint scope scheme</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://example.org/desmos/ontology/core/formal -->

    <owl:NamedIndividual rdf:about="https://example.org/desmos/ontology/core/formal">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:definition xml:lang="it">Costrizione che incide principalmente su proprietà formali del testo (es. metrica, rima, pattern di lettere, impaginazione).</skos:definition>
        <skos:definition xml:lang="en">Constraint primarily affecting formal properties of the text (e.g., metre, rhyme, letter patterns, layout).</skos:definition>
        <skos:inScheme rdf:resource="https://example.org/desmos/ontology/core/ConstraintScopeScheme"/>
        <skos:prefLabel xml:lang="it">formale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">formal</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://example.org/desmos/ontology/core/ConstraintScopeScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://example.org/desmos/ontology/core/original -->

    <owl:NamedIndividual rdf:about="https://example.org/desmos/ontology/core/original">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:definition xml:lang="it">Categoria per costrizioni introdotte come invenzione autoriale (non derivate da una forma o prassi già stabilizzata nella tradizione).</skos:definition>
        <skos:definition xml:lang="en">Category for constraints introduced as an authorial invention (not derived from an already stabilised form or practice in the tradition).</skos:definition>
        <skos:inScheme rdf:resource="https://example.org/desmos/ontology/core/ConstraintOriginScheme"/>
        <skos:prefLabel xml:lang="it">originale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">original</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://example.org/desmos/ontology/core/ConstraintOriginScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://example.org/desmos/ontology/core/semantic -->

    <owl:NamedIndividual rdf:about="https://example.org/desmos/ontology/core/semantic">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:definition xml:lang="it">Costrizione che incide principalmente sul contenuto semantico o narrativo del testo (es. temi obbligati, personaggi o ambientazione fissa).</skos:definition>
        <skos:definition xml:lang="en">Constraint primarily affecting the semantic or narrative content of the text (e.g., required themes, fixed characters or setting).</skos:definition>
        <skos:inScheme rdf:resource="https://example.org/desmos/ontology/core/ConstraintScopeScheme"/>
        <skos:prefLabel xml:lang="it">semantico</skos:prefLabel>
        <skos:prefLabel xml:lang="en">semantic</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://example.org/desmos/ontology/core/ConstraintScopeScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://example.org/desmos/ontology/core/traditional -->

    <owl:NamedIndividual rdf:about="https://example.org/desmos/ontology/core/traditional">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:definition xml:lang="it">Categoria per costrizioni riprese dalla tradizione letteraria (e.g., metro, rima, forme fisse).</skos:definition>
        <skos:definition xml:lang="en">Category for constraints drawn from literary tradition (e.g., metre, rhyme).</skos:definition>
        <skos:inScheme rdf:resource="https://example.org/desmos/ontology/core/ConstraintOriginScheme"/>
        <skos:prefLabel xml:lang="it">tradizionale</skos:prefLabel>
        <skos:prefLabel xml:lang="en">traditional</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://example.org/desmos/ontology/core/ConstraintOriginScheme"/>
    </owl:NamedIndividual>
</rdf:RDF>



