    <!-- http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation -->

    <owl:Class rdf:about="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
    


    <!-- http://iflastandards.info/ns/lrm/lrmoo/F2_Expression -->

    <owl:Class rdf:about="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure -->

    <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure">
        <rdfs:label xml:lang="en">Design or Procedure</rdfs:label>
        <rdfs:label xml:lang="it">Progetto o Procedura</rdfs:label>
        <rdfs:comment xml:lang="it">Classe ereditata dal CIDOC CRM. In DeSMòS, viene utilizzata per inquadrare la natura procedurale delle costrizioni letterarie come piani d'azione generativi.</rdfs:comment>
        <rdfs:comment xml:lang="en">Class inherited from CIDOC CRM. In DeSMòS, it is used to frame the procedural nature of literary constraints as generative action plans.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object -->

    <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/E39_Actor -->

    <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->

    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#ConceptScheme -->

    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    


    <!-- http://www.w3.org/ns/prov#Agent -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent"/>
    


    <!-- http://www.w3.org/ns/prov#Entity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity"/>
    


    <!-- https://example.org/desmos/ontology/core/ConstraintDeclaration -->

    <owl:Class rdf:about="https://example.org/desmos/ontology/core/ConstraintDeclaration">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <owl:disjointWith rdf:resource="https://example.org/desmos/ontology/core/LiteraryConstraint"/>
        <owl:disjointWith rdf:resource="https://example.org/desmos/ontology/core/TextualFeature"/>
        <rdfs:comment xml:lang="it">Enunciato che rende esplicito l’impiego di una o più costrizioni letterarie. Può essere attribuito ad un critico o all'autore. Quando è attribuito all'autore può essere interno al testo (paratestuale) o esterno (epitestuale).</rdfs:comment>
        <rdfs:comment xml:lang="en">Statement that explicitly refers to the use of one or more literary devices. It can be attributed to a critic or to the author. When attributed to the author, it can be internal to the text (paratextual) or external (epitextual).</rdfs:comment>
        <rdfs:label xml:lang="it">Dichiarazione della costrizione</rdfs:label>
        <rdfs:label xml:lang="en">Constraint declaration</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/desmos/ontology/core/LiteraryConstraint -->

    <owl:Class rdf:about="https://example.org/desmos/ontology/core/LiteraryConstraint">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure"/>
        <owl:disjointWith rdf:resource="https://example.org/desmos/ontology/core/TextualFeature"/>
        <rdfs:comment xml:lang="en">A formal or semantic procedure intervening in the process of textual generation (F28 Expression Creation), whose presence is detectable through objective evidence (TextualFeature) independently of the explicit statement of authorial intent (ConstraintDeclaration).</rdfs:comment>
        <rdfs:comment xml:lang="it">Procedura formale o semantica che interviene nel processo di generazione testuale (F28 Expression Creation), la cui presenza può essere rilevabile attraverso evidenze oggettive (TextualFeature) indipendentemente dall&apos;esplicitazione di un&apos;intenzionalità autoriale (ConstraintDeclaration).</rdfs:comment>
        <rdfs:label xml:lang="it">Costrizione letteraria</rdfs:label>
        <rdfs:label xml:lang="en">Literary constraint</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/desmos/ontology/core/TextualFeature -->

    <owl:Class rdf:about="https://example.org/desmos/ontology/core/TextualFeature">
        <rdfs:comment xml:lang="it">Caratteristica osservabile dell’espressione che può rendere leggibile una costrizione. In DeSMòS è intesa come evidenza intratestuale: una traccia testuale che supporta l’identificazione della costrizione, senza implicare di per sé sufficienza o necessità.</rdfs:comment>
        <rdfs:comment xml:lang="en">Observable feature of an expression that may make a constraint legible. In DeSMòS it is treated as intratextual evidence: a textual trace supporting the identification of a constraint, without implying necessity or sufficiency by itself.</rdfs:comment>
        <rdfs:label xml:lang="it">Caratteristica testuale</rdfs:label>
        <rdfs:label xml:lang="en">Textual feature</rdfs:label>
    </owl:Class>
    


    <!-- 
