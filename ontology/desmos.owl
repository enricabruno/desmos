        <rdfs:comment xml:lang="en">Indicates an external resource that provides additional information.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- http://www.w3.org/2002/07/owl#versionInfo -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionInfo">
        <rdfs:label xml:lang="it">informazioni sulla versione</rdfs:label>
        <rdfs:label xml:lang="en">version info</rdfs:label>
        <rdfs:comment xml:lang="it">Dettagli testuali sullo stato della versione corrente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Textual details about the current version status.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- http://www.w3.org/2004/02/skos/core#exactMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch">
        <rdfs:label xml:lang="it">corrispondenza esatta</rdfs:label>
        <rdfs:label xml:lang="en">exact match</rdfs:label>
        <rdfs:comment xml:lang="it">Indica un collegamento di equivalenza semantica tra concetti di vocabolari diversi.</rdfs:comment>
        <rdfs:comment xml:lang="en">Used to link two concepts that indicate a high degree of confidence that the concepts can be used interchangeably.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition">
        <rdfs:label xml:lang="it">definizione</rdfs:label>
        <rdfs:label xml:lang="en">definition</rdfs:label>
        <rdfs:comment xml:lang="it">Una spiegazione del significato del concetto.</rdfs:comment>
        <rdfs:comment xml:lang="en">A statement of the meaning of the concept.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel">
        <rdfs:label xml:lang="it">etichetta preferita</rdfs:label>
        <rdfs:label xml:lang="en">preferred label</rdfs:label>
        <rdfs:comment xml:lang="it">Il termine preferito per rappresentare il concetto.</rdfs:comment>
        <rdfs:comment xml:lang="en">The preferred term for representing the concept.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- http://www.w3.org/2004/02/skos/core#topConceptOf -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#topConceptOf">
        <rdfs:label xml:lang="it">concetto principale di</rdfs:label>
        <rdfs:label xml:lang="en">top concept of</rdfs:label>
        <rdfs:comment xml:lang="it">Relazione tra un concetto e lo schema di cui è radice.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a concept to the concept scheme for which it is a top-level entry point.</rdfs:comment>
    </owl:AnnotationProperty>
    



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


     <!-- http://www.w3.org/2004/02/skos/core#inScheme -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme">
        <rdfs:label xml:lang="en">in scheme</rdfs:label>
        <rdfs:label xml:lang="it">nello schema</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a concept to the concept scheme it belongs to.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    </owl:ObjectProperty>

    <!-- http://iflastandards.info/ns/lrm/lrmoo/R15_has_fragment -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmoo/R15_has_fragment">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmoo/R17_created -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmoo/R17_created">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmoo/R76_is_derivative_of -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmoo/R76_is_derivative_of">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmoo/R3_is_realised_in -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmoo/R3_is_realised_in">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F1_Work"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by -->

    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P33_used_specific_technique -->

    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P33_used_specific_technique">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasAttributedTo -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    </owl:ObjectProperty>
    


    <!-- https://example.org/desmos/ontology/core/constraintOrigin -->

    <owl:ObjectProperty rdf:about="https://example.org/desmos/ontology/core/constraintOrigin">
        <rdfs:domain rdf:resource="https://example.org/desmos/ontology/core/LiteraryConstraint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:inverseOf rdf:resource="https://example.org/desmos/ontology/core/isOriginOf"/>
        <rdfs:comment xml:lang="it">Collega una costrizione letteraria ad un concetto SKOS che ne qualifica l&apos;origine concettuale (tradizione o invenzione autoriale).</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a constraint to a SKOS concept qualifying its conceptual origin (tradition or authorial invention).</rdfs:comment>
        <rdfs:label xml:lang="it">origine della costrizione</rdfs:label>
        <rdfs:label xml:lang="en">constraint origin</rdfs:label>
    </owl:ObjectProperty>

    <!-- https://example.org/desmos/ontology/core/isOriginOf -->

    <owl:ObjectProperty rdf:about="https://example.org/desmos/ontology/core/isOriginOf">
        <rdfs:label xml:lang="en">is origin of</rdfs:label>
        <rdfs:label xml:lang="it">è origine di</rdfs:label>
        <rdfs:comment xml:lang="it">Relazione inversa di constraintOrigin. Collega un concetto SKOS (tradizione o invenzione autoriale) alla costrizione letteraria di cui definisce la genesi.</rdfs:comment>
        <rdfs:comment xml:lang="en">Inverse relationship of constraintOrigin. Relates a SKOS concept (tradition or authorial invention) to the literary constraint whose genesis it defines.</rdfs:comment>
        <owl:inverseOf rdf:resource="https://example.org/desmos/ontology/core/constraintOrigin"/>
        <owl:inverseOf rdf:resource="https://example.org/desmos/ontology/core/constraintOrigin"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:range rdf:resource="https://example.org/desmos/ontology/core/LiteraryConstraint"/>
    </owl:ObjectProperty>
    


    <!-- https://example.org/desmos/ontology/core/constraintScope -->

    <owl:ObjectProperty rdf:about="https://example.org/desmos/ontology/core/constraintScope">
        <rdfs:domain rdf:resource="https://example.org/desmos/ontology/core/LiteraryConstraint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:inverseOf rdf:resource="https://example.org/desmos/ontology/core/isScopeOf"/>
        <rdfs:comment xml:lang="it">Indica l’ambito testuale principalmente vincolato da una costrizione letteraria (formale vs semantico). I valori sono tratti da un vocabolario controllato SKOS.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates the main textual scope affected by a literary constraint (formal vs semantic). Values are taken from a SKOS controlled vocabulary.</rdfs:comment>
        <rdfs:label xml:lang="it">ambito della costrizione</rdfs:label>
        <rdfs:label xml:lang="en">constraint scope</rdfs:label>
    </owl:ObjectProperty>

    <!-- https://example.org/desmos/ontology/core/isScopeOf -->

    <owl:ObjectProperty rdf:about="https://example.org/desmos/ontology/core/isScopeOf">
        <rdfs:label xml:lang="en">is scope of</rdfs:label>
        <rdfs:label xml:lang="it">è ambito di</rdfs:label>
        <rdfs:comment xml:lang="it">Relazione inversa di constraintScope. Collega un concetto SKOS (ambito formale o semantico) alla costrizione letteraria che lo adotta.</rdfs:comment>
        <rdfs:comment xml:lang="en">Inverse relationship of constraintScope. Relates a SKOS concept (formal or semantic scope) to the literary constraint that adopts it.</rdfs:comment>
        <owl:inverseOf rdf:resource="https://example.org/desmos/ontology/core/constraintScope"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:range rdf:resource="https://example.org/desmos/ontology/core/LiteraryConstraint"/>
    </owl:ObjectProperty>
    


    <!-- https://example.org/desmos/ontology/core/isConstraintUsedIn -->

    <owl:ObjectProperty rdf:about="https://example.org/desmos/ontology/core/isConstraintUsedIn">
        <owl:inverseOf rdf:resource="https://example.org/desmos/ontology/core/usedConstraint"/>
        <rdfs:label xml:lang="en">is constraint used in</rdfs:label>
        <rdfs:label xml:lang="it">è costrizione usata in</rdfs:label>
        <rdfs:comment xml:lang="it">Relaziona una costrizione letteraria all'evento di creazione dell'espressione in cui essa è stata impiegata come dispositivo generativo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a literary constraint to the expression creation event in which it was employed as a generative device.</rdfs:comment>
        <rdfs:domain rdf:resource="https://example.org/desmos/ontology/core/LiteraryConstraint"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
    </owl:ObjectProperty>
    


    <!-- https://example.org/desmos/ontology/core/isDeclaredIn -->

    <owl:ObjectProperty rdf:about="https://example.org/desmos/ontology/core/isDeclaredIn">
        <rdfs:domain rdf:resource="https://example.org/desmos/ontology/core/ConstraintDeclaration"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
        <owl:inverseOf rdf:resource="https://example.org/desmos/ontology/core/containsDeclaration"/>
        <rdfs:comment xml:lang="it">Relaziona una dichiarazione autoriale al frammento (E33 Linguistic Object) in cui la dichiarazione è espressa. Il frammento può essere collegato all’espressione tramite LRMoo R15_has_fragment.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an authorial declaration to the fragment (E33 Linguistic Object) in which the declaration is expressed. The fragment may be linked to the expression via LRMoo R15_has_fragment.</rdfs:comment>
        <rdfs:label xml:lang="en">is declared in</rdfs:label>
        <rdfs:label xml:lang="it">è dichiarata in</rdfs:label>
    </owl:ObjectProperty>


    <!-- https://example.org/desmos/ontology/core/containsDeclaration -->

    <owl:ObjectProperty rdf:about="https://example.org/desmos/ontology/core/containsDeclaration">
        <rdfs:label xml:lang="en">contains declaration</rdfs:label>
        <rdfs:label xml:lang="it">contiene dichiarazione</rdfs:label>
        <rdfs:comment xml:lang="it">Relazione inversa di isDeclaredIn. Collega un frammento linguistico (E33) alla dichiarazione autoriale di costrizione in esso espressa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Inverse relationship of isDeclaredIn. Relates a linguistic fragment (E33) to the authorial declaration of constraint expressed within it.</rdfs:comment>
        <owl:inverseOf rdf:resource="https://example.org/desmos/ontology/core/isDeclaredIn"/>
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
        <rdfs:range rdf:resource="https://example.org/desmos/ontology/core/ConstraintDeclaration"/>
    </owl:ObjectProperty>
    


    <!-- https://example.org/desmos/ontology/core/isFeatureOf -->

    <owl:ObjectProperty rdf:about="https://example.org/desmos/ontology/core/isFeatureOf">
        <rdfs:domain rdf:resource="https://example.org/desmos/ontology/core/TextualFeature"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
        <rdfs:comment xml:lang="it">Collega una caratteristica testuale al testo (F2_Expression) in cui la caratteristica è osservabile.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a textual feature to the text (F2_Expression) in which the feature is observable.</rdfs:comment>
        <rdfs:label xml:lang="it">caratteristica di</rdfs:label>
        <rdfs:label xml:lang="en">is feature of</rdfs:label>
        <owl:inverseOf rdf:resource="https://example.org/desmos/ontology/core/hasFeature"/>
    </owl:ObjectProperty>

    <!-- https://example.org/desmos/ontology/core/hasFeature -->

    <owl:ObjectProperty rdf:about="https://example.org/desmos/ontology/core/hasFeature">
    <rdfs:label xml:lang="en">has feature</rdfs:label>
    <rdfs:label xml:lang="it">ha caratteristica</rdfs:label>
    <rdfs:comment xml:lang="it">Relazione inversa di isFeatureOf. Collega un'espressione testuale (F2) alla caratteristica osservabile (TextualFeature) che ne rivela la struttura vincolata.</rdfs:comment>
    <rdfs:comment xml:lang="en">Inverse relationship of isFeatureOf. Relates a textual expression (F2) to the observable textual feature that reveals its constrained structure.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://example.org/desmos/ontology/core/isFeatureOf"/>
    <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
    <rdfs:range rdf:resource="https://example.org/desmos/ontology/core/TextualFeature"/>
</owl:ObjectProperty>
    


    <!-- https://example.org/desmos/ontology/core/isRevealedBy -->

    <owl:ObjectProperty rdf:about="https://example.org/desmos/ontology/core/isRevealedBy">
        <rdfs:domain rdf:resource="https://example.org/desmos/ontology/core/LiteraryConstraint"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/desmos/ontology/core/ConstraintDeclaration"/>
                    <rdf:Description rdf:about="https://example.org/desmos/ontology/core/TextualFeature"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <owl:inverseOf rdf:resource="https://example.org/desmos/ontology/core/revealsConstraint"/>
        <rdfs:label xml:lang="it">è rivelata da</rdfs:label>
        <rdfs:label xml:lang="en">is revealed by</rdfs:label>
        <rdfs:comment xml:lang="it">Relaziona una costrizione letteraria all'evidenza (dichiarazione autoriale o caratteristica testuale) che ne permette l'identificazione.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a literary constraint to the evidence (authorial declaration or textual feature) that makes it identifiable.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://example.org/desmos/ontology/core/revealsConstraint -->

    <owl:ObjectProperty rdf:about="https://example.org/desmos/ontology/core/revealsConstraint">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/desmos/ontology/core/ConstraintDeclaration"/>
                    <rdf:Description rdf:about="https://example.org/desmos/ontology/core/TextualFeature"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://example.org/desmos/ontology/core/LiteraryConstraint"/>
        <rdfs:comment xml:lang="it">Collega un'evidenza (dichiarazione autoriale o caratteristica testuale) alla costrizione letteraria che essa rende identificabile.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates evidence (intratextual or paratextual) to the LiteraryConstraint it makes identifiable.</rdfs:comment>
        <rdfs:label xml:lang="it">rivela costrizione</rdfs:label>
        <rdfs:label xml:lang="en">reveals constraint</rdfs:label>
        <owl:inverseOf rdf:resource="https://example.org/desmos/ontology/core/isRevealedBy"/>
    </owl:ObjectProperty>
    


    <!-- https://example.org/desmos/ontology/core/usedConstraint -->

    <owl:ObjectProperty rdf:about="https://example.org/desmos/ontology/core/usedConstraint">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P33_used_specific_technique"/>
        <owl:inverseOf rdf:resource="https://example.org/desmos/ontology/core/isConstraintUsedIn"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
        <rdfs:range rdf:resource="https://example.org/desmos/ontology/core/LiteraryConstraint"/>
        <rdfs:comment xml:lang="en">
            Relates a literary creation event to a literary constraint used as a generative device in the production of an expression.
            Declared as a subproperty of CIDOC CRM P33 (used specific technique) for interoperability.
        </rdfs:comment>
        <rdfs:comment xml:lang="it">
            Relaziona un evento di creazione letteraria alla costrizione impiegata come dispositivo generativo nella produzione di un'espressione.
            È dichiarata come sottoproprietà di CIDOC CRM P33 (used specific technique) per interoperabilità.
        </rdfs:comment>
        <rdfs:label xml:lang="it">usa costrizione</rdfs:label>
        <rdfs:label xml:lang="en">used constraint</rdfs:label>
    </owl:ObjectProperty>
    



