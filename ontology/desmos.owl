    <!-- http://purl.org/dc/terms/created -->

    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/created">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:label xml:lang="it">creato</rdfs:label>
        <rdfs:label xml:lang="en">creato</rdfs:label>
        <rdfs:comment xml:lang="it">Indica la data o l'intervallo temporale in cui la risorsa è stata generata.</rdfs:comment>
        <rdfs:comment xml:lang="en">Represents the date or time interval when the resource was generated.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://purl.org/dc/terms/title" -->

    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/title">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F1_Work"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">titolo</rdfs:label>
        <rdfs:label xml:lang="en">title</rdfs:label>
        <rdfs:comment xml:lang="it">Il nome testuale assegnato alla risorsa (Opera o Espressione).</rdfs:comment>
        <rdfs:comment xml:lang="en">The textual name assigned to the resource (Work or Expression).</rdfs:comment>
    </owl:DatatypeProperty>

