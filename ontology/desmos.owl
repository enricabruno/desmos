        <rdfs:label xml:lang="en">creator</rdfs:label>
        <rdfs:comment xml:lang="it">L'entità (persona o organizzazione) responsabile della creazione della risorsa o del file ontologico.</rdfs:comment>
        <rdfs:comment xml:lang="en">The entity (person or organization) responsible for making the resource or the ontology file.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description">
        <rdfs:label xml:lang="it">descrizione</rdfs:label>
        <rdfs:label xml:lang="en">description</rdfs:label>
        <rdfs:comment xml:lang="it">Una spiegazione testuale del contenuto della risorsa.</rdfs:comment>
        <rdfs:comment xml:lang="en">An account of the resource.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- http://purl.org/dc/terms/hasVersion -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/hasVersion">
        <rdfs:label xml:lang="it">ha versione</rdfs:label>
        <rdfs:label xml:lang="en">has version</rdfs:label>
        <rdfs:comment xml:lang="it">Indica il numero o l'identificativo della versione della risorsa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates the version identifier of the resource.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license">
        <rdfs:label xml:lang="it">licenza</rdfs:label>
        <rdfs:label xml:lang="en">license</rdfs:label>
        <rdfs:comment xml:lang="it">Il documento legale che stabilisce i permessi di utilizzo della risorsa.</rdfs:comment>
        <rdfs:comment xml:lang="en">A legal document giving official permission to do something with the resource.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- http://purl.org/dc/terms/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source">
        <rdfs:label xml:lang="it">fonte</rdfs:label>
        <rdfs:label xml:lang="en">source</rdfs:label>
        <rdfs:comment xml:lang="it">Una risorsa correlata da cui deriva la risorsa corrente.</rdfs:comment>
        <rdfs:comment xml:lang="en">A related resource from which the described resource is derived.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix">
        <rdfs:label xml:lang="it">prefisso del namespace preferito</rdfs:label>
        <rdfs:label xml:lang="en">preferred namespace prefix</rdfs:label>
        <rdfs:comment xml:lang="it">Il prefisso abbreviato (es. desmos) associato all'URI del namespace dell'ontologia.</rdfs:comment>
        <rdfs:comment xml:lang="en">The preferred prefix for the ontology namespace URI.</rdfs:comment>
    </owl:AnnotationProperty>


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri">
        <rdfs:label xml:lang="it">URI del namespace preferito</rdfs:label>
        <rdfs:label xml:lang="en">preferred namespace URI</rdfs:label>
        <rdfs:comment xml:lang="it">L'URI completo del namespace associato all'ontologia.</rdfs:comment>
        <rdfs:comment xml:lang="en">The preferred URI for the ontology namespace.</rdfs:comment>
    </owl:AnnotationProperty>
    

    <!-- http://www.w3.org/1999/02/22-rdf-syntax-ns#value -->
    <owl:AnnotationProperty rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#value">
        <rdfs:label xml:lang="it">valore</rdfs:label>
        <rdfs:label xml:lang="en">value</rdfs:label>
        <rdfs:comment xml:lang="it">Specifica il valore letterale o testuale della risorsa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the literal or textual value of the resource.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- http://www.w3.org/2000/01/rdf-schema#comment -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#comment">
        <rdfs:label xml:lang="it">commento</rdfs:label>
        <rdfs:label xml:lang="en">comment</rdfs:label>
        <rdfs:comment xml:lang="it">Una descrizione testuale dell'entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">A textual description of the entity.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- http://www.w3.org/2000/01/rdf-schema#label -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#label">
        <rdfs:label xml:lang="it">etichetta</rdfs:label>
        <rdfs:label xml:lang="en">label</rdfs:label>
        <rdfs:comment xml:lang="it">Un nome leggibile per l'entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">A human-readable name for the entity.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- http://www.w3.org/2000/01/rdf-schema#seeAlso -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#seeAlso">
        <rdfs:label xml:lang="it">vedi anche</rdfs:label>
        <rdfs:label xml:lang="en">see also</rdfs:label>
