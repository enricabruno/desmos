@prefix : <https://example.org/desmos/ontology/core/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://example.org/desmos/ontology/core/> .

<https://example.org/desmos/ontology/core/> rdf:type owl:Ontology ;
                                             owl:versionIRI :v1.0.0 ;
                                             dcterms:creator "Anonimo (in revisione)"@it ,
                                                             "Anonymous (under review)"@en ;
                                             dcterms:description """
            DeSMòS (Descriptive Semantic Model for Structured Texts) is an OWL ontology designed to represent literary constraints as generative devices within the creative process. By modeling constraints as productive principles that steer writing and yield specific textual forms, the ontology provides a structured conceptual layer to describe: (i) constraints as procedures; (ii) their origin (tradition vs. authorial invention) via SKOS-encoded controlled vocabularies; and (iii) the evidence ensuring their identifiability (textual features and authorial declarations). DeSMòS supports the documentation and semantic querying of constrained writing practices and is aligned by reference with CIDOC CRM, LRMoo, PROV-O, SKOS, and Dublin Core.
        """@en ,
                                                                 """
            DeSMòS (Descriptive Semantic Model for Structured Texts) è un’ontologia OWL finalizzata alla rappresentazione delle costrizioni letterarie intese come dispositivi generativi della creazione artistica. Il modello interpreta i vincoli come principi produttivi che orientano il processo di scrittura e determinano la genesi di forme testuali specifiche, fornendo un framework concettuale per descrivere: (i) le costrizioni come procedure; (ii) la loro origine (tradizione vs. invenzione autoriale) mediata da vocabolari controllati SKOS; e (iii) le evidenze che ne permettono l'identificazione (caratteristiche testuali e dichiarazioni autoriali). L'ontologia supporta la documentazione e l'interrogazione semantica delle pratiche di scrittura vincolata ed è allineata per riferimento agli standard CIDOC CRM, LRMoo, PROV-O, SKOS e Dublin Core.
        """@it ;
                                             dcterms:hasVersion "1.0.0" ;
                                             dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                             dcterms:source crm: ,
                                                            <http://www.w3.org/2004/02/skos/core> ,
                                                            <https://cidoc-crm.org/extensions/lrmoo/> ,
                                                            <https://www.w3.org/ns/prov-o> ;
                                             vann:preferredNamespacePrefix "desmos" ;
                                             vann:preferredNamespaceUri "https://example.org/desmos/ontology/core/" ;
                                             owl:versionInfo "1.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty ;
                rdfs:comment "L'entità (persona o organizzazione) responsabile della creazione della risorsa o del file ontologico."@it ,
                             "The entity (person or organization) responsible for making the resource or the ontology file."@en ;
                rdfs:label "creator"@en ,
                           "creatore"@it .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:comment "An account of the resource."@en ,
                                 "Una spiegazione testuale del contenuto della risorsa."@it ;
                    rdfs:label "description"@en ,
                               "descrizione"@it .


###  http://purl.org/dc/terms/hasVersion
dcterms:hasVersion rdf:type owl:AnnotationProperty ;
                   rdfs:comment "Indica il numero o l'identificativo della versione della risorsa."@it ,
                                "Indicates the version identifier of the resource."@en ;
                   rdfs:label "ha versione"@it ,
                              "has version"@en .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty ;
                rdfs:comment "A legal document giving official permission to do something with the resource."@en ,
                             "Il documento legale che stabilisce i permessi di utilizzo della risorsa."@it ;
                rdfs:label "license"@en ,
                           "licenza"@it .


###  http://purl.org/dc/terms/source
dcterms:source rdf:type owl:AnnotationProperty ;
               rdfs:comment "A related resource from which the described resource is derived."@en ,
                            "Una risorsa correlata da cui deriva la risorsa corrente."@it ;
               rdfs:label "fonte"@it ,
                          "source"@en .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty ;
                              rdfs:comment "Il prefisso abbreviato (es. desmos) associato all'URI del namespace dell'ontologia."@it ,
                                           "The preferred prefix for the ontology namespace URI."@en ;
                              rdfs:label "preferred namespace prefix"@en ,
                                         "prefisso del namespace preferito"@it .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty ;
                           rdfs:comment "L'URI completo del namespace associato all'ontologia."@it ,
                                        "The preferred URI for the ontology namespace."@en ;
                           rdfs:label "URI del namespace preferito"@it ,
                                      "preferred namespace URI"@en .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#value
rdf:value rdf:type owl:AnnotationProperty ;
          rdfs:comment "Specifica il valore letterale o testuale della risorsa."@it ,
                       "Specifies the literal or textual value of the resource."@en ;
          rdfs:label "valore"@it ,
                     "value"@en .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty ;
             rdfs:comment "A textual description of the entity."@en ,
                          "Una descrizione testuale dell'entità."@it ;
             rdfs:label "comment"@en ,
                        "commento"@it .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty ;
           rdfs:comment "A human-readable name for the entity."@en ,
                        "Un nome leggibile per l'entità."@it ;
           rdfs:label "etichetta"@it ,
                      "label"@en .


###  http://www.w3.org/2000/01/rdf-schema#seeAlso
rdfs:seeAlso rdf:type owl:AnnotationProperty ;
             rdfs:comment "Indica una risorsa esterna che fornisce informazioni supplementari."@it ,
                          "Indicates an external resource that provides additional information."@en ;
             rdfs:label "see also"@en ,
                        "vedi anche"@it .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty ;
                rdfs:comment "Dettagli testuali sullo stato della versione corrente."@it ,
                             "Textual details about the current version status."@en ;
                rdfs:label "informazioni sulla versione"@it ,
                           "version info"@en .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty ;
                rdfs:comment "A statement of the meaning of the concept."@en ,
                             "Una spiegazione del significato del concetto."@it ;
                rdfs:label "definition"@en ,
                           "definizione"@it .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty ;
                rdfs:comment "Indica un collegamento di equivalenza semantica tra concetti di vocabolari diversi."@it ,
                             "Used to link two concepts that indicate a high degree of confidence that the concepts can be used interchangeably."@en ;
                rdfs:label "corrispondenza esatta"@it ,
                           "exact match"@en .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty ;
               rdfs:comment "Il termine preferito per rappresentare il concetto."@it ,
                            "The preferred term for representing the concept."@en ;
               rdfs:label "etichetta preferita"@it ,
                          "preferred label"@en .


###  http://www.w3.org/2004/02/skos/core#topConceptOf
skos:topConceptOf rdf:type owl:AnnotationProperty ;
                  rdfs:comment "Relates a concept to the concept scheme for which it is a top-level entry point."@en ,
                               "Relazione tra un concetto e lo schema di cui è radice."@it ;
                  rdfs:label "concetto principale di"@it ,
                             "top concept of"@en .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://iflastandards.info/ns/lrm/lrmoo/R15_has_fragment
lrmoo:R15_has_fragment rdf:type owl:ObjectProperty ;
                       rdfs:domain lrmoo:F2_Expression ;
                       rdfs:range crm:E33_Linguistic_Object .


###  http://iflastandards.info/ns/lrm/lrmoo/R17_created
lrmoo:R17_created rdf:type owl:ObjectProperty ;
                  rdfs:domain lrmoo:F28_Expression_Creation ;
                  rdfs:range lrmoo:F2_Expression .


###  http://iflastandards.info/ns/lrm/lrmoo/R3_is_realised_in
lrmoo:R3_is_realised_in rdf:type owl:ObjectProperty ;
                        rdfs:domain lrmoo:F1_Work ;
                        rdfs:range lrmoo:F2_Expression .


###  http://iflastandards.info/ns/lrm/lrmoo/R76_is_derivative_of
lrmoo:R76_is_derivative_of rdf:type owl:ObjectProperty ;
                           rdfs:domain lrmoo:F2_Expression ;
                           rdfs:range lrmoo:F2_Expression .


###  http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by
crm:P14_carried_out_by rdf:type owl:ObjectProperty ;
                       rdfs:domain lrmoo:F28_Expression_Creation ;
                       rdfs:range crm:E39_Actor .


###  http://www.cidoc-crm.org/cidoc-crm/P33_used_specific_technique
crm:P33_used_specific_technique rdf:type owl:ObjectProperty ;
                                rdfs:domain lrmoo:F28_Expression_Creation ;
                                rdfs:range crm:E29_Design_or_Procedure .


###  http://www.w3.org/2004/02/skos/core#inScheme
skos:inScheme rdf:type owl:ObjectProperty ;
              rdfs:domain skos:Concept ;
              rdfs:range skos:ConceptScheme ;
              rdfs:comment "Relates a concept to the concept scheme it belongs to."@en ;
              rdfs:label "in scheme"@en ,
                         "nello schema"@it .


###  http://www.w3.org/ns/prov#wasAttributedTo
prov:wasAttributedTo rdf:type owl:ObjectProperty ;
                     rdfs:domain prov:Entity ;
                     rdfs:range prov:Agent .


###  https://example.org/desmos/ontology/core/constraintOrigin
:constraintOrigin rdf:type owl:ObjectProperty ;
                  owl:inverseOf :isOriginOf ;
                  rdfs:domain :LiteraryConstraint ;
                  rdfs:range skos:Concept ;
                  rdfs:comment "Collega una costrizione letteraria ad un concetto SKOS che ne qualifica l'origine concettuale (tradizione o invenzione autoriale)."@it ,
                               "Relates a constraint to a SKOS concept qualifying its conceptual origin (tradition or authorial invention)."@en ;
                  rdfs:label "constraint origin"@en ,
                             "origine della costrizione"@it .


###  https://example.org/desmos/ontology/core/constraintScope
:constraintScope rdf:type owl:ObjectProperty ;
                 owl:inverseOf :isScopeOf ;
                 rdfs:domain :LiteraryConstraint ;
                 rdfs:range skos:Concept ;
                 rdfs:comment "Indica l’ambito testuale principalmente vincolato da una costrizione letteraria (formale vs semantico). I valori sono tratti da un vocabolario controllato SKOS."@it ,
                              "Indicates the main textual scope affected by a literary constraint (formal vs semantic). Values are taken from a SKOS controlled vocabulary."@en ;
                 rdfs:label "ambito della costrizione"@it ,
                            "constraint scope"@en .


###  https://example.org/desmos/ontology/core/containsDeclaration
:containsDeclaration rdf:type owl:ObjectProperty ;
                     owl:inverseOf :isDeclaredIn ;
                     rdfs:domain crm:E33_Linguistic_Object ;
                     rdfs:range :ConstraintDeclaration ;
                     rdfs:comment "Inverse relationship of isDeclaredIn. Relates a linguistic fragment (E33) to the authorial declaration of constraint expressed within it."@en ,
                                  "Relazione inversa di isDeclaredIn. Collega un frammento linguistico (E33) alla dichiarazione autoriale di costrizione in esso espressa."@it ;
                     rdfs:label "contains declaration"@en ,
                                "contiene dichiarazione"@it .


###  https://example.org/desmos/ontology/core/hasFeature
:hasFeature rdf:type owl:ObjectProperty ;
            owl:inverseOf :isFeatureOf ;
            rdfs:domain lrmoo:F2_Expression ;
            rdfs:range :TextualFeature ;
            rdfs:comment "Inverse relationship of isFeatureOf. Relates a textual expression (F2) to the observable textual feature that reveals its constrained structure."@en ,
                         "Relazione inversa di isFeatureOf. Collega un'espressione testuale (F2) alla caratteristica osservabile (TextualFeature) che ne rivela la struttura vincolata."@it ;
            rdfs:label "ha caratteristica"@it ,
                       "has feature"@en .


###  https://example.org/desmos/ontology/core/isConstraintUsedIn
:isConstraintUsedIn rdf:type owl:ObjectProperty ;
                    owl:inverseOf :usedConstraint ;
                    rdfs:domain :LiteraryConstraint ;
                    rdfs:range lrmoo:F28_Expression_Creation ;
                    rdfs:comment "Relates a literary constraint to the expression creation event in which it was employed as a generative device."@en ,
                                 "Relaziona una costrizione letteraria all'evento di creazione dell'espressione in cui essa è stata impiegata come dispositivo generativo."@it ;
                    rdfs:label "is constraint used in"@en ,
                               "è costrizione usata in"@it .


###  https://example.org/desmos/ontology/core/isDeclaredIn
:isDeclaredIn rdf:type owl:ObjectProperty ;
              rdfs:domain :ConstraintDeclaration ;
              rdfs:range crm:E33_Linguistic_Object ;
              rdfs:comment "Relates an authorial declaration to the fragment (E33 Linguistic Object) in which the declaration is expressed. The fragment may be linked to the expression via LRMoo R15_has_fragment."@en ,
                           "Relaziona una dichiarazione autoriale al frammento (E33 Linguistic Object) in cui la dichiarazione è espressa. Il frammento può essere collegato all’espressione tramite LRMoo R15_has_fragment."@it ;
              rdfs:label "is declared in"@en ,
                         "è dichiarata in"@it .


###  https://example.org/desmos/ontology/core/isFeatureOf
:isFeatureOf rdf:type owl:ObjectProperty ;
             rdfs:domain :TextualFeature ;
             rdfs:range lrmoo:F2_Expression ;
             rdfs:comment "Collega una caratteristica testuale al testo (F2_Expression) in cui la caratteristica è osservabile."@it ,
                          "Relates a textual feature to the text (F2_Expression) in which the feature is observable."@en ;
             rdfs:label "caratteristica di"@it ,
                        "is feature of"@en .


###  https://example.org/desmos/ontology/core/isOriginOf
:isOriginOf rdf:type owl:ObjectProperty ;
            rdfs:domain skos:Concept ;
            rdfs:range :LiteraryConstraint ;
            rdfs:comment "Inverse relationship of constraintOrigin. Relates a SKOS concept (tradition or authorial invention) to the literary constraint whose genesis it defines."@en ,
                         "Relazione inversa di constraintOrigin. Collega un concetto SKOS (tradizione o invenzione autoriale) alla costrizione letteraria di cui definisce la genesi."@it ;
            rdfs:label "is origin of"@en ,
                       "è origine di"@it .


###  https://example.org/desmos/ontology/core/isRevealedBy
:isRevealedBy rdf:type owl:ObjectProperty ;
              owl:inverseOf :revealsConstraint ;
              rdfs:domain :LiteraryConstraint ;
              rdfs:range [ rdf:type owl:Class ;
                           owl:unionOf ( :ConstraintDeclaration
                                         :TextualFeature
                                       )
                         ] ;
              rdfs:comment "Relates a literary constraint to the evidence (authorial declaration or textual feature) that makes it identifiable."@en ,
                           "Relaziona una costrizione letteraria all'evidenza (dichiarazione autoriale o caratteristica testuale) che ne permette l'identificazione."@it ;
              rdfs:label "is revealed by"@en ,
                         "è rivelata da"@it .


###  https://example.org/desmos/ontology/core/isScopeOf
:isScopeOf rdf:type owl:ObjectProperty ;
           rdfs:domain skos:Concept ;
           rdfs:range :LiteraryConstraint ;
           rdfs:comment "Inverse relationship of constraintScope. Relates a SKOS concept (formal or semantic scope) to the literary constraint that adopts it."@en ,
                        "Relazione inversa di constraintScope. Collega un concetto SKOS (ambito formale o semantico) alla costrizione letteraria che lo adotta."@it ;
           rdfs:label "is scope of"@en ,
                      "è ambito di"@it .


###  https://example.org/desmos/ontology/core/revealsConstraint
:revealsConstraint rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :ConstraintDeclaration
                                               :TextualFeature
                                             )
                               ] ;
                   rdfs:range :LiteraryConstraint ;
                   rdfs:comment "Collega un'evidenza (dichiarazione autoriale o caratteristica testuale) alla costrizione letteraria che essa rende identificabile."@it ,
                                "Relates evidence (intratextual or paratextual) to the LiteraryConstraint it makes identifiable."@en ;
                   rdfs:label "reveals constraint"@en ,
                              "rivela costrizione"@it .


###  https://example.org/desmos/ontology/core/usedConstraint
:usedConstraint rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf crm:P33_used_specific_technique ;
                rdfs:domain lrmoo:F28_Expression_Creation ;
                rdfs:range :LiteraryConstraint ;
                rdfs:comment """
            Relates a literary creation event to a literary constraint used as a generative device in the production of an expression.
            Declared as a subproperty of CIDOC CRM P33 (used specific technique) for interoperability.
        """@en ,
                             """
            Relaziona un evento di creazione letteraria alla costrizione impiegata come dispositivo generativo nella produzione di un'espressione.
            È dichiarata come sottoproprietà di CIDOC CRM P33 (used specific technique) per interoperabilità.
        """@it ;
                rdfs:label "usa costrizione"@it ,
                           "used constraint"@en .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:DatatypeProperty ;
                rdfs:domain lrmoo:F28_Expression_Creation ;
                rdfs:range xsd:gYear ;
                rdfs:comment "Indica la data o l'intervallo temporale in cui la risorsa è stata generata."@it ,
                             "Represents the date or time interval when the resource was generated."@en ;
                rdfs:label "creato"@en ,
                           "creato"@it .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:DatatypeProperty ;
              rdfs:domain lrmoo:F1_Work ;
              rdfs:range xsd:string ;
              rdfs:comment "Il nome testuale assegnato alla risorsa (Opera o Espressione)."@it ,
                           "The textual name assigned to the resource (Work or Expression)."@en ;
              rdfs:label "title"@en ,
                         "titolo"@it .


#################################################################
#    Classes
#################################################################

###  http://iflastandards.info/ns/lrm/lrmoo/F1_Work
lrmoo:F1_Work rdf:type owl:Class .


###  http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation
lrmoo:F28_Expression_Creation rdf:type owl:Class .


###  http://iflastandards.info/ns/lrm/lrmoo/F2_Expression
lrmoo:F2_Expression rdf:type owl:Class .


###  http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure
crm:E29_Design_or_Procedure rdf:type owl:Class ;
                            rdfs:comment "Class inherited from CIDOC CRM. In DeSMòS, it is used to frame the procedural nature of literary constraints as generative action plans."@en ,
                                         "Classe ereditata dal CIDOC CRM. In DeSMòS, viene utilizzata per inquadrare la natura procedurale delle costrizioni letterarie come piani d'azione generativi."@it ;
                            rdfs:label "Design or Procedure"@en ,
                                       "Progetto o Procedura"@it .


###  http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object
crm:E33_Linguistic_Object rdf:type owl:Class .


###  http://www.cidoc-crm.org/cidoc-crm/E39_Actor
crm:E39_Actor rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
skos:ConceptScheme rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Agent
prov:Agent rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Entity
prov:Entity rdf:type owl:Class .


###  https://example.org/desmos/ontology/core/ConstraintDeclaration
:ConstraintDeclaration rdf:type owl:Class ;
                       rdfs:subClassOf prov:Entity ;
                       owl:disjointWith :LiteraryConstraint ,
                                        :TextualFeature ;
                       rdfs:comment "Enunciato che rende esplicito l’impiego di una o più costrizioni letterarie. Può essere attribuito ad un critico o all'autore. Quando è attribuito all'autore può essere interno al testo (paratestuale) o esterno (epitestuale)."@it ,
                                    "Statement that explicitly refers to the use of one or more literary devices. It can be attributed to a critic or to the author. When attributed to the author, it can be internal to the text (paratextual) or external (epitextual)."@en ;
                       rdfs:label "Constraint declaration"@en ,
                                  "Dichiarazione della costrizione"@it .


###  https://example.org/desmos/ontology/core/LiteraryConstraint
:LiteraryConstraint rdf:type owl:Class ;
                    rdfs:subClassOf crm:E29_Design_or_Procedure ;
                    owl:disjointWith :TextualFeature ;
                    rdfs:comment "A formal or semantic procedure intervening in the process of textual generation (F28 Expression Creation), whose presence is detectable through objective evidence (TextualFeature) independently of the explicit statement of authorial intent (ConstraintDeclaration)."@en ,
                                 "Procedura formale o semantica che interviene nel processo di generazione testuale (F28 Expression Creation), la cui presenza può essere rilevabile attraverso evidenze oggettive (TextualFeature) indipendentemente dall'esplicitazione di un'intenzionalità autoriale (ConstraintDeclaration)."@it ;
                    rdfs:label "Costrizione letteraria"@it ,
                               "Literary constraint"@en .


###  https://example.org/desmos/ontology/core/TextualFeature
:TextualFeature rdf:type owl:Class ;
                rdfs:comment "Caratteristica osservabile dell’espressione che può rendere leggibile una costrizione. In DeSMòS è intesa come evidenza intratestuale: una traccia testuale che supporta l’identificazione della costrizione, senza implicare di per sé sufficienza o necessità."@it ,
                             "Observable feature of an expression that may make a constraint legible. In DeSMòS it is treated as intratextual evidence: a textual trace supporting the identification of a constraint, without implying necessity or sufficiency by itself."@en ;
                rdfs:label "Caratteristica testuale"@it ,
                           "Textual feature"@en .


#################################################################
#    Individuals
#################################################################

###  https://example.org/desmos/ontology/core/
<https://example.org/desmos/ontology/core/> rdf:type owl:NamedIndividual ;
                                            dcterms:title "DeSMòS (Descriptive Semantic Model for Structured texts) Ontology"@en ,
                                                          "Ontologia DeSMòS (Descriptive Semantic Model for Structured texts)"@it .


###  https://example.org/desmos/ontology/core/ConstraintOriginScheme
:ConstraintOriginScheme rdf:type owl:NamedIndividual ,
                                 skos:ConceptScheme ;
                        skos:definition "Controlled vocabulary used to describe the conceptual origin of a constraint (tradition or authorial invention)."@en ,
                                        "Vocabolario controllato per descrivere l’origine concettuale di una costrizione (tradizionale o invenzione autoriale)."@it ;
                        skos:prefLabel "Constraint origin scheme"@en ,
                                       "Schema dell’origine della costrizione"@it .


###  https://example.org/desmos/ontology/core/ConstraintScopeScheme
:ConstraintScopeScheme rdf:type owl:NamedIndividual ,
                                skos:ConceptScheme ;
                       skos:definition "Controlled vocabulary for the main textual scope affected by a literary constraint."@en ,
                                       "Vocabolario controllato per l’ambito testuale principalmente interessato da una costrizione letteraria."@it ;
                       skos:prefLabel "Constraint scope scheme"@en ,
                                      "Schema dell’ambito della costrizione"@it .


###  https://example.org/desmos/ontology/core/formal
:formal rdf:type owl:NamedIndividual ,
                 skos:Concept ;
        skos:inScheme :ConstraintScopeScheme ;
        skos:definition "Constraint primarily affecting formal properties of the text (e.g., metre, rhyme, letter patterns, layout)."@en ,
                        "Costrizione che incide principalmente su proprietà formali del testo (es. metrica, rima, pattern di lettere, impaginazione)."@it ;
        skos:prefLabel "formal"@en ,
                       "formale"@it ;
        skos:topConceptOf :ConstraintScopeScheme .


###  https://example.org/desmos/ontology/core/original
:original rdf:type owl:NamedIndividual ,
                   skos:Concept ;
          skos:inScheme :ConstraintOriginScheme ;
          skos:definition "Categoria per costrizioni introdotte come invenzione autoriale (non derivate da una forma o prassi già stabilizzata nella tradizione)."@it ,
                          "Category for constraints introduced as an authorial invention (not derived from an already stabilised form or practice in the tradition)."@en ;
          skos:prefLabel "original"@en ,
                         "originale"@it ;
          skos:topConceptOf :ConstraintOriginScheme .


###  https://example.org/desmos/ontology/core/semantic
:semantic rdf:type owl:NamedIndividual ,
                   skos:Concept ;
          skos:inScheme :ConstraintScopeScheme ;
          skos:definition "Constraint primarily affecting the semantic or narrative content of the text (e.g., required themes, fixed characters or setting)."@en ,
                          "Costrizione che incide principalmente sul contenuto semantico o narrativo del testo (es. temi obbligati, personaggi o ambientazione fissa)."@it ;
          skos:prefLabel "semantic"@en ,
                         "semantico"@it ;
          skos:topConceptOf :ConstraintScopeScheme .


