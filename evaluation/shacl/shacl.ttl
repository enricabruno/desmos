@prefix dshape:  <https://w3id.org/desmos/shapes/> .
@prefix desmos:  <https://w3id.org/desmos/> .
@prefix crm:     <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix lrmoo:   <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix intro:   <https://w3id.org/lso/intro/beta202506#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# =============================================================================
# DeSMòS SHACL Shapes
# =============================================================================

dshape: a owl:Ontology ;
    rdfs:label
        "Shape SHACL di DeSMòS"@it , "DeSMòS SHACL Shapes"@en ;

    dcterms:description
        "Grafo di shape SHACL per la validazione della base di conoscenza DeSMòS, costituita da corpus.ttl e concept.ttl. I vincoli verificano l'integrità strutturale e la conformità dei dati ai requisiti del modello. La validazione utilizza desmos.owl come grafo ontologico, senza inferenza."@it , "SHACL shapes graph for validating the DeSMòS knowledge base, consisting of corpus.ttl and concept.ttl. The constraints verify structural integrity and data conformance to the model requirements. Validation uses desmos.owl as the ontology graph, without inference."@en ;

    dcterms:creator "Enrica Bruno" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:source <https://w3id.org/desmos/v1.2.0> ;

    dcterms:modified "2026-10-24"^^xsd:date ;
    owl:versionInfo "1.1" .

# ----------------------------------------------------------------------
# 1. STRUTTURA BIBLIOGRAFICA
# ----------------------------------------------------------------------

dshape:WorkShape a sh:NodeShape ;
    sh:name "Work: struttura bibliografica"@it, "Work: bibliographic structure"@en ;
    sh:description "Titolo e realizzazione dell’opera nel profilo del corpus."@it, "Title and realization of works in the corpus validation profile."@en ;
    sh:targetClass lrmoo:F1_Work ;
    sh:property [
        sh:path dcterms:title ; sh:minCount 1 ; sh:minLength 1 ; sh:nodeKind sh:Literal ;
        sh:message "Ogni opera deve avere almeno un titolo letterale non vuoto."@it ;
        sh:message "Each work must have at least one non-empty literal title."@en
    ] ;
    sh:property [
        sh:path lrmoo:R3_is_realised_in ; sh:minCount 1 ;
        sh:class lrmoo:F2_Expression ;
        sh:message "Ogni opera deve essere realizzata in almeno una risorsa F2 Expression."@it ;
        sh:message "Each work must be realized in at least one F2 Expression."@en
    ] .

dshape:ExpressionShape a sh:NodeShape ;
    sh:name "Expression: descrizione e relazioni"@it, "Expression: description and relationships"@en ;
    sh:description "Metadati, forma espressiva, manifestazione, frammenti e collegamenti fra espressioni."@it, "Metadata, expressive form, manifestation, fragments, and links between expressions."@en ;
    sh:targetClass lrmoo:F2_Expression ;
    sh:property [
        sh:path dcterms:title ; sh:minCount 1 ; sh:minLength 1 ; sh:nodeKind sh:Literal ;
        sh:message "Ogni espressione deve avere almeno un titolo letterale non vuoto."@it ;
        sh:message "Each expression must have at least one non-empty literal title."@en
    ] ;
    sh:property [
        sh:path crm:P2_has_type ; sh:minCount 1 ; sh:class crm:E55_Type ;
        sh:message "Ogni espressione deve avere almeno un tipo di forma espressiva E55 Type."@it ;
        sh:message "Each expression must have at least one expressive-form type classified as E55 Type."@en
    ] ;
    sh:property [
        sh:path lrmoo:R4i_is_embodied_in ; sh:minCount 1 ;
        sh:class lrmoo:F3_Manifestation ;
        sh:message "Ogni espressione deve essere incorporata in almeno una F3 Manifestation."@it ;
        sh:message "Each expression must be embodied in at least one F3 Manifestation."@en
    ] ;
    # Un’espressione può avere frammenti senza essere obbligata ad averli.
    sh:property [
        sh:path lrmoo:R15_has_fragment ; sh:class crm:E33_Linguistic_Object ;
        sh:message "I frammenti collegati a un’espressione mediante R15 devono essere E33 Linguistic Object."@it ;
        sh:message "Fragments linked to an expression through R15 must be E33 Linguistic Objects."@en
    ] ;
    sh:property [
        sh:path lrmoo:R76_is_derivative_of ; sh:class lrmoo:F2_Expression ;
        sh:message "L’espressione sorgente di una relazione di derivazione deve essere una F2 Expression."@it ;
        sh:message "The source of an expression-derivation link must be an F2 Expression."@en
    ] ;
    # Componenti delle plaquette collettive: F2 -> F2.
    sh:property [
        sh:path crm:P148_has_component ; sh:class lrmoo:F2_Expression ;
        sh:message "I componenti di un’espressione devono essere risorse F2 Expression."@it ;
        sh:message "Components of an expression must be F2 Expressions."@en
    ] ;
    # Relazioni documentate fra espressioni che riprendono caratteristiche testuali.
    sh:property [
        sh:path crm:P130_shows_features_of ; sh:class lrmoo:F2_Expression ;
        sh:message "Le risorse collegate mediante P130 da un’espressione devono essere F2 Expression."@it ;
        sh:message "Resources linked from an expression through P130 must be F2 Expressions."@en
    ] .

dshape:ManifestationShape a sh:NodeShape ;
    sh:name "Manifestation: pubblicazione e aggregazione"@it, "Manifestation: publication and aggregation"@en ;
    sh:description "Manifestazioni che incorporano espressioni o aggregano altre manifestazioni."@it, "Manifestations that embody expressions or aggregate other manifestations."@en ;
    sh:targetClass lrmoo:F3_Manifestation ;
    sh:property [
        sh:path dcterms:title ; sh:minCount 1 ; sh:minLength 1 ; sh:nodeKind sh:Literal ;
        sh:message "Ogni manifestazione deve avere almeno un titolo letterale non vuoto."@it ;
        sh:message "Each manifestation must have at least one non-empty literal title."@en
    ] ;
    sh:property [
        sh:path dcterms:issued ; sh:datatype xsd:gYear ;
        sh:message "La data di pubblicazione, se presente, deve avere datatype xsd:gYear."@it ;
        sh:message "The publication date, when provided, must use the xsd:gYear datatype."@en
    ] ;
    sh:property [
        sh:path lrmoo:R4_embodies ; sh:class lrmoo:F2_Expression ;
        sh:message "Le risorse incorporate mediante R4 devono essere F2 Expression."@it ;
        sh:message "Resources embodied through R4 must be F2 Expressions."@en
    ] ;
    sh:property [
        sh:path crm:P148_has_component ; sh:class lrmoo:F3_Manifestation ;
        sh:message "I componenti di una manifestazione devono essere F3 Manifestation."@it ;
        sh:message "Components of a manifestation must be F3 Manifestations."@en
    ] ;
    # Nelle singole plaquette dei tre volumi compare anche la relazione inversa.
    sh:property [
        sh:path crm:P148i_is_component_of ; sh:class lrmoo:F3_Manifestation ;
        sh:message "La manifestazione aggregante indicata mediante P148i deve essere una F3 Manifestation."@it ;
        sh:message "The aggregating manifestation linked through P148i must be an F3 Manifestation."@en
    ] ;

    sh:or (
        [ sh:property [ sh:path lrmoo:R4_embodies ; sh:minCount 1 ;
            sh:message "Per questa alternativa, la manifestazione deve incorporare almeno un’espressione."@it ;
            sh:message "For this alternative, the manifestation must embody at least one expression."@en ] ]
        [ sh:property [ sh:path crm:P148_has_component ; sh:minCount 1 ;
            sh:message "Per questa alternativa, la manifestazione deve avere almeno una manifestazione componente."@it ;
            sh:message "For this alternative, the manifestation must have at least one component manifestation."@en ] ]
    ) .

# ----------------------------------------------------------------------
# 2. EVENTI DI CREAZIONE E AGENTI
# ----------------------------------------------------------------------

dshape:ExpressionCreationShape a sh:NodeShape ;
    sh:name "Expression Creation: atto compositivo"@it, "Expression Creation: compositional event"@en ;
    sh:description "Creazione, responsabilità e impiego facoltativo delle costrizioni."@it, "Creation, responsibility, and optional use of literary constraints."@en ;
    sh:targetClass lrmoo:F28_Expression_Creation ;
    sh:property [
        sh:path lrmoo:R17_created ; sh:minCount 1 ;
        sh:class lrmoo:F2_Expression ;
        sh:message "Ogni evento compositivo deve produrre almeno una F2 Expression."@it ;
        sh:message "Each creation event must produce at least one F2 Expression."@en
    ] ;
    sh:property [
        sh:path crm:P14_carried_out_by ; sh:minCount 1 ;
        sh:class crm:E39_Actor ;
        sh:message "Ogni evento compositivo deve essere associato ad almeno un E39 Actor."@it ;
        sh:message "Each creation event must be associated with at least one E39 Actor."@en
    ] ;
    sh:property [
        sh:path dcterms:created ; sh:minCount 1 ; sh:datatype xsd:gYear ;
        sh:message "Ogni evento compositivo deve avere almeno un anno di creazione con datatype xsd:gYear."@it ;
        sh:message "Each creation event must have at least one creation year with datatype xsd:gYear."@en
    ] ;

    sh:property [
        sh:path desmos:usedConstraint ; sh:class desmos:LiteraryConstraint ;
        sh:message "Le costrizioni impiegate, se dichiarate, devono essere LiteraryConstraint."@it ;
        sh:message "Constraints used in a creation event, when recorded, must be LiteraryConstraint instances."@en
    ] .

dshape:ActorShape a sh:NodeShape ;
    sh:name "Actor: identificazione"@it, "Actor: identification"@en ;
    sh:description "Agenti del corpus e compatibilità con PROV-O."@it, "Corpus agents and compatibility with PROV-O."@en ;
    sh:targetClass crm:E39_Actor ;
    sh:class prov:Agent ;
    sh:property [
        sh:path rdfs:label ; sh:minCount 1 ; sh:nodeKind sh:Literal ;
        sh:message "Ogni attore deve avere almeno un’etichetta espressa come letterale."@it ;
        sh:message "Each actor must have at least one literal label."@en
    ] .

# ----------------------------------------------------------------------
# 3. COSTRIZIONI E CARATTERIZZAZIONE TIPOLOGICA
# ----------------------------------------------------------------------

dshape:LiteraryConstraintShape a sh:NodeShape ;
    sh:name "Literary Constraint: origine e operazioni"@it, "Literary Constraint: origin and operations"@en ;
    sh:description "Origine della costrizione e operazioni procedurali quando definite."@it, "Constraint origin and procedural operations when specified."@en ;
    sh:targetClass desmos:LiteraryConstraint ;
    sh:class skos:Concept ;
    sh:property [
        sh:path desmos:constraintOrigin ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:node [ sh:property [
            sh:path skos:inScheme ;
            sh:hasValue desmos:ConstraintOriginScheme ;
            sh:message "L’origine deve appartenere a ConstraintOriginScheme."@it ;
            sh:message "The constraint origin must belong to ConstraintOriginScheme."@en
        ] ] ;
        sh:message "Ogni costrizione deve avere esattamente un’origine appartenente allo schema ConstraintOriginScheme."@it ;
        sh:message "Each constraint must have exactly one origin belonging to ConstraintOriginScheme."@en
    ] ;
  
    sh:property [
        sh:path desmos:involvesOperation ; sh:class skos:Concept ;
        sh:node [ sh:property [
            sh:path skos:inScheme ;
            sh:hasValue desmos:ProceduralOperationScheme ;
            sh:message "L’operazione deve appartenere a ProceduralOperationScheme."@it ;
            sh:message "The operation must belong to ProceduralOperationScheme."@en
        ] ] ;
        sh:message "Le operazioni eventualmente associate devono essere concetti di ProceduralOperationScheme."@it ;
        sh:message "Any associated operations must be concepts in ProceduralOperationScheme."@en
    ] .

dshape:FormalConstraintShape a sh:NodeShape ;
    sh:name "Formal Constraint: unità formali"@it, "Formal Constraint: formal units"@en ;
    sh:description "Unità del piano dell’espressione e appartenenza agli schemi."@it, "Units on the plane of expression and concept scheme membership."@en ;
    sh:targetClass desmos:FormalConstraint ;
    sh:not [ sh:class desmos:SemanticConstraint ] ;
    sh:property [
        sh:path desmos:constrainsFormalUnit ; sh:minCount 1 ;
        sh:class skos:Concept ;
        sh:node [ sh:property [
            sh:path skos:inScheme ; sh:hasValue desmos:FormalUnitScheme ;
            sh:message "L’unità formale deve appartenere a FormalUnitScheme."@it ;
            sh:message "The formal unit must belong to FormalUnitScheme."@en
        ] ] ;
        sh:message "Ogni costrizione formale deve vincolare almeno un concetto di FormalUnitScheme."@it ;
        sh:message "Each formal constraint must constrain at least one concept in FormalUnitScheme."@en
    ] ;
  
    sh:or (
        [ sh:property [ sh:path skos:inScheme ;
                        sh:hasValue desmos:FormalConstraintScheme ;
            sh:message "Per questa alternativa, la costrizione deve appartenere a FormalConstraintScheme."@it ;
            sh:message "For this alternative, the constraint must belong to FormalConstraintScheme."@en ] ]
        [ sh:property [ sh:path skos:inScheme ;
                        sh:hasValue desmos:VisualConstraintScheme ;
            sh:message "Per questa alternativa, la costrizione deve appartenere a VisualConstraintScheme."@it ;
            sh:message "For this alternative, the constraint must belong to VisualConstraintScheme."@en ] ]
    ) .

dshape:FormalUnitPropertySubjectShape a sh:NodeShape ;
    sh:name "Soggetti della proprietà constrainsFormalUnit"@it,
            "Subjects of the constrainsFormalUnit property"@en ;
    sh:description "Ogni risorsa che usa desmos:constrainsFormalUnit deve appartenere alla classe FormalConstraint o a una sua sottoclasse."@it,
                   "Every resource using desmos:constrainsFormalUnit must be an instance of FormalConstraint or one of its subclasses."@en ;
    sh:targetSubjectsOf desmos:constrainsFormalUnit ;
    sh:class desmos:FormalConstraint ;
    sh:message "Il soggetto di desmos:constrainsFormalUnit deve essere una desmos:FormalConstraint (o una sua sottoclasse)."@it ;
    sh:message "The subject of desmos:constrainsFormalUnit must be a desmos:FormalConstraint (or an instance of a subclass)."@en .

dshape:VisualConstraintShape a sh:NodeShape ;
    sh:name "Visual Constraint: schema"@it, "Visual Constraint: concept scheme"@en ;
    sh:description "Classificazione delle costrizioni visive."@it, "Classification of visual constraints."@en ;
    sh:targetClass desmos:VisualConstraint ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue desmos:VisualConstraintScheme ;
        sh:message "La costrizione visiva deve appartenere a VisualConstraintScheme."@it ;
        sh:message "The visual constraint must belong to VisualConstraintScheme."@en
    ] .

dshape:VisualConstraintSchemeMembershipShape a sh:NodeShape ;
    sh:name "Appartenenza allo schema delle costrizioni visive"@it,
            "Visual constraint scheme membership"@en ;
    sh:description "Solo le istanze di VisualConstraint possono essere membri di VisualConstraintScheme."@it,
                   "Only VisualConstraint instances may belong to VisualConstraintScheme."@en ;
    sh:targetNode desmos:VisualConstraintScheme ;
    sh:property [
        sh:path [ sh:inversePath skos:inScheme ] ;
        sh:class desmos:VisualConstraint ;
        sh:message "Un concetto in VisualConstraintScheme deve essere tipizzato come desmos:VisualConstraint (o una sua sottoclasse)."@it ;
        sh:message "A concept in VisualConstraintScheme must be typed as desmos:VisualConstraint (or one of its subclasses)."@en
    ] .

dshape:SemanticConstraintShape a sh:NodeShape ;
    sh:name "Semantic Constraint: unità semantiche"@it, "Semantic Constraint: semantic units"@en ;
    sh:description "Unità del piano del contenuto e appartenenza allo schema."@it, "Units on the plane of content and concept scheme membership."@en ;
    sh:targetClass desmos:SemanticConstraint ;
    sh:not [ sh:class desmos:FormalConstraint ] ;
    sh:property [
        sh:path desmos:constrainsSemanticUnit ; sh:minCount 1 ;
        sh:class skos:Concept ;
        sh:node [ sh:property [
            sh:path skos:inScheme ; sh:hasValue desmos:SemanticUnitScheme ;
            sh:message "L’unità semantica deve appartenere a SemanticUnitScheme."@it ;
            sh:message "The semantic unit must belong to SemanticUnitScheme."@en
        ] ] ;
        sh:message "Ogni costrizione semantica deve vincolare almeno un concetto di SemanticUnitScheme."@it ;
        sh:message "Each semantic constraint must constrain at least one concept in SemanticUnitScheme."@en
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue desmos:SemanticConstraintScheme ;
        sh:message "La costrizione semantica deve appartenere a SemanticConstraintScheme."@it ;
        sh:message "The semantic constraint must belong to SemanticConstraintScheme."@en
    ] .

dshape:FormalUnitRelationsShape a sh:NodeShape ;
    sh:name "Relazioni fra unità formali"@it, "Relations between formal units"@en ;
    sh:description "Livelli di granularità testuale mediante finerThan e coarserThan."@it, "Levels of textual granularity represented through finerThan and coarserThan."@en ;
    sh:targetSubjectsOf desmos:finerThan, desmos:coarserThan ;
    sh:property [
        sh:path skos:inScheme ; sh:hasValue desmos:FormalUnitScheme ;
        sh:message "L’unità formale soggetto di finerThan o coarserThan deve appartenere a FormalUnitScheme."@it ;
        sh:message "A formal unit used as subject of finerThan or coarserThan must belong to FormalUnitScheme."@en
    ] ;
    sh:property [
        sh:path desmos:finerThan ;
        sh:class skos:Concept ;
        sh:node [ sh:property [
            sh:path skos:inScheme ; sh:hasValue desmos:FormalUnitScheme ;
            sh:message "L’unità collegata mediante finerThan deve appartenere a FormalUnitScheme."@it ;
            sh:message "The unit linked through finerThan must belong to FormalUnitScheme."@en
        ] ] ;
        sh:message "I valori di finerThan devono essere concetti appartenenti a FormalUnitScheme."@it ;
        sh:message "Values of finerThan must be concepts belonging to FormalUnitScheme."@en
    ] ;
    sh:property [
        sh:path desmos:coarserThan ;
        sh:class skos:Concept ;
        sh:node [ sh:property [
            sh:path skos:inScheme ; sh:hasValue desmos:FormalUnitScheme ;
            sh:message "L’unità collegata mediante coarserThan deve appartenere a FormalUnitScheme."@it ;
            sh:message "The unit linked through coarserThan must belong to FormalUnitScheme."@en
        ] ] ;
        sh:message "I valori di coarserThan devono essere concetti appartenenti a FormalUnitScheme."@it ;
        sh:message "Values of coarserThan must be concepts belonging to FormalUnitScheme."@en
    ] .

# ----------------------------------------------------------------------
# 4. DICHIARAZIONI DOCUMENTARIE ED EVIDENZE TESTUALI
# ----------------------------------------------------------------------

dshape:LinguisticDeclarationShape a sh:NodeShape ;
    sh:name "Linguistic Object: dichiarazioni"@it, "Linguistic Object: declarations"@en ;
    sh:description "Dichiarazioni, costrizioni cui si riferiscono e responsabilità della loro formulazione."@it, "Declarations, the constraints they concern, and responsibility for their formulation."@en ;
    sh:targetClass crm:E33_Linguistic_Object ;
    sh:property [
        sh:path crm:P3_has_note ; sh:minCount 1 ; sh:minLength 1 ; sh:nodeKind sh:Literal ;
        sh:message "Ogni dichiarazione deve avere almeno una nota testuale non vuota."@it ;
        sh:message "Each declaration must have at least one non-empty textual note."@en
    ] ;
    sh:property [
        sh:path crm:P129_is_about ; sh:minCount 1 ;
        sh:class desmos:LiteraryConstraint ;
        sh:message "Ogni dichiarazione deve riguardare almeno una LiteraryConstraint."@it ;
        sh:message "Each declaration must concern at least one LiteraryConstraint."@en
    ] ;
    sh:property [
        sh:path crm:P67_refers_to ; sh:minCount 1 ;
        sh:class lrmoo:F2_Expression ;
        sh:message "Ogni dichiarazione deve riferirsi ad almeno una F2 Expression."@it ;
        sh:message "Each declaration must refer to at least one F2 Expression."@en
    ] ;
    sh:property [
        sh:path prov:wasAttributedTo ; sh:minCount 1 ;
        sh:class prov:Agent ;
        sh:message "Ogni dichiarazione deve essere attribuita ad almeno un prov:Agent."@it ;
        sh:message "Each declaration must be attributed to at least one prov:Agent."@en
    ] .

dshape:TextualFeatureShape a sh:NodeShape ;
    sh:name "Textual Feature: evidenza"@it, "Textual Feature: textual evidence"@en ;
    sh:description "Evidenze dell’impiego delle costrizioni nelle espressioni."@it, "Evidence of constraint use in expressions."@en ;
    sh:targetClass desmos:TextualFeature ;
    sh:property [
        sh:path crm:P3_has_note ; sh:minCount 1 ; sh:minLength 1 ; sh:nodeKind sh:Literal ;
        sh:message "Ogni evidenza testuale deve avere almeno una nota non vuota."@it ;
        sh:message "Each textual feature must have at least one non-empty note."@en
    ] ;
    sh:property [
        sh:path desmos:isFeatureOf ; sh:minCount 1 ;
        sh:class lrmoo:F2_Expression ;
        sh:message "Ogni evidenza testuale deve appartenere ad almeno una F2 Expression."@it ;
        sh:message "Each textual feature must belong to at least one F2 Expression."@en
    ] ;
    sh:property [
        sh:path desmos:revealsConstraint ; sh:minCount 1 ;
        sh:class desmos:LiteraryConstraint ;
        sh:message "Ogni evidenza testuale deve rivelare almeno una LiteraryConstraint."@it ;
        sh:message "Each textual feature must reveal at least one LiteraryConstraint."@en
    ] .

# ----------------------------------------------------------------------
# 5. RELAZIONI INTERTESTUALI E PASSAGGI
# ----------------------------------------------------------------------

dshape:TextPassageShape a sh:NodeShape ;
    sh:name "Text Passage: localizzazione"@it, "Text Passage: localization"@en ;
    sh:description "Passaggi testuali e appartenenza alle espressioni."@it, "Text passages and their association with expressions."@en ;
    sh:targetClass intro:INT21_TextPassage ;
    sh:property [
        sh:path intro:R44_hasWording ; sh:minCount 1 ; sh:minLength 1 ;
        sh:datatype xsd:string ;
        sh:message "Ogni passaggio testuale deve avere almeno un contenuto non vuoto di datatype xsd:string."@it ;
        sh:message "Each text passage must have at least one non-empty wording with datatype xsd:string."@en
    ] ;
    sh:property [
        sh:path intro:R30i_isTextPassageOf ; sh:minCount 1 ;
        sh:class lrmoo:F2_Expression ;
        sh:message "Ogni passaggio testuale deve appartenere ad almeno una F2 Expression."@it ;
        sh:message "Each text passage must belong to at least one F2 Expression."@en
    ] .

dshape:IntertextualRelationShape a sh:NodeShape ;
    sh:name "Intertextual Relation: sorgente e rinvio"@it, "Intertextual Relation: source and reference"@en ;
    sh:description "Relazioni fra espressioni e/o passaggi testuali."@it, "Relations between expressions and/or text passages."@en ;
    sh:targetClass intro:INT31_IntertextualRelation ;
    sh:property [
        sh:path intro:R19_hasType ; sh:minCount 1 ;
        sh:class intro:INT11_TypeOfInterrelation ;
        sh:message "Ogni relazione intertestuale deve avere almeno un tipo INT11 TypeOfInterrelation."@it ;
        sh:message "Each intertextual relation must have at least one INT11 TypeOfInterrelation."@en
    ] ;
    sh:property [
        sh:path intro:R12_hasReferredToEntity ; sh:minCount 1 ;
        sh:or ( [ sh:class lrmoo:F2_Expression ]
                [ sh:class intro:INT21_TextPassage ] ) ;
        sh:message "Ogni relazione intertestuale deve indicare almeno un’entità riferita, F2 Expression o INT21 TextPassage."@it ;
        sh:message "Each intertextual relation must identify at least one referred-to entity of type F2 Expression or INT21 TextPassage."@en
    ] ;
    sh:property [
        sh:path intro:R13_hasReferringEntity ; sh:minCount 1 ;
        sh:or ( [ sh:class lrmoo:F2_Expression ]
                [ sh:class intro:INT21_TextPassage ] ) ;
        sh:message "Ogni relazione intertestuale deve indicare almeno un’entità referente, F2 Expression o INT21 TextPassage."@it ;
        sh:message "Each intertextual relation must identify at least one referring entity of type F2 Expression or INT21 TextPassage."@en
    ] .

# ----------------------------------------------------------------------
# 6. INTEGRITÀ DEI VOCABOLARI CONTROLLATI
# ----------------------------------------------------------------------

dshape:ConceptShape a sh:NodeShape ;
    sh:name "SKOS Concept: integrità"@it, "SKOS Concept: integrity"@en ;
    sh:description "Etichette, schema e relazioni dei concetti controllati."@it, "Labels, concept schemes, and relations of controlled concepts."@en ;
    sh:targetClass skos:Concept ;
    # SKOS S14: un'unica etichetta preferita per lingua.
    # SKOS S13 (controllo parziale): prefLabel e altLabel disgiunte.
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:minLength 1 ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
        sh:disjoint skos:altLabel ;
        sh:message "Ogni concetto deve avere almeno un’etichetta preferita non vuota e linguistica, unica per lingua e distinta dalle etichette alternative."@it ;
        sh:message "Each concept must have at least one non-empty language-tagged preferred label, unique per language and distinct from alternative labels."@en
    ] ;
    # Le etichette alternative, se presenti, devono essere non vuote e linguistiche.
    sh:property [
        sh:path skos:altLabel ;
        sh:minLength 1 ;
        sh:datatype rdf:langString ;
        sh:message "Le etichette alternative, se presenti, devono essere stringhe linguistiche non vuote."@it ;
        sh:message "Alternative labels, when present, must be non-empty language-tagged strings."@en
    ] ;
    sh:property [
        sh:path skos:inScheme ; sh:minCount 1 ;
        sh:class skos:ConceptScheme ;
        sh:message "Ogni concetto deve appartenere ad almeno uno SKOS ConceptScheme."@it ;
        sh:message "Each concept must belong to at least one SKOS ConceptScheme."@en
    ] ;
    sh:property [
        sh:path skos:broader ; sh:class skos:Concept ;
        sh:message "I concetti più generali collegati tramite skos:broader devono essere skos:Concept."@it ;
        sh:message "Broader concepts linked through skos:broader must be skos:Concept instances."@en
    ] ;
    sh:property [
        sh:path skos:narrower ; sh:class skos:Concept ;
        sh:message "I concetti più specifici collegati tramite skos:narrower devono essere skos:Concept."@it ;
        sh:message "Narrower concepts linked through skos:narrower must be skos:Concept instances."@en
    ] ;
    sh:property [
        sh:path skos:related ; sh:class skos:Concept ;
        sh:message "I concetti correlati collegati tramite skos:related devono essere skos:Concept."@it ;
        sh:message "Related concepts linked through skos:related must be skos:Concept instances."@en
    ] .

dshape:ConceptSchemeShape a sh:NodeShape ;
    sh:name "SKOS Concept Scheme: integrità"@it, "SKOS Concept Scheme: integrity"@en ;
    sh:description "Etichette e concetti di vertice degli schemi controllati."@it, "Labels and top concepts of controlled concept schemes."@en ;
    sh:targetClass skos:ConceptScheme ;
    # SKOS S14: un'unica etichetta preferita per lingua.
    # SKOS S13 (controllo parziale): prefLabel e altLabel disgiunte.
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:minLength 1 ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
        sh:disjoint skos:altLabel ;
        sh:message "Ogni schema deve avere almeno un’etichetta preferita non vuota e linguistica, unica per lingua e distinta dalle etichette alternative."@it ;
        sh:message "Each concept scheme must have at least one non-empty language-tagged preferred label, unique per language and distinct from alternative labels."@en
    ] ;
    sh:property [
        sh:path skos:hasTopConcept ; sh:minCount 1 ;
        sh:class skos:Concept ;
        sh:message "Ogni schema deve avere almeno un concetto di vertice di tipo skos:Concept."@it ;
        sh:message "Each concept scheme must have at least one top concept of type skos:Concept."@en
    ] .
