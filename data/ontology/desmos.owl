<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/desmos/"
     xml:base="https://w3id.org/desmos/"
     xmlns:crm="http://www.cidoc-crm.org/cidoc-crm/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:intro="https://w3id.org/lso/intro/beta202506#"
     xmlns:lrmoo="http://iflastandards.info/ns/lrm/lrmoo/"
     xmlns:schema="http://schema.org/"
     xmlns:desmos="https://w3id.org/desmos/"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/desmos/">
        <owl:versionIRI rdf:resource="https://w3id.org/desmos/v1.2.0"/>
        <owl:versionInfo xml:lang="en">Version 1.2.0</owl:versionInfo>
        <owl:versionInfo xml:lang="it">Versione 1.2.0</owl:versionInfo>
        <owl:priorVersion rdf:resource="https://zenodo.org/records/19610250/files/desmos.owl"/>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-22</dcterms:modified>
        <vann:preferredNamespacePrefix>desmos</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/desmos/</vann:preferredNamespaceUri>
        <dcterms:bibliographicCitation>Bruno, Enrica. (2026). DeSMòS: Descriptive Semantic Model for Structured Texts (Version 1.2.0) [Ontology].</dcterms:bibliographicCitation>
        <dcterms:creator rdf:resource="https://orcid.org/0009-0007-5620-3834"/>
        <dcterms:title xml:lang="en">DeSMòS (Descriptive Semantic Model for Structured Texts)</dcterms:title>
        <dcterms:title xml:lang="it">DeSMòS (Descriptive Semantic Model for Structured Texts)</dcterms:title>
        <rdfs:label xml:lang="en">DeSMòS</rdfs:label>
        <rdfs:label xml:lang="it">DeSMòS</rdfs:label>
        <dcterms:description xml:lang="en">DeSMòS (Descriptive Semantic Model for Structured Texts) is an OWL 2 ontology for the formal representation of literary constraints as text-generative procedures, with particular reference to the Oulipian tradition. The model treats constraints as conceptual entities distinct from works and their bibliographic realizations, represented through LRMoo, and describes their use in expression creation events, distinguishing the procedure from both the creative process and the resulting text. Constrained rewriting is represented through derivation and intertextual relations between expressions, allowing the identification of the textual passages involved. The typological characterization distinguishes formal and semantic constraints, with a specific category for visual constraints, and describes the constrained units, procedural operations, and origins through SKOS controlled vocabularies. The model also supports the documentation of constraint use through intratextual evidence and paratextual statements, whether peritextual or epitextual, distinguishing responsibility for such statements from responsibility for textual creation. Through the reuse of and alignment with CIDOC CRM, LRMoo, PROV-O, SKOS, INTRO, Dublin Core Terms, and Schema.org, DeSMòS supports the description, comparative analysis, and SPARQL querying of constrained writing practices across heterogeneous corpora.</dcterms:description>
        <dcterms:description xml:lang="it">DeSMòS (Descriptive Semantic Model for Structured Texts) è un'ontologia OWL 2 per la rappresentazione formale delle costrizioni letterarie come procedure generative del testo, con particolare riferimento alla tradizione oulipiana. Il modello riconosce alla costrizione un'autonomia concettuale rispetto all'opera e alle sue realizzazioni bibliografiche, rappresentate mediante LRMoo, e ne descrive l'impiego nell'evento di creazione dell'espressione, distinguendo la procedura dal processo compositivo e dal testo prodotto. La riscrittura vincolata è rappresentata attraverso le relazioni di derivazione e i rapporti intertestuali tra espressioni, con la possibilità di identificare i passaggi testuali coinvolti. La caratterizzazione tipologica distingue costrizioni formali e semantiche, con una specificazione delle costrizioni visive, e ne descrive le unità vincolate, le operazioni procedurali e l'origine mediante vocabolari controllati SKOS. Il modello consente inoltre di documentare l'impiego delle costrizioni attraverso evidenze intratestuali e dichiarazioni paratestuali, peritestuali o epitestuali, distinguendo la responsabilità delle dichiarazioni da quella della creazione testuale. Attraverso il riuso e l'allineamento con CIDOC CRM, LRMoo, PROV-O, SKOS, INTRO, Dublin Core Terms e Schema.org, DeSMòS supporta la descrizione, l'analisi comparativa e l'interrogazione SPARQL delle pratiche di scrittura vincolata in corpora eterogenei.</dcterms:description>
        <rdfs:comment xml:lang="en">DeSMòS adopts an "alignment-by-reference" pattern to keep the ontology lightweight and reasoner-friendly.</rdfs:comment>
         <rdfs:comment xml:lang="it">DeSMòS adotta un pattern di "allineamento per riferimento" per mantenere l'ontologia leggera e compatibile con i reasoner.</rdfs:comment>
        <dcterms:hasVersion>1.2.0</dcterms:hasVersion>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:source rdf:resource="http://purl.org/dc/terms/"/>
        <dcterms:source rdf:resource="http://www.cidoc-crm.org/cidoc-crm/"/>
        <dcterms:source rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
        <dcterms:source rdf:resource="http://www.w3.org/ns/prov#"/>
        <dcterms:source rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/"/>
        <dcterms:source rdf:resource="https://w3id.org/lso/intro/beta202506#"/>
        <dcterms:source rdf:resource="http://schema.org/"/>
    </owl:Ontology>
    


