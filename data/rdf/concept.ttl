desmos:ConstraintOriginScheme a skos:ConceptScheme ;
    skos:prefLabel "Constraint's origin scheme"@en , "Schema dell'origine della costrizione"@it ;
    skos:definition "A scheme defining the origin of the constraint, distinguishing between forms inherited from tradition and Oulipian or Oplepian inventions."@en , "Schema che definisce la provenienza della costrizione, distinguendo tra forme ereditate dalla tradizione e invenzioni oulipiane o oplepiane."@it ;
    skos:hasTopConcept
        desmos:historical ,
        desmos:original .

desmos:FormalConstraintScheme a skos:ConceptScheme ;
    skos:prefLabel "Formal constraint scheme"@en , "Schema delle costrizioni formali"@it ;
    skos:definition "A scheme defining the formal constraints, namely those constraints that intervene primarily on the signifier."@en , "Schema che definisce le costrizioni formali, ovvero quelle costrizioni che intervengono primariamente sul significante."@it ;
