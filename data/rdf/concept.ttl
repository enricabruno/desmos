        desmos:embedded_proverb ,
        desmos:enclosed_rhyme ,
        desmos:enigmatic_transformation_chain ,
        desmos:enumerating_text ,
        desmos:figure_derived_count ,
        desmos:fixed_text_length ,
        desmos:fixed_title_length ,
        desmos:fragmentation ,
        desmos:handwritten_realization ,
        desmos:hendecasyllable ,
        desmos:heterogram ,
        desmos:heterolexical_writing ,
        desmos:homographic_translation ,
        desmos:homonymy ,
        desmos:homophony ,
        desmos:homosyntaxism ,
        desmos:hypogram ,
        desmos:iambic_hendecasyllable ,
        desmos:inverted_rhyme ,
        desmos:isosyllabic_words ,
        desmos:isovocalism ,
        desmos:lexical_gap ,
        desmos:lexicographic_marker_constraint ,
        desmos:mandatory_sentence ,
        desmos:metagram ,
        desmos:metric_liposyllabism ,
        desmos:mnemonic_encoding ,
        desmos:monorhyme ,
        desmos:monovocalism ,
        desmos:morale_elementaire ,
        desmos:mythographic_units ,
        desmos:non_repeating_rhyme ,
        desmos:octave ,
