@prefix : <https://w3id.org/desmos/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix intro: <https://w3id.org/lso/intro/beta202506#> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lrmoo:R15_has_fragment a owl:ObjectProperty ;
    rdfs:label "R15 has fragment"@en,
        "R15 ha frammento"@it ;
    rdfs:comment "In DeSMòS, it relates an expression to the peritextual declaration contained in the same publication, which is a fragment of it and documents the use of a constraint. The original property has domain lrmoo:F2_Expression and range crm:E90_Symbolic_Object. In DeSMòS, the same property has domain lrmoo:F2_Expression and range crm:E33_Linguistic_Object."@en,
        "In DeSMòS collega un'espressione alla dichiarazione peritestuale contenuta nella stessa pubblicazione, che ne è un frammento e documenta l'impiego di una costrizione. La proprietà originale ha come domain lrmoo:F2_Expression e come range crm:E90_Symbolic_Object. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression e come range crm:E33_Linguistic_Object."@it ;
    rdfs:domain lrmoo:F2_Expression ;
    rdfs:isDefinedBy lrmoo: ;
    rdfs:range crm:E90_Symbolic_Object ;
    owl:inverseOf lrmoo:R15i_is_fragment_of .

lrmoo:R17_created a owl:ObjectProperty ;
    rdfs:label "R17 created"@en,
        "R17 ha creato"@it ;
    rdfs:comment "In DeSMòS, it relates an expression creation event to the textual expression it produces. The original property has domain lrmoo:F28_Expression_Creation and range lrmoo:F2_Expression. In DeSMòS, the same property has domain lrmoo:F28_Expression_Creation and range lrmoo:F2_Expression."@en,
        "In DeSMòS collega un evento di creazione dell'espressione all'espressione testuale che produce. La proprietà originale ha come domain lrmoo:F28_Expression_Creation e come range lrmoo:F2_Expression. In DeSMòS la stessa proprietà ha come domain lrmoo:F28_Expression_Creation e come range lrmoo:F2_Expression."@it ;
    rdfs:domain lrmoo:F28_Expression_Creation ;
    rdfs:isDefinedBy lrmoo: ;
    rdfs:range lrmoo:F2_Expression ;
    owl:inverseOf lrmoo:R17i_was_created_by .

lrmoo:R3_is_realised_in a owl:ObjectProperty ;
    rdfs:label "R3 is realised in"@en,
        "R3 è realizzato in"@it ;
    rdfs:comment "In DeSMòS, it relates a work to the textual expression that realises it. The original property has domain lrmoo:F1_Work and range lrmoo:F2_Expression. In DeSMòS, the same property has domain lrmoo:F1_Work and range lrmoo:F2_Expression."@en,
        "In DeSMòS collega un'opera all'espressione testuale che la realizza. La proprietà originale ha come domain lrmoo:F1_Work e come range lrmoo:F2_Expression. In DeSMòS la stessa proprietà ha come domain lrmoo:F1_Work e come range lrmoo:F2_Expression."@it ;
    rdfs:domain lrmoo:F1_Work ;
    rdfs:isDefinedBy lrmoo: ;
    rdfs:range lrmoo:F2_Expression ;
    owl:inverseOf lrmoo:R3i_realises .

lrmoo:R4_embodies a owl:ObjectProperty ;
    rdfs:label "R4 embodies"@en,
        "R4 incarna"@it ;
    rdfs:comment "In DeSMòS, it relates a published or digital manifestation to the expression it embodies. The original property has domain lrmoo:F3_Manifestation and range lrmoo:F2_Expression. In DeSMòS, the same property has domain lrmoo:F3_Manifestation and range lrmoo:F2_Expression."@en,
        "In DeSMòS collega una manifestazione editoriale o digitale all'espressione che incorpora. La proprietà originale ha come domain lrmoo:F3_Manifestation e come range lrmoo:F2_Expression. In DeSMòS la stessa proprietà ha come domain lrmoo:F3_Manifestation e come range lrmoo:F2_Expression."@it ;
    rdfs:domain lrmoo:F3_Manifestation ;
    rdfs:isDefinedBy lrmoo: ;
    rdfs:range lrmoo:F2_Expression ;
    owl:inverseOf lrmoo:R4i_is_embodied_in .

lrmoo:R76_is_derivative_of a owl:ObjectProperty ;
    rdfs:label "R76 is derivative of"@en,
        "R76 è derivato di"@it ;
    rdfs:comment "In DeSMòS, it states that an expression derives from another expression used as a source in its creation. The original property has domain lrmoo:F2_Expression and range lrmoo:F2_Expression. In DeSMòS, the same property has domain lrmoo:F2_Expression and range lrmoo:F2_Expression."@en,
        "In DeSMòS indica che un'espressione deriva da un'altra espressione assunta come fonte nella sua creazione. La proprietà originale ha come domain lrmoo:F2_Expression e come range lrmoo:F2_Expression. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression e come range lrmoo:F2_Expression."@it ;
    rdfs:domain lrmoo:F2_Expression ;
    rdfs:isDefinedBy lrmoo: ;
    rdfs:range lrmoo:F2_Expression ;
    rdfs:subPropertyOf crm:P130_shows_features_of ;
    owl:inverseOf lrmoo:R76i_has_derivative .

dcterms:bibliographicCitation a owl:AnnotationProperty ;
    rdfs:label "bibliographic citation"@en,
        "citazione bibliografica"@it ;
    rdfs:comment "A bibliographic reference for the resource."@en,
        "Il riferimento bibliografico con cui citare la risorsa."@it ;
    rdfs:isDefinedBy dcterms: .

dcterms:created a owl:DatatypeProperty ;
    rdfs:label "created"@en,
        "creato"@it ;
    rdfs:comment "In DeSMòS, dcterms:created is used to record the date associated with an expression creation event."@en,
        "In DeSMòS, dcterms:created è utilizzata per registrare la data associata all'evento di creazione di un'espressione."@it ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range rdfs:Literal .

dcterms:creator a owl:AnnotationProperty ;
    rdfs:label "creator"@en,
        "creatore"@it ;
    rdfs:comment "An entity responsible for making the resource."@en,
        "Un'entità responsabile della creazione della risorsa."@it ;
    rdfs:isDefinedBy dcterms: .

dcterms:description a owl:AnnotationProperty ;
    rdfs:label "description"@en,
        "descrizione"@it ;
    rdfs:comment "A description of the resource."@en,
        "Una descrizione della risorsa."@it ;
    rdfs:isDefinedBy dcterms: .

dcterms:hasVersion a owl:AnnotationProperty ;
    rdfs:label "has version"@en,
        "ha versione"@it ;
    rdfs:comment "A related resource that is a version, edition, or adaptation of the described resource."@en,
        "Una risorsa correlata che è una versione, edizione o adattamento della risorsa descritta."@it ;
    rdfs:isDefinedBy dcterms: .

dcterms:issued a owl:DatatypeProperty ;
    rdfs:label "date issued"@en,
        "data di emissione"@it ;
    rdfs:comment "In DeSMòS, dcterms:issued is used to record the publication or issuance date of a manifestation."@en,
        "In DeSMòS, dcterms:issued è utilizzata per registrare la data di pubblicazione o emissione di una manifestazione."@it ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range rdfs:Literal .

dcterms:license a owl:AnnotationProperty ;
    rdfs:label "license"@en,
        "licenza"@it ;
    rdfs:comment "A legal document giving official permission to do something with the resource."@en,
        "Il documento legale che stabilisce i permessi di utilizzo della risorsa."@it ;
    rdfs:isDefinedBy dcterms: .

dcterms:modified a owl:AnnotationProperty ;
    rdfs:label "modified"@en,
        "modificato"@it ;
    rdfs:comment "The date on which the resource was modified."@en,
        "La data in cui la risorsa è stata modificata."@it ;
    rdfs:isDefinedBy dcterms: .

dcterms:source a owl:AnnotationProperty ;
    rdfs:label "source"@en,
        "fonte"@it ;
    rdfs:comment "A related resource from which the described resource is derived."@en,
        "Una risorsa correlata da cui deriva la risorsa corrente."@it ;
    rdfs:isDefinedBy dcterms: .

dcterms:title a owl:AnnotationProperty ;
    rdfs:label "title"@en,
        "titolo"@it ;
    rdfs:comment "A name given to the resource."@en,
        "Un nome dato alla risorsa."@it ;
    rdfs:isDefinedBy dcterms: .

vann:preferredNamespacePrefix a owl:AnnotationProperty ;
    rdfs:label "preferred namespace prefix"@en,
        "prefisso preferito del namespace"@it ;
    rdfs:comment "The preferred namespace prefix to use when using terms from the vocabulary in an XML document."@en,
        "Il prefisso preferito da usare per i termini del vocabolario."@it ;
    rdfs:isDefinedBy vann: .

vann:preferredNamespaceUri a owl:AnnotationProperty ;
    rdfs:label "preferred namespace URI"@en,
        "URI preferito del namespace"@it ;
    rdfs:comment "The preferred namespace URI to use when using terms from the vocabulary in an XML document."@en,
        "L'URI di namespace preferito da usare per i termini del vocabolario."@it ;
    rdfs:isDefinedBy vann: .

schema1:pagination a owl:DatatypeProperty ;
    rdfs:label "pagination"@en,
        "paginazione"@it ;
    rdfs:comment "In DeSMòS, schema:pagination is used to record the page or page range of a F3_Manifestation."@en,
        "In DeSMòS, schema:pagination è utilizzata per registrare la pagina o l'intervallo di pagine di una F3_Manifestation."@it ;
    rdfs:isDefinedBy schema1: .

crm:E33_Linguistic_Object a owl:Class ;
    rdfs:label "E33 Linguistic Object"@en,
        "E33 Oggetto Linguistico"@it ;
    rdfs:comment "In DeSMòS, E33 Linguistic Object is used to identify paratextual passages (epitextual or peritextual) in which the author or editor of the volume declares the use of a literary constraint. The properties that can be used with this class are crm:P129_is_about, crm:P3_has_note, crm:P67_refers_to and prov:wasAttributedTo."@en,
        "In DeSMòS, E33 Linguistic Object è utilizzata per identificare passaggi paratestuali (epitestuali o peritestuali) nei quali l'autore o il curatore del volume dichiara l'utilizzo di una costrizione letteraria. Le proprietà che possono essere usate con questa classe sono crm:P129_is_about, crm:P3_has_note, crm:P67_refers_to e prov:wasAttributedTo."@it ;
    rdfs:isDefinedBy crm: ;
    rdfs:subClassOf crm:E73_Information_Object .

crm:P129_is_about a owl:ObjectProperty ;
    rdfs:label "P129 is about"@en,
        "P129 verte su"@it ;
    rdfs:comment "In DeSMòS, it states that a declaration (linguistic object) has a literary constraint as its subject. The original property has domain crm:E89_Propositional_Object and range crm:E1_CRM_Entity. In DeSMòS, the same property has domain crm:E33_Linguistic_Object and range desmos:LiteraryConstraint."@en,
        "In DeSMòS indica che una dichiarazione (oggetto linguistico) ha come argomento una costrizione letteraria. La proprietà originale ha come domain crm:E89_Propositional_Object e come range crm:E1_CRM_Entity. In DeSMòS la stessa proprietà ha come domain crm:E33_Linguistic_Object e come range desmos:LiteraryConstraint."@it ;
    rdfs:domain crm:E89_Propositional_Object ;
    rdfs:isDefinedBy crm: ;
    rdfs:range crm:E1_CRM_Entity ;
    owl:inverseOf crm:P129i_is_subject_of .

crm:P148_has_component a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "P148 has component"@en,
        "P148 ha componente"@it ;
    rdfs:comment "In DeSMòS, it decomposes complex expressions and manifestations into their components. The original property has domain crm:E89_Propositional_Object and range crm:E89_Propositional_Object. In DeSMòS, the same property has domain lrmoo:F2_Expression (between expressions) or lrmoo:F3_Manifestation (between manifestations) and range lrmoo:F2_Expression or lrmoo:F3_Manifestation respectively."@en,
        "In DeSMòS articola espressioni e manifestazioni complesse nelle rispettive componenti. La proprietà originale ha come domain crm:E89_Propositional_Object e come range crm:E89_Propositional_Object. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression (tra espressioni) o lrmoo:F3_Manifestation (tra manifestazioni) e come range rispettivamente lrmoo:F2_Expression o lrmoo:F3_Manifestation."@it ;
    rdfs:domain crm:E89_Propositional_Object ;
    rdfs:isDefinedBy crm: ;
    rdfs:range crm:E89_Propositional_Object ;
    owl:inverseOf crm:P148i_is_component_of .

crm:P14_carried_out_by a owl:ObjectProperty ;
    rdfs:label "P14 carried out by"@en,
        "P14 eseguito da"@it ;
    rdfs:comment "In DeSMòS, it relates an expression creation event to its author or authors. The original property has domain crm:E7_Activity and range crm:E39_Actor. In DeSMòS, the same property has domain lrmoo:F28_Expression_Creation and range crm:E39_Actor."@en,
        "In DeSMòS collega un evento di creazione dell'espressione al suo autore o ai suoi autori. La proprietà originale ha come domain crm:E7_Activity e come range crm:E39_Actor. In DeSMòS la stessa proprietà ha come domain lrmoo:F28_Expression_Creation e come range crm:E39_Actor."@it ;
    rdfs:domain crm:E7_Activity ;
    rdfs:isDefinedBy crm: ;
    rdfs:range crm:E39_Actor ;
    owl:inverseOf crm:P14i_performed .

crm:P2_has_type a owl:ObjectProperty ;
    rdfs:label "P2 has type"@en,
        "P2 ha tipo"@it ;
    rdfs:comment "In DeSMòS, it classifies an expression by its literary or artistic form (e.g., prose, poetry, visual poetry). The original property has domain crm:E1_CRM_Entity and range crm:E55_Type. In DeSMòS, the same property has domain lrmoo:F2_Expression and range crm:E55_Type."@en,
        "In DeSMòS classifica un'espressione secondo la sua forma letteraria o artistica (es. prosa, poesia, poesia visiva). La proprietà originale ha come domain crm:E1_CRM_Entity e come range crm:E55_Type. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression e come range crm:E55_Type."@it ;
    rdfs:domain crm:E1_CRM_Entity ;
    rdfs:isDefinedBy crm: ;
    rdfs:range crm:E55_Type ;
    owl:inverseOf crm:P2i_is_type_of .

crm:P3_has_note a owl:DatatypeProperty ;
    rdfs:label "has note"@en,
        "ha nota"@it ;
    rdfs:comment "In DeSMòS, P3 has note is used to associate a linguistic object or textual feature with an additional textual description expressed as a literal."@en,
        "In DeSMòS, P3 has note è utilizzata per associare a un oggetto linguistico o a una caratteristica testuale una descrizione testuale aggiuntiva espressa come letterale."@it ;
    rdfs:domain crm:E1_CRM_Entity ;
    rdfs:isDefinedBy crm: ;
    rdfs:range rdfs:Literal .

crm:P67_refers_to a owl:ObjectProperty ;
    rdfs:label "P67 refers to"@en,
        "P67 si riferisce a"@it ;
    rdfs:comment "In DeSMòS, it relates a declaration (linguistic object) to the textual expression it refers to. The original property has domain crm:E89_Propositional_Object and range crm:E1_CRM_Entity. In DeSMòS, the same property has domain crm:E33_Linguistic_Object and range lrmoo:F2_Expression."@en,
        "In DeSMòS collega una dichiarazione (oggetto linguistico) all'espressione testuale a cui fa riferimento. La proprietà originale ha come domain crm:E89_Propositional_Object e come range crm:E1_CRM_Entity. In DeSMòS la stessa proprietà ha come domain crm:E33_Linguistic_Object e come range lrmoo:F2_Expression."@it ;
    rdfs:domain crm:E89_Propositional_Object ;
    rdfs:isDefinedBy crm: ;
    rdfs:range crm:E1_CRM_Entity ;
    owl:inverseOf crm:P67i_is_referred_to_by .

rdfs:comment a owl:AnnotationProperty ;
    rdfs:label "comment"@en,
        "commento"@it ;
    rdfs:comment "A textual description of the entity."@en,
        "Una descrizione testuale dell'entità."@it ;
    rdfs:isDefinedBy rdfs: .

rdfs:label a owl:AnnotationProperty ;
    rdfs:label "label"@en,
        "etichetta"@it ;
    rdfs:comment "A human-readable name for the entity."@en,
        "Un nome leggibile per l'entità."@it ;
    rdfs:isDefinedBy rdfs: .

rdfs:seeAlso a owl:AnnotationProperty ;
    rdfs:label "see also"@en,
        "vedi anche"@it ;
    rdfs:comment "Used to indicate a resource that might provide additional information about the subject resource."@en,
        "Indica una risorsa esterna che può fornire informazioni supplementari sulla risorsa descritta."@it ;
    rdfs:isDefinedBy rdfs: .

xsd:gYear a rdfs:Datatype .

owl:versionInfo a owl:AnnotationProperty ;
    rdfs:label "version info"@en,
        "informazioni sulla versione"@it ;
    rdfs:comment "A string identifying the version of this ontology."@en,
        "Una stringa che identifica la versione di questa ontologia."@it ;
    rdfs:isDefinedBy owl: .

skos:altLabel a owl:AnnotationProperty ;
    rdfs:label "alternative label"@en,
        "etichetta alternativa"@it ;
    rdfs:comment "An alternative term for a concept."@en,
        "Un termine alternativo per un concetto."@it ;
    rdfs:isDefinedBy skos: .

skos:broader a owl:ObjectProperty ;
    rdfs:label "broader"@en,
        "più ampio"@it ;
    rdfs:comment "In DeSMòS, it relates a concept to a more general concept within the ontology's controlled schemes. The original property has domain skos:Concept (inherited from skos:semanticRelation) and range skos:Concept (inherited from skos:semanticRelation). In DeSMòS, the same property has domain skos:Concept and range skos:Concept."@en,
        "In DeSMòS collega un concetto a un concetto più generale entro gli schemi controllati dell'ontologia. La proprietà originale ha come domain skos:Concept (ereditato da skos:semanticRelation) e come range skos:Concept (ereditato da skos:semanticRelation). In DeSMòS la stessa proprietà ha come domain skos:Concept e come range skos:Concept."@it ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy skos: ;
    rdfs:range skos:Concept ;
    owl:inverseOf skos:narrower .

skos:closeMatch a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "close match"@en,
        "corrispondenza vicina"@it ;
    rdfs:comment "In DeSMòS, it aligns a DeSMòS concept with a semantically close but non-equivalent external concept. The original property has domain skos:Concept (inherited from skos:semanticRelation) and range skos:Concept (inherited from skos:semanticRelation). In DeSMòS, the same property has domain skos:Concept and range skos:Concept."@en,
        "In DeSMòS allinea un concetto DeSMòS a un concetto esterno semanticamente vicino ma non equivalente. La proprietà originale ha come domain skos:Concept (ereditato da skos:semanticRelation) e come range skos:Concept (ereditato da skos:semanticRelation). In DeSMòS la stessa proprietà ha come domain skos:Concept e come range skos:Concept."@it ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy skos: ;
    rdfs:range skos:Concept .

skos:definition a owl:AnnotationProperty ;
    rdfs:label "definition"@en,
        "definizione"@it ;
    rdfs:comment "A statement of the meaning of the concept."@en,
        "Una spiegazione del significato del concetto."@it ;
    rdfs:isDefinedBy skos: .

skos:exactMatch a owl:ObjectProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "exact match"@en,
        "corrispondenza esatta"@it ;
    rdfs:comment "In DeSMòS, it aligns a DeSMòS concept with a semantically equivalent external concept. The original property has domain skos:Concept (inherited from skos:semanticRelation) and range skos:Concept (inherited from skos:semanticRelation). In DeSMòS, the same property has domain skos:Concept and range skos:Concept."@en,
        "In DeSMòS allinea un concetto DeSMòS a un concetto esterno semanticamente equivalente. La proprietà originale ha come domain skos:Concept (ereditato da skos:semanticRelation) e come range skos:Concept (ereditato da skos:semanticRelation). In DeSMòS la stessa proprietà ha come domain skos:Concept e come range skos:Concept."@it ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy skos: ;
    rdfs:range skos:Concept .

skos:example a owl:AnnotationProperty ;
    rdfs:label "example"@en,
        "esempio"@it ;
    rdfs:comment "An example of the use of a concept."@en,
        "Fornisce un esempio dell'uso di un concetto."@it ;
    rdfs:isDefinedBy skos: .

skos:hasTopConcept a owl:ObjectProperty ;
    rdfs:label "has top concept"@en,
        "ha concetto principale"@it ;
    rdfs:comment "In DeSMòS, it relates a concept scheme to the concepts that are its main hierarchical entry points. The original property has domain skos:ConceptScheme and range skos:Concept. In DeSMòS, the same property has domain skos:ConceptScheme and range skos:Concept."@en,
        "In DeSMòS collega uno schema concettuale ai concetti che ne costituiscono i punti di accesso gerarchici principali. La proprietà originale ha come domain skos:ConceptScheme e come range skos:Concept. In DeSMòS la stessa proprietà ha come domain skos:ConceptScheme e come range skos:Concept."@it ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:isDefinedBy skos: ;
    rdfs:range skos:Concept ;
    owl:inverseOf skos:topConceptOf .

skos:historyNote a owl:AnnotationProperty ;
    rdfs:label "history note"@en,
        "nota storica"@it ;
    rdfs:comment "A note about the past use of the concept."@en,
        "Una nota sull'uso passato del concetto."@it ;
    rdfs:isDefinedBy skos: .

skos:inScheme a owl:ObjectProperty ;
    rdfs:label "in scheme"@en,
        "nello schema"@it ;
    rdfs:comment "In DeSMòS, it indicates the concept scheme to which a concept belongs. The original property has no declared domain and range skos:ConceptScheme. In DeSMòS, the same property has domain skos:Concept and range skos:ConceptScheme."@en,
        "In DeSMòS indica lo schema concettuale cui appartiene un concetto. La proprietà originale ha nessun domain dichiarato e come range skos:ConceptScheme. In DeSMòS la stessa proprietà ha come domain skos:Concept e come range skos:ConceptScheme."@it ;
    rdfs:isDefinedBy skos: ;
    rdfs:range skos:ConceptScheme .

skos:prefLabel a owl:AnnotationProperty ;
    rdfs:label "preferred label"@en,
        "etichetta preferita"@it ;
    rdfs:comment "The preferred term for representing the concept."@en,
        "Il termine preferito per rappresentare il concetto."@it ;
    rdfs:isDefinedBy skos: .

skos:related a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "related"@en,
        "correlato"@it ;
    rdfs:comment "In DeSMòS, it expresses non-hierarchical associations between concepts of the controlled vocabularies. The original property has domain skos:Concept (inherited from skos:semanticRelation) and range skos:Concept (inherited from skos:semanticRelation). In DeSMòS, the same property has domain skos:Concept and range skos:Concept."@en,
        "In DeSMòS esprime associazioni semantiche non gerarchiche tra concetti dei vocabolari controllati. La proprietà originale ha come domain skos:Concept (ereditato da skos:semanticRelation) e come range skos:Concept (ereditato da skos:semanticRelation). In DeSMòS la stessa proprietà ha come domain skos:Concept e come range skos:Concept."@it ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy skos: ;
    rdfs:range skos:Concept .

skos:scopeNote a owl:AnnotationProperty ;
    rdfs:label "scope note"@en,
        "nota di ambito"@it ;
    rdfs:comment "A note that clarifies the intended meaning of the concept."@en,
        "Una nota che chiarisce il significato inteso del concetto."@it ;
    rdfs:isDefinedBy skos: .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:label "was attributed to"@en,
        "è stato attribuito a"@it ;
    rdfs:comment "In DeSMòS, it attributes a declaration (linguistic object) about a constraint to the agent responsible for it. The original property has domain prov:Entity and range prov:Agent. In DeSMòS, the same property has domain crm:E33_Linguistic_Object and range crm:E39_Actor (also prov:Agent)."@en,
        "In DeSMòS attribuisce una dichiarazione (oggetto linguistico) relativa a una costrizione all'agente che ne è responsabile. La proprietà originale ha come domain prov:Entity e come range prov:Agent. In DeSMòS la stessa proprietà ha come domain crm:E33_Linguistic_Object e come range crm:E39_Actor (anche prov:Agent)."@it ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy prov: ;
    rdfs:range prov:Agent .

:ArtisticFormScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Artistic Form Scheme"@en,
        "Schema delle forme artistiche"@it ;
    rdfs:comment "Concept scheme defining the artistic form of non-linguistic expressions (visual art, music). Used to qualify lrmoo:F2_Expression instances via crm:P2_has_type, complementing desmos:LiteraryFormScheme where the source expression is not a text."@en,
        "Schema concettuale che definisce la forma artistica di espressioni non linguistiche (arte visuale, musica). Utilizzato per qualificare istanze di lrmoo:F2_Expression tramite crm:P2_has_type, in complemento a desmos:LiteraryFormScheme nei casi in cui l'espressione non sia un testo."@it ;
    rdfs:isDefinedBy : .

:ConstraintOriginScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Constraint Origin Scheme"@en,
        "Schema dell'origine della costrizione"@it ;
    rdfs:comment "Concept scheme distinguishing between traditional constraints and newly introduced constraints in a specific compositional context. Expected as the range value of desmos:constraintOrigin."@en,
        "Schema concettuale che distingue le costrizioni riprese dalla tradizione da quelle introdotte ex novo in uno specifico contesto compositivo. Atteso come valore del range di desmos:constraintOrigin."@it ;
    rdfs:isDefinedBy : .

:FormalConstraintScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Formal Constraint Scheme"@en,
        "Schema delle costrizioni formali"@it ;
    rdfs:comment "Concept scheme collecting formal constraints, which intervene primarily on the signifier of the text."@en,
        "Schema concettuale che raccoglie le costrizioni formali, che intervengono prioritariamente sul significante del testo."@it ;
    rdfs:isDefinedBy : .

:FormalUnitScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Formal Unit Scheme"@en,
        "Schema delle unità formali"@it ;
    rdfs:comment "Concept scheme defining the discrete units of the writing system (e.g., letter, syllable, word) on which a formal constraint operates. Expected as the range value of desmos:constrainsFormalUnit."@en,
        "Schema concettuale che definisce le unità discrete del sistema di scrittura (ad esempio lettera, sillaba, parola) su cui opera una costrizione di tipo formale. Atteso come valore del range di desmos:constrainsFormalUnit."@it ;
    rdfs:isDefinedBy : .

:LiteraryFormScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Literary Form Scheme"@en,
        "Schema delle forme letterarie"@it ;
    rdfs:comment "Concept scheme defining the textual form of the work (prose, poetry, visual form). Used to qualify lrmoo:F2_Expression instances via crm:P2_has_type."@en,
        "Schema concettuale che definisce la forma testuale dell'opera (prosa, poesia, forma visuale). Utilizzato per qualificare istanze di lrmoo:F2_Expression tramite crm:P2_has_type."@it ;
    rdfs:isDefinedBy : .

:ProceduralOperationScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Procedural Operation Scheme"@en,
        "Schema delle operazioni procedurali"@it ;
    rdfs:comment "Concept scheme describing the procedural operations applied to generate the constrained text. Expected as the range value of desmos:involvesOperation."@en,
        "Schema concettuale che descrive le operazioni procedurali applicate per generare il testo vincolato. Atteso come valore del range di desmos:involvesOperation."@it ;
    rdfs:isDefinedBy : .

:SemanticConstraintScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Semantic Constraint Scheme"@en,
        "Schema delle costrizioni semantiche"@it ;
    rdfs:comment "Concept scheme collecting semantic constraints, which intervene primarily on the signified of the text."@en,
        "Schema concettuale che raccoglie le costrizioni semantiche, che intervengono prioritariamente sul significato del testo."@it ;
    rdfs:isDefinedBy : .

:SemanticUnitScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Semantic Unit Scheme"@en,
        "Schema delle unità semantiche"@it ;
    rdfs:comment "Concept scheme defining the discrete units of the content plane (e.g., character, space, time) determined by a semantic constraint. Expected as the range value of desmos:constrainsSemanticUnit."@en,
        "Schema concettuale che definisce le unità discrete del piano del contenuto (personaggio, spazio, tempo) determinate da una costrizione di tipo semantico. Atteso come valore del range di desmos:constrainsSemanticUnit."@it ;
    rdfs:isDefinedBy : .

:VisualConstraint a owl:Class ;
    rdfs:label "Visual constraint"@en,
        "Costrizione visiva"@it ;
    rdfs:comment "Constraint that intervenes on the visual or typographic arrangement of the text, where the spatial layout of letters/words on the page is itself part of the rule. The properties that can be used with this class are desmos:constrainsFormalUnit, desmos:constraintOrigin, desmos:involvesOperation, skos:closeMatch, skos:inScheme and skos:related."@en,
        "Costrizione che interviene sulla disposizione visiva o tipografica del testo, in cui l'impaginazione spaziale di lettere/parole sulla pagina è essa stessa parte della regola. Le proprietà che possono essere usate con questa classe sono desmos:constrainsFormalUnit, desmos:constraintOrigin, desmos:involvesOperation, skos:closeMatch, skos:inScheme e skos:related."@it ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :FormalConstraint .

:VisualConstraintScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Visual Constraint Scheme"@en,
        "Schema delle costrizioni visive"@it ;
    rdfs:comment "Concept scheme collecting visual constraints, which intervene on the spatial, graphic or typographic arrangement of the text on the page."@en,
        "Schema concettuale che raccoglie le costrizioni visive, che intervengono sulla disposizione spaziale, grafica o tipografica del testo sulla pagina."@it ;
    rdfs:isDefinedBy : .

:constraintOrigin a owl:ObjectProperty ;
    rdfs:label "constraint origin"@en,
        "origine della costrizione"@it ;
    rdfs:comment "This property relates a literary constraint to the concept qualifying its origin (tradition or brand-new invention). The property has domain desmos:LiteraryConstraint and range skos:Concept."@en,
        "Questa proprietà collega una costrizione letteraria al concetto che ne qualifica l'origine (tradizione o invenzione ex novo). La proprietà ha come domain desmos:LiteraryConstraint e come range skos:Concept."@it ;
    rdfs:domain :LiteraryConstraint ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    owl:inverseOf :isOriginOf .

:hypertextuality a owl:NamedIndividual,
        intro:INT15_IntertextualityInIntertextualityTheories ;
    rdfs:label "Hypertextuality"@en,
        "Ipertestualità"@it ;
    dcterms:source <https://www.worldcat.org/isbn/9782020061162> ;
    rdfs:isDefinedBy : ;
    skos:definition "Type of intertextual relation, in the Genettian sense, designating any relationship of derivation linking a later text (the hypertext) to an earlier one (the hypotext) upon which it is grafted in a manner that is not that of commentary; the derivation may proceed by transformation (as in parody) or by imitation (as in pastiche)."@en,
        "Tipo di relazione intertestuale, nell'accezione genettiana, che designa qualsiasi rapporto di derivazione che collega un testo posteriore (l'ipertesto) ad un testo anteriore (l'ipotesto) sul quale esso si innesta in modo non commentativo; la derivazione può realizzarsi per trasformazione (come nella parodia) o per imitazione (come nel pastiche)."@it ;
    skos:prefLabel "Hypertextuality"@en,
        "Ipertestualità"@it ;
    skos:scopeNote "Used as the object of intro:R19_hasType to qualify instances of intro:INT31_IntertextualRelation as Genettian hypertextual relations."@en,
        "Utilizzato come oggetto di intro:R19_hasType per qualificare istanze di intro:INT31_IntertextualRelation come relazioni ipertestuali genettiane."@it .

:involvesOperation a owl:ObjectProperty ;
    rdfs:label "involves operation"@en,
        "coinvolge operazione"@it ;
    rdfs:comment "This property relates a literary constraint to the procedural operation its use involves. The property has domain desmos:LiteraryConstraint and range skos:Concept."@en,
        "Questa proprietà collega una costrizione letteraria all'operazione procedurale che il suo impiego comporta. La proprietà ha come domain desmos:LiteraryConstraint e come range skos:Concept."@it ;
    rdfs:domain :LiteraryConstraint ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    owl:inverseOf :isOperationInvolvedIn .

:isConstraintUsedIn a owl:ObjectProperty ;
    rdfs:label "is constraint used in"@en,
        "è costrizione usata in"@it ;
    rdfs:comment "This property relates a literary constraint to the expression creation events in which it was employed as a generative device; subproperty of crm:P33i_was_used_by. The property has domain desmos:LiteraryConstraint and range lrmoo:F28_Expression_Creation."@en,
        "Questa proprietà collega una costrizione letteraria agli eventi di creazione dell'espressione in cui è stata impiegata come dispositivo generativo; sottoproprietà di crm:P33i_was_used_by. La proprietà ha come domain desmos:LiteraryConstraint e come range lrmoo:F28_Expression_Creation."@it ;
    rdfs:domain :LiteraryConstraint ;
    rdfs:isDefinedBy : ;
    rdfs:range lrmoo:F28_Expression_Creation ;
    rdfs:subPropertyOf crm:P33i_was_used_by ;
    owl:inverseOf :usedConstraint .

:isFeatureOf a owl:ObjectProperty ;
    rdfs:label "is feature of"@en,
        "è caratteristica di"@it ;
    rdfs:comment "Inverse of hasFeature: relates a textual feature of a constraint to the expression in which it is manifest. The property has domain desmos:TextualFeature and range lrmoo:F2_Expression."@en,
        "Inversa di hasFeature: collega un'evidenza testuale della costrizione all'espressione in cui è manifesta. La proprietà ha come domain desmos:TextualFeature e come range lrmoo:F2_Expression."@it ;
    rdfs:domain :TextualFeature ;
    rdfs:isDefinedBy : ;
    rdfs:range lrmoo:F2_Expression ;
    owl:inverseOf :hasFeature .

:isFormalUnitConstrainedBy a owl:ObjectProperty ;
    rdfs:label "is formal unit constrained by"@en,
        "è unità formale vincolata da"@it ;
    rdfs:comment "Inverse of constrainsFormalUnit: relates a unit of the writing system to the formal constraints operating on it. The property has domain skos:Concept and range desmos:FormalConstraint."@en,
        "Inversa di constrainsFormalUnit: collega un'unità del sistema di scrittura alle costrizioni formali che operano su di essa. La proprietà ha come domain skos:Concept e come range desmos:FormalConstraint."@it ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy : ;
    rdfs:range :FormalConstraint ;
    owl:inverseOf :constrainsFormalUnit .

:isRevealedBy a owl:ObjectProperty ;
    rdfs:label "is revealed by"@en,
        "è rivelata da"@it ;
    rdfs:comment "Inverse of revealsConstraint: this property relates a literary constraint to the textual feature that makes it identifiable. The property has domain desmos:LiteraryConstraint and range desmos:TextualFeature."@en,
        "Inversa di revealsConstraint: questa proprietà collega una costrizione letteraria all'evidenza testuale che ne permette l'identificazione. La proprietà ha come domain desmos:LiteraryConstraint e come range desmos:TextualFeature."@it ;
    rdfs:domain :LiteraryConstraint ;
    rdfs:isDefinedBy : ;
    rdfs:range :TextualFeature ;
    owl:inverseOf :revealsConstraint .

:isSemanticUnitConstrainedBy a owl:ObjectProperty ;
    rdfs:label "is semantic unit constrained by"@en,
        "è unità semantica vincolata da"@it ;
    rdfs:comment "Inverse of constrainsSemanticUnit: relates a unit of the content plane to the semantic constraints that determine it. The property has domain skos:Concept and range desmos:SemanticConstraint."@en,
        "Inversa di constrainsSemanticUnit: collega un'unità del piano del contenuto alle costrizioni semantiche che la determinano. La proprietà ha come domain skos:Concept e come range desmos:SemanticConstraint."@it ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy : ;
    rdfs:range :SemanticConstraint ;
    owl:inverseOf :constrainsSemanticUnit .

intro:INT31_IntertextualRelation a owl:Class ;
    rdfs:label "INT31 Intertextual Relation"@en,
        "INT31 Relazione Intertestuale"@it ;
    rdfs:comment "In DeSMòS, INT31 Intertextual Relation is used to represent an intertextual relation between texts or their passages as an independent entity, specifying the entities involved and the relation type. The properties that can be used with this class are intro:R12_hasReferredToEntity, intro:R13_hasReferringEntity and intro:R19_hasType."@en,
        "In DeSMòS, INT31 Intertextual Relation è utilizzata per rappresentare come entità autonoma una relazione intertestuale tra testi o loro passaggi, specificandone le entità coinvolte e la tipologia. Le proprietà che possono essere usate con questa classe sono intro:R12_hasReferredToEntity, intro:R13_hasReferringEntity e intro:R19_hasType."@it ;
    rdfs:isDefinedBy intro: ;
    rdfs:subClassOf intro:INT3_Interrelation .

intro:R12_hasReferredToEntity a owl:ObjectProperty ;
    rdfs:label "R12 has referred to entity"@en,
        "R12 ha entità a cui si riferisce"@it ;
    rdfs:comment "In DeSMòS, it identifies the hypotextual entity of an intertextual relation: the whole expression or, when the relation can be localised, a specific passage of the hypotext. The original property has domain intro:INT3_Interrelation and range the union of lrmoo:F1_Work, crm:E73_Information_Object, intro:INT1_Passage, intro:INT2_ActualizationOfFeature and intro:INT6_Architext. In DeSMòS, the same property has domain intro:INT31_IntertextualRelation and range lrmoo:F2_Expression or intro:INT21_TextPassage."@en,
        "In DeSMòS identifica l'entità ipotestuale di una relazione intertestuale: l'intera espressione o, se la relazione è localizzabile, un passaggio specifico dell'ipotesto. La proprietà originale ha come domain intro:INT3_Interrelation e come range l'unione di lrmoo:F1_Work, crm:E73_Information_Object, intro:INT1_Passage, intro:INT2_ActualizationOfFeature e intro:INT6_Architext. In DeSMòS la stessa proprietà ha come domain intro:INT31_IntertextualRelation e come range lrmoo:F2_Expression o intro:INT21_TextPassage."@it ;
    rdfs:domain intro:INT3_Interrelation ;
    rdfs:isDefinedBy intro: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( lrmoo:F1_Work crm:E73_Information_Object intro:INT1_Passage intro:INT2_ActualizationOfFeature intro:INT6_Architext ) ] ;
    owl:inverseOf intro:R12i_isReferredToEntity .

intro:R13_hasReferringEntity a owl:ObjectProperty ;
    rdfs:label "R13 has referring entity"@en,
        "R13 ha entità referente"@it ;
    rdfs:comment "In DeSMòS, it identifies the hypertextual entity of an intertextual relation: the whole expression or, when the relation can be localised, a specific passage of the hypertext. The original property has domain intro:INT3_Interrelation and range the union of lrmoo:F1_Work, crm:E73_Information_Object, intro:INT1_Passage, intro:INT2_ActualizationOfFeature and intro:INT6_Architext. In DeSMòS, the same property has domain intro:INT31_IntertextualRelation and range lrmoo:F2_Expression or intro:INT21_TextPassage."@en,
        "In DeSMòS identifica l'entità ipertestuale di una relazione intertestuale: l'intera espressione o, se la relazione è localizzabile, un passaggio specifico dell'ipertesto. La proprietà originale ha come domain intro:INT3_Interrelation e come range l'unione di lrmoo:F1_Work, crm:E73_Information_Object, intro:INT1_Passage, intro:INT2_ActualizationOfFeature e intro:INT6_Architext. In DeSMòS la stessa proprietà ha come domain intro:INT31_IntertextualRelation e come range lrmoo:F2_Expression o intro:INT21_TextPassage."@it ;
    rdfs:domain intro:INT3_Interrelation ;
    rdfs:isDefinedBy intro: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( lrmoo:F1_Work crm:E73_Information_Object intro:INT1_Passage intro:INT2_ActualizationOfFeature intro:INT6_Architext ) ] ;
    owl:inverseOf intro:R13i_isReferringEntity .

intro:R19_hasType a owl:ObjectProperty ;
    rdfs:label "R19 has type"@en,
        "R19 ha tipo"@it ;
    rdfs:comment "In DeSMòS, it qualifies an intertextual relation with a controlled type (e.g., hypertextuality). The original property has domain intro:INT3_Interrelation and range intro:INT11_TypeOfInterrelation. In DeSMòS, the same property has domain intro:INT31_IntertextualRelation and range intro:INT11_TypeOfInterrelation."@en,
        "In DeSMòS qualifica una relazione intertestuale con un tipo controllato (es. ipertestualità). La proprietà originale ha come domain intro:INT3_Interrelation e come range intro:INT11_TypeOfInterrelation. In DeSMòS la stessa proprietà ha come domain intro:INT31_IntertextualRelation e come range intro:INT11_TypeOfInterrelation."@it ;
    rdfs:domain intro:INT3_Interrelation ;
    rdfs:isDefinedBy intro: ;
    rdfs:range intro:INT11_TypeOfInterrelation ;
    owl:inverseOf intro:R19i_isTypeOf .

intro:R30_hasTextPassage a owl:ObjectProperty ;
    rdfs:label "R30 has text passage"@en,
        "R30 ha passaggio testuale"@it ;
    rdfs:comment "In DeSMòS, it relates an expression to a textual passage selected within it, when an intertextual relation concerns specific portions of the text. The original property has domain the union of crm:E73_Information_Object and intro:INT1_Passage and range intro:INT21_TextPassage. In DeSMòS, the same property has domain lrmoo:F2_Expression and range intro:INT21_TextPassage."@en,
        "In DeSMòS collega un'espressione a un passaggio testuale selezionato al suo interno, quando la relazione intertestuale riguarda porzioni specifiche del testo. La proprietà originale ha come domain l'unione di crm:E73_Information_Object e intro:INT1_Passage e come range intro:INT21_TextPassage. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression e come range intro:INT21_TextPassage."@it ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( crm:E73_Information_Object intro:INT1_Passage ) ] ;
    rdfs:isDefinedBy intro: ;
    rdfs:range intro:INT21_TextPassage ;
    owl:inverseOf intro:R30i_isTextPassageOf .

intro:R44_hasWording a owl:DatatypeProperty ;
    rdfs:label "R44 has wording"@en,
        "R44 ha formulazione"@it ;
    rdfs:comment "In DeSMòS, R44 has wording is used to record as a string the exact textual wording of a passage identified through INT21 Text Passage."@en,
        "In DeSMòS, R44 has wording è utilizzata per registrare come stringa la formulazione testuale esatta di un passaggio identificato mediante INT21 Text Passage."@it ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( intro:INT16_Segment intro:INT1_Passage ) ] ;
    rdfs:isDefinedBy intro: .

lrmoo:R15i_is_fragment_of a owl:ObjectProperty ;
    rdfs:label "R15i is fragment of"@en,
        "R15i è frammento di"@it ;
    rdfs:comment "Inverse of R15 has fragment: in DeSMòS, it relates a peritextual declaration to the expression of which it is a fragment. The original property has domain crm:E90_Symbolic_Object and range lrmoo:F2_Expression. In DeSMòS, the same property has domain crm:E33_Linguistic_Object and range lrmoo:F2_Expression."@en,
        "Inversa di R15 has fragment: in DeSMòS collega una dichiarazione peritestuale all'espressione di cui è frammento. La proprietà originale ha come domain crm:E90_Symbolic_Object e come range lrmoo:F2_Expression. In DeSMòS la stessa proprietà ha come domain crm:E33_Linguistic_Object e come range lrmoo:F2_Expression."@it ;
    rdfs:domain crm:E90_Symbolic_Object ;
    rdfs:isDefinedBy lrmoo: ;
    rdfs:range lrmoo:F2_Expression .

lrmoo:R17i_was_created_by a owl:ObjectProperty ;
    rdfs:label "R17i was created by"@en,
        "R17i è stata creata da"@it ;
    rdfs:comment "Inverse of R17 created: in DeSMòS, it relates a textual expression to the compositional event that produced it. The original property has domain lrmoo:F2_Expression and range lrmoo:F28_Expression_Creation. In DeSMòS, the same property has domain lrmoo:F2_Expression and range lrmoo:F28_Expression_Creation."@en,
        "Inversa di R17 created: in DeSMòS collega un'espressione testuale all'evento compositivo che l'ha prodotta. La proprietà originale ha come domain lrmoo:F2_Expression e come range lrmoo:F28_Expression_Creation. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression e come range lrmoo:F28_Expression_Creation."@it ;
    rdfs:domain lrmoo:F2_Expression ;
    rdfs:isDefinedBy lrmoo: ;
    rdfs:range lrmoo:F28_Expression_Creation .

lrmoo:R3i_realises a owl:ObjectProperty ;
    rdfs:label "R3i realises"@en,
        "R3i realizza"@it ;
    rdfs:comment "Inverse of R3 is realised in: in DeSMòS, it relates a textual expression to the work it realises. The original property has domain lrmoo:F2_Expression and range lrmoo:F1_Work. In DeSMòS, the same property has domain lrmoo:F2_Expression and range lrmoo:F1_Work."@en,
        "Inversa di R3 is realised in: in DeSMòS collega un'espressione testuale all'opera che realizza. La proprietà originale ha come domain lrmoo:F2_Expression e come range lrmoo:F1_Work. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression e come range lrmoo:F1_Work."@it ;
    rdfs:domain lrmoo:F2_Expression ;
    rdfs:isDefinedBy lrmoo: ;
    rdfs:range lrmoo:F1_Work .

lrmoo:R4i_is_embodied_in a owl:ObjectProperty ;
    rdfs:label "R4i is embodied in"@en,
        "R4i è incarnata in"@it ;
    rdfs:comment "Inverse of R4 embodies: in DeSMòS, it relates an expression to the published or digital manifestation embodying it. The original property has domain lrmoo:F2_Expression and range lrmoo:F3_Manifestation. In DeSMòS, the same property has domain lrmoo:F2_Expression and range lrmoo:F3_Manifestation."@en,
        "Inversa di R4 embodies: in DeSMòS collega un'espressione alla manifestazione editoriale o digitale che la incorpora. La proprietà originale ha come domain lrmoo:F2_Expression e come range lrmoo:F3_Manifestation. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression e come range lrmoo:F3_Manifestation."@it ;
    rdfs:domain lrmoo:F2_Expression ;
    rdfs:isDefinedBy lrmoo: ;
    rdfs:range lrmoo:F3_Manifestation .

lrmoo:R76i_has_derivative a owl:ObjectProperty ;
    rdfs:label "R76i has derivative"@en,
        "R76i ha derivato"@it ;
    rdfs:comment "Inverse of R76 is derivative of: in DeSMòS, it relates a source expression to the expressions derived from it. The original property has domain lrmoo:F2_Expression and range lrmoo:F2_Expression. In DeSMòS, the same property has domain lrmoo:F2_Expression and range lrmoo:F2_Expression."@en,
        "Inversa di R76 is derivative of: in DeSMòS collega un'espressione fonte alle espressioni che ne derivano. La proprietà originale ha come domain lrmoo:F2_Expression e come range lrmoo:F2_Expression. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression e come range lrmoo:F2_Expression."@it ;
    rdfs:domain lrmoo:F2_Expression ;
    rdfs:isDefinedBy lrmoo: ;
    rdfs:range lrmoo:F2_Expression .

crm:P129i_is_subject_of a owl:ObjectProperty ;
    rdfs:label "P129i is subject of"@en,
        "P129i è oggetto di"@it ;
    rdfs:comment "Inverse of P129 is about: in DeSMòS, it relates a literary constraint to the declarations that have it as their subject. The original property has domain crm:E1_CRM_Entity and range crm:E89_Propositional_Object. In DeSMòS, the same property has domain desmos:LiteraryConstraint and range crm:E33_Linguistic_Object."@en,
        "Inversa di P129 is about: in DeSMòS collega una costrizione letteraria alle dichiarazioni che la hanno come argomento. La proprietà originale ha come domain crm:E1_CRM_Entity e come range crm:E89_Propositional_Object. In DeSMòS la stessa proprietà ha come domain desmos:LiteraryConstraint e come range crm:E33_Linguistic_Object."@it ;
    rdfs:domain crm:E1_CRM_Entity ;
    rdfs:isDefinedBy crm: ;
    rdfs:range crm:E89_Propositional_Object .

crm:P130_shows_features_of a owl:ObjectProperty ;
    rdfs:label "P130 shows features of"@en,
        "P130 presenta caratteristiche di"@it ;
    rdfs:comment "In DeSMòS, it documents a looser link between expressions than R76 is derivative of: the expression shows features of a source (lexical, onomastic, phraseological, thematic, narrative or, for non-textual sources, of tempo and pacing) without deriving its content or establishing an INTRO intertextual relation. The original property has domain crm:E70_Thing and range crm:E70_Thing. In DeSMòS, the same property has domain lrmoo:F2_Expression and range lrmoo:F2_Expression."@en,
        "In DeSMòS documenta un legame tra espressioni più blando di R76 is derivative of: l'espressione presenta tratti di una fonte (lessicali, onomastici, fraseologici, tematici, narrativi o, per fonti non testuali, di andamento) senza derivarne il contenuto né instaurare una relazione intertestuale INTRO. La proprietà originale ha come domain crm:E70_Thing e come range crm:E70_Thing. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression e come range lrmoo:F2_Expression."@it ;
    rdfs:domain crm:E70_Thing ;
    rdfs:isDefinedBy crm: ;
    rdfs:range crm:E70_Thing ;
    owl:inverseOf crm:P130i_features_are_also_found_on .

crm:P130i_features_are_also_found_on a owl:ObjectProperty ;
    rdfs:label "P130i features are also found on"@en,
        "P130i caratteristiche si ritrovano anche in"@it ;
    rdfs:comment "Inverse of P130 shows features of: in DeSMòS, it relates an expression used as a source to the expressions showing its features without deriving its content. The original property has domain crm:E70_Thing and range crm:E70_Thing. In DeSMòS, the same property has domain lrmoo:F2_Expression and range lrmoo:F2_Expression."@en,
        "Inversa di P130 shows features of: in DeSMòS collega un'espressione assunta come fonte alle espressioni che ne presentano tratti senza derivarne il contenuto. La proprietà originale ha come domain crm:E70_Thing e come range crm:E70_Thing. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression e come range lrmoo:F2_Expression."@it ;
    rdfs:domain crm:E70_Thing ;
    rdfs:isDefinedBy crm: ;
    rdfs:range crm:E70_Thing .

crm:P148i_is_component_of a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "P148i is component of"@en,
        "P148i è componente di"@it ;
    rdfs:comment "Inverse of P148 has component: in DeSMòS, it relates a component to the complex expression or manifestation it belongs to. The original property has domain crm:E89_Propositional_Object and range crm:E89_Propositional_Object. In DeSMòS, the same property has domain lrmoo:F2_Expression (between expressions) or lrmoo:F3_Manifestation (between manifestations) and range lrmoo:F2_Expression or lrmoo:F3_Manifestation respectively."@en,
        "Inversa di P148 has component: in DeSMòS collega una componente all'espressione o manifestazione complessa di cui fa parte. La proprietà originale ha come domain crm:E89_Propositional_Object e come range crm:E89_Propositional_Object. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression (tra espressioni) o lrmoo:F3_Manifestation (tra manifestazioni) e come range rispettivamente lrmoo:F2_Expression o lrmoo:F3_Manifestation."@it ;
    rdfs:domain crm:E89_Propositional_Object ;
    rdfs:isDefinedBy crm: ;
    rdfs:range crm:E89_Propositional_Object .

crm:P14i_performed a owl:ObjectProperty ;
    rdfs:label "P14i performed"@en,
        "P14i ha eseguito"@it ;
    rdfs:comment "Inverse of P14 carried out by: in DeSMòS, it relates an author to the expression creation events they carried out. The original property has domain crm:E39_Actor and range crm:E7_Activity. In DeSMòS, the same property has domain crm:E39_Actor and range lrmoo:F28_Expression_Creation."@en,
        "Inversa di P14 carried out by: in DeSMòS collega un autore agli eventi di creazione dell'espressione che ha realizzato. La proprietà originale ha come domain crm:E39_Actor e come range crm:E7_Activity. In DeSMòS la stessa proprietà ha come domain crm:E39_Actor e come range lrmoo:F28_Expression_Creation."@it ;
    rdfs:domain crm:E39_Actor ;
    rdfs:isDefinedBy crm: ;
    rdfs:range crm:E7_Activity .

crm:P2i_is_type_of a owl:ObjectProperty ;
    rdfs:label "P2i is type of"@en,
        "P2i è tipo di"@it ;
    rdfs:comment "Inverse of P2 has type: in DeSMòS, it relates a literary or artistic form type to the expressions it classifies. The original property has domain crm:E55_Type and range crm:E1_CRM_Entity. In DeSMòS, the same property has domain crm:E55_Type and range lrmoo:F2_Expression."@en,
        "Inversa di P2 has type: in DeSMòS collega un tipo di forma letteraria o artistica alle espressioni che classifica. La proprietà originale ha come domain crm:E55_Type e come range crm:E1_CRM_Entity. In DeSMòS la stessa proprietà ha come domain crm:E55_Type e come range lrmoo:F2_Expression."@it ;
    rdfs:domain crm:E55_Type ;
    rdfs:isDefinedBy crm: ;
    rdfs:range crm:E1_CRM_Entity .

crm:P33_used_specific_technique a owl:ObjectProperty ;
    rdfs:label "P33 used specific technique"@en,
        "P33 ha usato la tecnica specifica"@it ;
    rdfs:comment "In DeSMòS, it relates an expression creation event to the literary constraint employed as a compositional procedure. The original property has domain crm:E7_Activity and range crm:E29_Design_or_Procedure. In DeSMòS, the same property has domain lrmoo:F28_Expression_Creation and range desmos:LiteraryConstraint."@en,
        "In DeSMòS collega un evento di creazione dell'espressione alla costrizione letteraria impiegata come procedura compositiva. La proprietà originale ha come domain crm:E7_Activity e come range crm:E29_Design_or_Procedure. In DeSMòS la stessa proprietà ha come domain lrmoo:F28_Expression_Creation e come range desmos:LiteraryConstraint."@it ;
    rdfs:domain crm:E7_Activity ;
    rdfs:isDefinedBy crm: ;
    rdfs:range crm:E29_Design_or_Procedure ;
    owl:inverseOf crm:P33i_was_used_by .

crm:P67i_is_referred_to_by a owl:ObjectProperty ;
    rdfs:label "P67i is referred to by"@en,
        "P67i è riferito da"@it ;
    rdfs:comment "Inverse of P67 refers to: in DeSMòS, it relates a textual expression to the declarations referring to it. The original property has domain crm:E1_CRM_Entity and range crm:E89_Propositional_Object. In DeSMòS, the same property has domain lrmoo:F2_Expression and range crm:E33_Linguistic_Object."@en,
        "Inversa di P67 refers to: in DeSMòS collega un'espressione testuale alle dichiarazioni che vi fanno riferimento. La proprietà originale ha come domain crm:E1_CRM_Entity e come range crm:E89_Propositional_Object. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression e come range crm:E33_Linguistic_Object."@it ;
    rdfs:domain crm:E1_CRM_Entity ;
    rdfs:isDefinedBy crm: ;
    rdfs:range crm:E89_Propositional_Object .

skos:narrower a owl:ObjectProperty ;
    rdfs:label "narrower"@en,
        "più specifico"@it ;
    rdfs:comment "Inverse of skos:broader: in DeSMòS, it relates a concept to a more specific concept within the ontology's controlled schemes. The original property has domain skos:Concept (inherited from skos:semanticRelation) and range skos:Concept (inherited from skos:semanticRelation). In DeSMòS, the same property has domain skos:Concept and range skos:Concept."@en,
        "Inversa di skos:broader: in DeSMòS collega un concetto a un concetto più specifico entro gli schemi controllati dell'ontologia. La proprietà originale ha come domain skos:Concept (ereditato da skos:semanticRelation) e come range skos:Concept (ereditato da skos:semanticRelation). In DeSMòS la stessa proprietà ha come domain skos:Concept e come range skos:Concept."@it ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy skos: ;
    rdfs:range skos:Concept .

skos:topConceptOf a owl:ObjectProperty ;
    rdfs:label "top concept of"@en,
        "concetto principale di"@it ;
    rdfs:comment "Inverse of skos:hasTopConcept: in DeSMòS, it relates a concept to the scheme of which it is a main hierarchical entry point. The original property has domain skos:Concept and range skos:ConceptScheme. In DeSMòS, the same property has domain skos:Concept and range skos:ConceptScheme."@en,
        "Inversa di skos:hasTopConcept: in DeSMòS collega un concetto allo schema di cui è punto di accesso gerarchico principale. La proprietà originale ha come domain skos:Concept e come range skos:ConceptScheme. In DeSMòS la stessa proprietà ha come domain skos:Concept e come range skos:ConceptScheme."@it ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy skos: ;
    rdfs:range skos:ConceptScheme .

prov:Agent a owl:Class ;
    rdfs:label "Agent"@en,
        "Agente"@it ;
    rdfs:comment "In DeSMòS, prov:Agent is used to represent agents to whom entities or declarations are attributed, including authors, editors, collective agents and, where relevant, software systems."@en,
        "In DeSMòS, prov:Agent è utilizzata per rappresentare gli agenti ai quali vengono attribuite entità o dichiarazioni, inclusi autori, curatori, soggetti collettivi e, ove pertinente, sistemi software."@it ;
    rdfs:isDefinedBy prov: .

prov:Entity a owl:Class ;
    rdfs:label "Entity"@en,
        "Entità"@it ;
    rdfs:comment "In DeSMòS, prov:Entity is used as a provenance category for linguistic objects whose attribution to an agent is documented, particularly declarations concerning literary constraints."@en,
        "In DeSMòS, prov:Entity è utilizzata come categoria di provenienza per gli oggetti linguistici di cui viene documentata l'attribuzione a un agente, in particolare le dichiarazioni relative alle costrizioni letterarie."@it ;
    rdfs:isDefinedBy prov: .

:coarserThan a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has coarser granularity than"@en,
        "ha granularità più ampia di"@it ;
    rdfs:comment "Relates a formal unit to a formal unit of finer textual granularity (e.g., a word with respect to a syllable or a letter), exclusively within the FormalUnitScheme. The property has domain skos:Concept and range skos:Concept."@en,
        "Collega un'unità formale a un'unità formale di granularità testuale più fine (es. la parola rispetto a sillaba e lettera), esclusivamente entro il FormalUnitScheme. La proprietà ha come domain skos:Concept e come range skos:Concept."@it ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    owl:inverseOf :finerThan .

:constrainsFormalUnit a owl:ObjectProperty ;
    rdfs:label "constrains formal unit"@en,
        "vincola unità formale"@it ;
    rdfs:comment "Relates a formal constraint to the textual unit on which it operates. The property has domain desmos:FormalConstraint and range skos:Concept."@en,
        "Collega una costrizione formale all'unità testuale su cui opera (ad es. lettera, sillaba o parola). La proprietà ha come domain desmos:FormalConstraint e come range skos:Concept."@it ;
    rdfs:domain :FormalConstraint ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept .

:constrainsSemanticUnit a owl:ObjectProperty ;
    rdfs:label "constrains semantic unit"@en,
        "vincola unità semantica"@it ;
    rdfs:comment "This property relates a semantic constraint to the semantic unit on which it operates (e.g., character, space, or time). The property has domain desmos:SemanticConstraint and range skos:Concept."@en,
        "Questa proprietà collega una costrizione semantica all’unità semantica su cui opera (ad es. personaggio, spazio o tempo). La proprietà ha come domain desmos:SemanticConstraint e come range skos:Concept."@it ;
    rdfs:domain :SemanticConstraint ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept .

:finerThan a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has finer granularity than"@en,
        "ha granularità più fine di"@it ;
    rdfs:comment "Relates a formal unit to a formal unit of coarser textual granularity (e.g., a letter with respect to a syllable or a word), exclusively within the FormalUnitScheme. The property has domain skos:Concept and range skos:Concept."@en,
        "Collega un'unità formale a un'unità formale di granularità testuale più ampia (es. la lettera rispetto a sillaba e parola), esclusivamente entro il FormalUnitScheme. La proprietà ha come domain skos:Concept e come range skos:Concept."@it ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    owl:inverseOf :coarserThan .

:hasFeature a owl:ObjectProperty ;
    rdfs:label "has feature"@en,
        "ha caratteristica"@it ;
    rdfs:comment "This property relates a textual expression to an observable textual feature of a constraint. The property has domain lrmoo:F2_Expression and range desmos:TextualFeature."@en,
        "Questa proprietà collega un'espressione testuale all'evidenza testuale osservabile di una costrizione. La proprietà ha come domain lrmoo:F2_Expression e come range desmos:TextualFeature."@it ;
    rdfs:domain lrmoo:F2_Expression ;
    rdfs:isDefinedBy : ;
    rdfs:range :TextualFeature .

:isOperationInvolvedIn a owl:ObjectProperty ;
    rdfs:label "is operation involved in"@en,
        "è l'operazione coinvolta in"@it ;
    rdfs:comment "Inverse of involvesOperation: this property relates a procedural operation to the literary constraints that involve it. The property has domain skos:Concept and range desmos:LiteraryConstraint."@en,
        "Inversa di involvesOperation: questa proprietà collega un'operazione procedurale alle costrizioni letterarie che la comportano. La proprietà ha come domain skos:Concept e come range desmos:LiteraryConstraint."@it ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy : ;
    rdfs:range :LiteraryConstraint .

:isOriginOf a owl:ObjectProperty ;
    rdfs:label "is origin of"@en,
        "è origine di"@it ;
    rdfs:comment "This property relates an origin concept (tradition or brand-new invention) to the literary constraints it qualifies. The property has domain skos:Concept and range desmos:LiteraryConstraint."@en,
        "Questa proprietà collega un concetto di origine (tradizione o invenzione ex novo) alle costrizioni letterarie che qualifica. La proprietà ha come domain skos:Concept e come range desmos:LiteraryConstraint."@it ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy : ;
    rdfs:range :LiteraryConstraint .

:revealsConstraint a owl:ObjectProperty ;
    rdfs:label "reveals constraint"@en,
        "rivela costrizione"@it ;
    rdfs:comment "Inverse of isRevealedBy: this property relates a textual feature to the literary constraint it makes identifiable. The property has domain desmos:TextualFeature and range desmos:LiteraryConstraint."@en,
        "Inversa di isRevealedBy: questa proprietà collega un'evidenza testuale alla costrizione letteraria che rende identificabile. La proprietà ha come domain desmos:TextualFeature e come range desmos:LiteraryConstraint."@it ;
    rdfs:domain :TextualFeature ;
    rdfs:isDefinedBy : ;
    rdfs:range :LiteraryConstraint .

:usedConstraint a owl:ObjectProperty ;
    rdfs:label "used constraint"@en,
        "ha usato costrizione"@it ;
    rdfs:comment "This property relates an expression creation event to the literary constraint employed as a generative device; subproperty of crm:P33_used_specific_technique. The property has domain lrmoo:F28_Expression_Creation and range desmos:LiteraryConstraint."@en,
        "Questa proprietà collega un evento di creazione dell'espressione alla costrizione letteraria impiegata come dispositivo generativo; sottoproprietà di crm:P33_used_specific_technique. La proprietà ha come domain lrmoo:F28_Expression_Creation e come range desmos:LiteraryConstraint."@it ;
    rdfs:domain lrmoo:F28_Expression_Creation ;
    rdfs:isDefinedBy : ;
    rdfs:range :LiteraryConstraint ;
    rdfs:subPropertyOf crm:P33_used_specific_technique .

intro:INT15_IntertextualityInIntertextualityTheories a owl:Class ;
    rdfs:label "INT15 Intertextuality in Intertextuality Theories"@en,
        "INT15 Intertestualità nelle teorie dell'intertestualità"@it ;
    rdfs:comment "In DeSMòS, INT15 Intertextuality in Intertextuality Theories is used to represent relation types derived from theories of intertextuality, including hypertextuality in Gérard Genette's classification."@en,
        "In DeSMòS, INT15 Intertextuality in Intertextuality Theories è utilizzata per rappresentare tipi di relazione derivati da teorie dell'intertestualità, tra cui l'ipertestualità nella classificazione di Gérard Genette."@it ;
    rdfs:isDefinedBy intro: ;
    rdfs:subClassOf intro:INT11_TypeOfInterrelation .

intro:INT16_Segment a owl:Class ;
    rdfs:label "INT16 Segment"@en,
        "INT16 Segmento"@it ;
    rdfs:comment "In DeSMòS, INT16 Segment is referenced only as a member of the original union domain of R44 has wording; it is not instantiated in the DeSMòS corpus, where R44 is applied to INT21 Text Passage."@en,
        "In DeSMòS, INT16 Segment è referenziata solo come membro dell'unione che costituisce il domain originale di R44 has wording; non è istanziata nel corpus DeSMòS, dove R44 è applicata a INT21 Text Passage."@it ;
    rdfs:isDefinedBy intro: ;
    rdfs:subClassOf crm:E90_Symbolic_Object .

intro:R12i_isReferredToEntity a owl:ObjectProperty ;
    rdfs:label "R12i is referred to entity of"@en,
        "R12i è entità a cui si riferisce di"@it ;
    rdfs:comment "Inverse of R12 has referred to entity: in DeSMòS, it relates a hypotextual entity (expression or passage) to the intertextual relation in which it is the entity referred to. The original property has domain the union of lrmoo:F1_Work, crm:E73_Information_Object, intro:INT1_Passage, intro:INT2_ActualizationOfFeature and intro:INT6_Architext and range intro:INT3_Interrelation. In DeSMòS, the same property has domain lrmoo:F2_Expression or intro:INT21_TextPassage and range intro:INT31_IntertextualRelation."@en,
        "Inversa di R12 has referred to entity: in DeSMòS collega un'entità ipotestuale (espressione o passaggio) alla relazione intertestuale in cui è l'entità a cui si fa riferimento. La proprietà originale ha come domain l'unione di lrmoo:F1_Work, crm:E73_Information_Object, intro:INT1_Passage, intro:INT2_ActualizationOfFeature e intro:INT6_Architext e come range intro:INT3_Interrelation. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression o intro:INT21_TextPassage e come range intro:INT31_IntertextualRelation."@it ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( lrmoo:F1_Work crm:E73_Information_Object intro:INT1_Passage intro:INT2_ActualizationOfFeature intro:INT6_Architext ) ] ;
    rdfs:isDefinedBy intro: ;
    rdfs:range intro:INT3_Interrelation .

intro:R13i_isReferringEntity a owl:ObjectProperty ;
    rdfs:label "R13i is referring entity of"@en,
        "R13i è entità referente di"@it ;
    rdfs:comment "Inverse of R13 has referring entity: in DeSMòS, it relates a hypertextual entity (expression or passage) to the intertextual relation in which it is the referring entity. The original property has domain the union of lrmoo:F1_Work, crm:E73_Information_Object, intro:INT1_Passage, intro:INT2_ActualizationOfFeature and intro:INT6_Architext and range intro:INT3_Interrelation. In DeSMòS, the same property has domain lrmoo:F2_Expression or intro:INT21_TextPassage and range intro:INT31_IntertextualRelation."@en,
        "Inversa di R13 has referring entity: in DeSMòS collega un'entità ipertestuale (espressione o passaggio) alla relazione intertestuale in cui è l'entità referente. La proprietà originale ha come domain l'unione di lrmoo:F1_Work, crm:E73_Information_Object, intro:INT1_Passage, intro:INT2_ActualizationOfFeature e intro:INT6_Architext e come range intro:INT3_Interrelation. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression o intro:INT21_TextPassage e come range intro:INT31_IntertextualRelation."@it ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( lrmoo:F1_Work crm:E73_Information_Object intro:INT1_Passage intro:INT2_ActualizationOfFeature intro:INT6_Architext ) ] ;
    rdfs:isDefinedBy intro: ;
    rdfs:range intro:INT3_Interrelation .

intro:R19i_isTypeOf a owl:ObjectProperty ;
    rdfs:label "R19i is type of"@en,
        "R19i è tipo di"@it ;
    rdfs:comment "Inverse of R19 has type: in DeSMòS, it relates a relation type to the intertextual relations it qualifies. The original property has domain intro:INT11_TypeOfInterrelation and range intro:INT3_Interrelation. In DeSMòS, the same property has domain intro:INT11_TypeOfInterrelation and range intro:INT31_IntertextualRelation."@en,
        "Inversa di R19 has type: in DeSMòS collega un tipo di relazione alle relazioni intertestuali che qualifica. La proprietà originale ha come domain intro:INT11_TypeOfInterrelation e come range intro:INT3_Interrelation. In DeSMòS la stessa proprietà ha come domain intro:INT11_TypeOfInterrelation e come range intro:INT31_IntertextualRelation."@it ;
    rdfs:domain intro:INT11_TypeOfInterrelation ;
    rdfs:isDefinedBy intro: ;
    rdfs:range intro:INT3_Interrelation .

intro:R30i_isTextPassageOf a owl:ObjectProperty ;
    rdfs:label "R30i is text passage of"@en,
        "R30i è passaggio testuale di"@it ;
    rdfs:comment "Inverse of R30 has text passage: in DeSMòS, it relates a textual passage to the expression from which it is taken. The original property has domain intro:INT21_TextPassage and range the union of crm:E73_Information_Object and intro:INT1_Passage. In DeSMòS, the same property has domain intro:INT21_TextPassage and range lrmoo:F2_Expression."@en,
        "Inversa di R30 has text passage: in DeSMòS collega un passaggio testuale all'espressione da cui è tratto. La proprietà originale ha come domain intro:INT21_TextPassage e come range l'unione di crm:E73_Information_Object e intro:INT1_Passage. In DeSMòS la stessa proprietà ha come domain intro:INT21_TextPassage e come range lrmoo:F2_Expression."@it ;
    rdfs:domain intro:INT21_TextPassage ;
    rdfs:isDefinedBy intro: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( crm:E73_Information_Object intro:INT1_Passage ) ] .

lrmoo:F3_Manifestation a owl:Class ;
    rdfs:label "F3 Manifestation"@en,
        "F3 Manifestazione"@it ;
    rdfs:comment "In DeSMòS, F3 Manifestation is used to represent the published or digital manifestation embodying an expression and carrying information about its publication and textual location. The properties that can be used with this class are crm:P148_has_component, crm:P148i_is_component_of, dcterms:issued, lrmoo:R4_embodies and schema:pagination."@en,
        "In DeSMòS, F3 Manifestation è utilizzata per rappresentare la manifestazione editoriale o digitale che incorpora un'espressione e alla quale sono associate informazioni relative alla pubblicazione e alla collocazione del testo. Le proprietà che possono essere usate con questa classe sono crm:P148_has_component, crm:P148i_is_component_of, dcterms:issued, lrmoo:R4_embodies e schema:pagination."@it ;
    rdfs:isDefinedBy lrmoo: ;
    rdfs:subClassOf crm:E73_Information_Object .

crm:E39_Actor a owl:Class ;
    rdfs:label "E39 Actor"@en,
        "E39 Attore"@it ;
    rdfs:comment "In DeSMòS, E39 Actor is used to represent authors, editors, and collective agents involved in the creation and documentation of textual expressions."@en,
        "In DeSMòS, E39 Actor è utilizzata per rappresentare autori, curatori e soggetti collettivi coinvolti nella creazione e nella documentazione delle espressioni testuali."@it ;
    rdfs:isDefinedBy crm: ;
    rdfs:subClassOf crm:E1_CRM_Entity .

crm:P33i_was_used_by a owl:ObjectProperty ;
    rdfs:label "P33i was used by"@en,
        "P33i è stata usata da"@it ;
    rdfs:comment "Inverse of P33 used specific technique: in DeSMòS, it relates a literary constraint to the expression creation events in which it was employed. The original property has domain crm:E29_Design_or_Procedure and range crm:E7_Activity. In DeSMòS, the same property has domain desmos:LiteraryConstraint and range lrmoo:F28_Expression_Creation."@en,
        "Inversa di P33 used specific technique: in DeSMòS collega una costrizione letteraria agli eventi di creazione dell'espressione in cui è stata impiegata. La proprietà originale ha come domain crm:E29_Design_or_Procedure e come range crm:E7_Activity. In DeSMòS la stessa proprietà ha come domain desmos:LiteraryConstraint e come range lrmoo:F28_Expression_Creation."@it ;
    rdfs:domain crm:E29_Design_or_Procedure ;
    rdfs:isDefinedBy crm: ;
    rdfs:range crm:E7_Activity .

intro:INT21_TextPassage a owl:Class ;
    rdfs:label "INT21 Text Passage"@en,
        "INT21 Passaggio Testuale"@it ;
    rdfs:comment "In DeSMòS, INT21 Text Passage is used to represent an identifiable textual portion of an expression, particularly when documenting passages involved in an intertextual relation. The properties that can be used with this class are intro:R30i_isTextPassageOf and intro:R44_hasWording."@en,
        "In DeSMòS, INT21 Text Passage è utilizzata per rappresentare una porzione testuale identificabile di un'espressione, in particolare quando è necessario documentare i passaggi coinvolti in una relazione intertestuale. Le proprietà che possono essere usate con questa classe sono intro:R30i_isTextPassageOf e intro:R44_hasWording."@it ;
    rdfs:isDefinedBy intro: ;
    rdfs:subClassOf intro:INT1_Passage .

crm:E29_Design_or_Procedure a owl:Class ;
    rdfs:label "E29 Design or Procedure"@en,
        "E29 Progetto o Procedura"@it ;
    rdfs:comment "In DeSMòS, E29 Design or Procedure provides the procedural category under which desmos:LiteraryConstraint is modelled, as a procedure applied during the creation of an expression."@en,
        "In DeSMòS, E29 Design or Procedure fornisce la categoria procedurale entro cui è modellata desmos:LiteraryConstraint, intesa come procedura applicata durante la creazione di un'espressione."@it ;
    rdfs:isDefinedBy crm: ;
    rdfs:subClassOf crm:E73_Information_Object .

crm:E55_Type a owl:Class ;
    rdfs:label "E55 Type"@en,
        "E55 Tipo"@it ;
    rdfs:comment "In DeSMòS, E55 Type is used for two kinds of controlled types: the expressive forms of works (prose, poetry, visual poetry, visual art, music), assigned to expressions via P2 has type, and, through the INTRO subclass INT11 Type of Interrelation, intertextual relation types such as hypertextuality, assigned via R19 has type. The properties that can be used with this class are skos:exactMatch and skos:inScheme."@en,
        "In DeSMòS, E55 Type è utilizzata per due ordini di tipi controllati: le forme espressive delle opere (prosa, poesia, poesia visiva, arte visiva, musica), assegnate alle espressioni mediante P2 has type, e, attraverso la sottoclasse INTRO INT11 Type of Interrelation, i tipi di relazione intertestuale come l'ipertestualità, assegnati mediante R19 has type. Le proprietà che possono essere usate con questa classe sono skos:exactMatch e skos:inScheme."@it ;
    rdfs:isDefinedBy crm: ;
    rdfs:subClassOf crm:E28_Conceptual_Object .

:SemanticConstraint a owl:Class ;
    rdfs:label "Semantic constraint"@en,
        "Costrizione semantica"@it ;
    rdfs:comment "A constraint that operates primarily at the level of the signified. The properties that can be used with this class are desmos:constrainsSemanticUnit, desmos:constraintOrigin, desmos:involvesOperation, skos:inScheme and skos:related."@en,
        "Costrizione che interviene prioritariamente sul significato. Le proprietà che possono essere usate con questa classe sono desmos:constrainsSemanticUnit, desmos:constraintOrigin, desmos:involvesOperation, skos:inScheme e skos:related."@it ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :LiteraryConstraint ;
    owl:disjointWith :FormalConstraint .

intro:INT11_TypeOfInterrelation a owl:Class ;
    rdfs:label "INT11 Type of Interrelation"@en,
        "INT11 Tipo di interrelazione"@it ;
    rdfs:comment "In DeSMòS, INT11 Type of Interrelation is used as a general category for the types that qualify intertextual relations represented through INTRO."@en,
        "In DeSMòS, INT11 Type of Interrelation è utilizzata come categoria generale per i tipi che qualificano le relazioni intertestuali rappresentate attraverso INTRO."@it ;
    rdfs:isDefinedBy intro: ;
    rdfs:subClassOf crm:E55_Type .

lrmoo:F28_Expression_Creation a owl:Class ;
    rdfs:label "F28 Expression Creation"@en,
        "F28 Creazione dell'espressione"@it ;
    rdfs:comment "In DeSMòS, F28 Expression Creation is used to represent the compositional event that produces a textual expression and in which a literary constraint may be employed. The properties that can be used with this class are crm:P14_carried_out_by, dcterms:created, desmos:usedConstraint and lrmoo:R17_created."@en,
        "In DeSMòS, F28 Expression Creation è utilizzata per rappresentare l'evento compositivo che produce un'espressione testuale e nel quale può essere impiegata una costrizione letteraria. Le proprietà che possono essere usate con questa classe sono crm:P14_carried_out_by, dcterms:created, desmos:usedConstraint e lrmoo:R17_created."@it ;
    rdfs:isDefinedBy lrmoo: ;
    rdfs:subClassOf crm:E7_Activity .

:FormalConstraint a owl:Class ;
    rdfs:label "Formal constraint"@en,
        "Costrizione formale"@it ;
    rdfs:comment "A constraint that operates primarily at the level of the signifier. The properties that can be used with this class are desmos:constrainsFormalUnit, desmos:constraintOrigin, desmos:involvesOperation, skos:broader, skos:closeMatch, skos:inScheme, skos:narrower and skos:related."@en,
        "Costrizione che interviene prioritariamente sul significante. Le proprietà che possono essere usate con questa classe sono desmos:constrainsFormalUnit, desmos:constraintOrigin, desmos:involvesOperation, skos:broader, skos:closeMatch, skos:inScheme, skos:narrower e skos:related."@it ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :LiteraryConstraint ;
    owl:disjointWith :SemanticConstraint .

:TextualFeature a owl:Class ;
    rdfs:label "Textual feature"@en,
        "Caratteristica testuale"@it ;
    rdfs:comment "An observable feature of a textual expression that may indicate the presence of a literary constraint. In DeSMòS it is treated as intratextual evidence: a textual trace supporting the identification of a constraint, without implying necessity or sufficiency by itself. The properties that can be used with this class are crm:P3_has_note, desmos:isFeatureOf and desmos:revealsConstraint."@en,
        "Caratteristica osservabile di un'espressione testuale che può indicare la presenza di una costrizione letteraria. In DeSMòS è intesa come evidenza intratestuale: una traccia testuale che supporta l’identificazione della costrizione, senza implicare di per sé sufficienza o necessità. Le proprietà che possono essere usate con questa classe sono crm:P3_has_note, desmos:isFeatureOf e desmos:revealsConstraint."@it ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf crm:E28_Conceptual_Object .

intro:INT2_ActualizationOfFeature a owl:Class ;
    rdfs:label "INT2 Actualization of Feature"@en,
        "INT2 Attualizzazione di caratteristica"@it ;
    rdfs:comment "In DeSMòS, INT2 Actualization of Feature is referenced only as a member of the original union range of R12 has referred to entity and R13 has referring entity, and of the union domain of their inverses; it is not instantiated in the DeSMòS corpus."@en,
        "In DeSMòS, INT2 Actualization of Feature è referenziata solo come membro dell'unione che costituisce il range originale di R12 has referred to entity e R13 has referring entity, e il domain delle loro inverse; non è istanziata nel corpus DeSMòS."@it ;
    rdfs:isDefinedBy intro: ;
    rdfs:subClassOf crm:E28_Conceptual_Object .

intro:INT6_Architext a owl:Class ;
    rdfs:label "INT6 Architext"@en,
        "INT6 Architesto"@it ;
    rdfs:comment "In DeSMòS, INT6 Architext is referenced only as a member of the original union range of R12 has referred to entity and R13 has referring entity, and of the union domain of their inverses; it is not instantiated in the DeSMòS corpus."@en,
        "In DeSMòS, INT6 Architext è referenziata solo come membro dell'unione che costituisce il range originale di R12 has referred to entity e R13 has referring entity, e il domain delle loro inverse; non è istanziata nel corpus DeSMòS."@it ;
    rdfs:isDefinedBy intro: ;
    rdfs:subClassOf crm:E28_Conceptual_Object .

crm:E70_Thing a owl:Class ;
    rdfs:label "E70 Thing"@en,
        "E70 Cosa"@it ;
    rdfs:comment "In DeSMòS, E70 Thing is referenced as the original domain and range of P130 shows features of. E28 Conceptual Object is declared as its direct subclass, abbreviating the official chain E28 Conceptual Object ⊑ E71 Human-Made Thing ⊑ E70 Thing (CIDOC CRM 7.1.3)."@en,
        "In DeSMòS, E70 Thing è referenziata come domain e range originali di P130 shows features of. E28 Conceptual Object ne è dichiarata sottoclasse diretta, abbreviando la catena ufficiale E28 Conceptual Object ⊑ E71 Human-Made Thing ⊑ E70 Thing (CIDOC CRM 7.1.3)."@it ;
    rdfs:isDefinedBy crm: ;
    rdfs:subClassOf crm:E1_CRM_Entity .

crm:E7_Activity a owl:Class ;
    rdfs:label "E7 Activity"@en,
        "E7 Attività"@it ;
    rdfs:comment "In DeSMòS, E7 Activity is referenced as the original domain of P14 carried out by and P33 used specific technique. lrmoo:F28_Expression_Creation is declared as its direct subclass, abbreviating the official chain F28 Expression Creation ⊑ E65 Creation ⊑ E7 Activity (LRMoo 1.0; CIDOC CRM 7.1.3)."@en,
        "In DeSMòS, E7 Activity è referenziata come domain originale di P14 carried out by e P33 used specific technique. lrmoo:F28_Expression_Creation ne è dichiarata sottoclasse diretta, abbreviando la catena ufficiale F28 Expression Creation ⊑ E65 Creation ⊑ E7 Activity (LRMoo 1.0; CIDOC CRM 7.1.3)."@it ;
    rdfs:isDefinedBy crm: ;
    rdfs:subClassOf crm:E1_CRM_Entity .

crm:E90_Symbolic_Object a owl:Class ;
    rdfs:label "E90 Symbolic Object"@en,
        "E90 Oggetto Simbolico"@it ;
    rdfs:comment "In DeSMòS, E90 Symbolic Object is referenced as the original range of R15 has fragment: the peritextual statements (E33 Linguistic Object) linked to an expression through R15 are symbolic objects via E73 Information Object. It is the superclass of E73 Information Object and, in INTRO, of INT1 Passage and INT16 Segment."@en,
        "In DeSMòS, E90 Symbolic Object è referenziata come range originale di R15 has fragment: le dichiarazioni peritestuali (E33 Linguistic Object) collegate a un'espressione mediante R15 sono oggetti simbolici attraverso E73 Information Object. È superclasse di E73 Information Object e, in INTRO, di INT1 Passage e INT16 Segment."@it ;
    rdfs:isDefinedBy crm: ;
    rdfs:subClassOf crm:E28_Conceptual_Object .

lrmoo:F1_Work a owl:Class ;
    rdfs:label "F1 Work"@en,
        "F1 Opera"@it ;
    rdfs:comment "In DeSMòS, F1 Work is used to represent the work as an abstract entity, distinct from the textual expressions through which it is realised. The property that can be used with this class is lrmoo:R3_is_realised_in."@en,
        "In DeSMòS, F1 Work è utilizzata per rappresentare l'opera come entità astratta, distinta dalle espressioni testuali attraverso cui essa viene realizzata. La proprietà che può essere usata con questa classe è lrmoo:R3_is_realised_in."@it ;
    rdfs:isDefinedBy lrmoo: ;
    rdfs:subClassOf crm:E89_Propositional_Object .

crm:E28_Conceptual_Object a owl:Class ;
    rdfs:label "E28 Conceptual Object"@en,
        "E28 Oggetto Concettuale"@it ;
    rdfs:comment "In DeSMòS, E28 Conceptual Object is the common superclass of the non-material entities in the model: through E89 Propositional Object and E90 Symbolic Object it subsumes information objects (works, expressions, linguistic objects, passages); it is also the direct superclass of E55 Type, desmos:TextualFeature and intro:INT3_Interrelation (the reified intertextual relations), as well as of intro:INT2_ActualizationOfFeature and intro:INT6_Architext, which are referenced only in the original ranges of R12 and R13."@en,
        "In DeSMòS, E28 Conceptual Object è la superclasse comune delle entità non materiali del modello: attraverso E89 Propositional Object ed E90 Symbolic Object comprende gli oggetti informativi (opere, espressioni, oggetti linguistici, passaggi); è inoltre superclasse diretta di E55 Type, desmos:TextualFeature e intro:INT3_Interrelation (le relazioni intertestuali reificate), nonché di intro:INT2_ActualizationOfFeature e intro:INT6_Architext, referenziate solo nei range originali di R12 e R13."@it ;
    rdfs:isDefinedBy crm: ;
    rdfs:subClassOf crm:E70_Thing .

intro:INT3_Interrelation a owl:Class ;
    rdfs:label "INT3 Interrelation"@en,
        "INT3 Interrelazione"@it ;
    rdfs:comment "In DeSMòS, INT3 Interrelation provides the general category for the reified representation of relations between entities, specialised through INT31 Intertextual Relation for the intertextual relations considered in the model."@en,
        "In DeSMòS, INT3 Interrelation fornisce la categoria generale per la rappresentazione reificata delle relazioni tra entità, specializzata attraverso INT31 Intertextual Relation per le relazioni intertestuali considerate nel modello."@it ;
    rdfs:isDefinedBy intro: ;
    rdfs:subClassOf crm:E28_Conceptual_Object .

intro:INT1_Passage a owl:Class ;
    rdfs:label "INT1 Passage"@en,
        "INT1 Passaggio"@it ;
    rdfs:comment "In DeSMòS, INT1 Passage provides the general category for intro:INT21_TextPassage, used to represent textual passages involved in intertextual relations."@en,
        "In DeSMòS, INT1 Passage fornisce la categoria generale per intro:INT21_TextPassage, utilizzata per rappresentare i passaggi testuali coinvolti nelle relazioni intertestuali."@it ;
    rdfs:isDefinedBy intro: ;
    rdfs:subClassOf crm:E90_Symbolic_Object .

crm:E1_CRM_Entity a owl:Class ;
    rdfs:label "E1 CRM Entity"@en,
        "E1 Entità CRM"@it ;
    rdfs:comment "In DeSMòS, E1 CRM Entity is the root of the CIDOC CRM hierarchy and is referenced as the original domain or range of P2 has type, P3 has note, P67 refers to and P129 is about. E7 Activity, E39 Actor and E70 Thing are declared as its direct subclasses, abbreviating the official chains through E5 Event and E77 Persistent Item."@en,
        "In DeSMòS, E1 CRM Entity è la radice della gerarchia di CIDOC CRM ed è referenziata come domain o range originale di P2 has type, P3 has note, P67 refers to e P129 is about. E7 Activity, E39 Actor ed E70 Thing ne sono dichiarate sottoclassi dirette, abbreviando le catene ufficiali che passano per E5 Event ed E77 Persistent Item."@it ;
    rdfs:isDefinedBy crm: .

crm:E73_Information_Object a owl:Class ;
    rdfs:label "E73 Information Object"@en,
        "E73 Oggetto Informativo"@it ;
    rdfs:comment "In DeSMòS, E73 Information Object is used as a general category for information objects involved in the representation of texts and their associated procedures, through specialised classes reused from CIDOC CRM, LRMoo, and INTRO."@en,
        "In DeSMòS, E73 Information Object è utilizzata come categoria generale per gli oggetti informativi coinvolti nella rappresentazione del testo e delle procedure ad esso associate, attraverso le classi specializzate riprese da CIDOC CRM, LRMoo e INTRO."@it ;
    rdfs:isDefinedBy crm: ;
    rdfs:subClassOf crm:E89_Propositional_Object,
        crm:E90_Symbolic_Object .

crm:E89_Propositional_Object a owl:Class ;
    rdfs:label "E89 Propositional Object"@en,
        "E89 Oggetto Proposizionale"@it ;
    rdfs:comment "This class comprises entities that exist as sets of characteristics or properties rather than as physical objects. In DeSMòS, it represents abstract entities such as works and, through E73 Information Object, expressions, declarations and literary constraints. Intertextual relations (intro:INT3_Interrelation) are not included, being a direct subclass of E28 Conceptual Object."@en,
        "Questa classe comprende entità che esistono come insiemi di caratteristiche o proprietà, piuttosto che come oggetti fisici. In DeSMòS, rappresenta le entità astratte come le opere e, attraverso E73 Information Object, le espressioni, le dichiarazioni e le costrizioni letterarie. Le relazioni intertestuali (intro:INT3_Interrelation) non ne fanno parte, essendo sottoclasse diretta di E28 Conceptual Object."@it ;
    rdfs:isDefinedBy crm: ;
    rdfs:subClassOf crm:E28_Conceptual_Object .

:LiteraryConstraint a owl:Class ;
    rdfs:label "Literary constraint"@en,
        "Costrizione letteraria"@it ;
    rdfs:comment "A formal or semantic procedure intervening in the process of textual generation (F28 Expression Creation). Its presence may be documented through objective evidence (TextualFeature) or paratextual statements (E33 Linguistic Object)."@en,
        "Procedura formale o semantica che interviene nel processo di generazione testuale (F28 Expression Creation). La sua presenza può essere documentata attraverso evidenze oggettive (TextualFeature) o dichiarazioni paratestuali (E33 Linguistic Object)."@it ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf crm:E29_Design_or_Procedure,
        skos:Concept .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept Scheme"@en,
        "Schema di concetti"@it ;
    rdfs:comment "In DeSMòS, skos:ConceptScheme is used to organise literary constraints and the analytical categories used to describe them into controlled vocabularies. The property that can be used with this class is skos:hasTopConcept."@en,
        "In DeSMòS, skos:ConceptScheme è utilizzata per organizzare in vocabolari controllati le costrizioni letterarie e le categorie analitiche impiegate per descriverle. La proprietà che può essere usata con questa classe è skos:hasTopConcept."@it ;
    rdfs:isDefinedBy skos: .

lrmoo:F2_Expression a owl:Class ;
    rdfs:label "F2 Expression"@en,
        "F2 Espressione"@it ;
    rdfs:comment "In DeSMòS, F2 Expression is used to represent the textual realisation of a work, on which literary constraints and relations to other texts are documented. The properties that can be used with this class are crm:P130_shows_features_of, crm:P148_has_component, crm:P2_has_type, lrmoo:R15_has_fragment, lrmoo:R4i_is_embodied_in and lrmoo:R76_is_derivative_of."@en,
        "In DeSMòS, F2 Expression è utilizzata per rappresentare la realizzazione testuale di un'opera, sulla quale vengono documentate le costrizioni letterarie e le relazioni con altri testi. Le proprietà che possono essere usate con questa classe sono crm:P130_shows_features_of, crm:P148_has_component, crm:P2_has_type, lrmoo:R15_has_fragment, lrmoo:R4i_is_embodied_in e lrmoo:R76_is_derivative_of."@it ;
    rdfs:isDefinedBy lrmoo: ;
    rdfs:subClassOf crm:E73_Information_Object .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en,
        "Concetto"@it ;
    rdfs:comment "In DeSMòS, the class is used to define individual literary constraints and analytical categories within an organized knowledge system. The properties that can be used with this class are desmos:coarserThan, desmos:constrainsFormalUnit, desmos:constrainsSemanticUnit, desmos:constraintOrigin, desmos:finerThan, desmos:involvesOperation, skos:broader, skos:closeMatch, skos:exactMatch, skos:inScheme, skos:narrower and skos:related."@en,
        "In DeSMòS, la classe viene utilizzata per definire le singole costrizioni letterarie e le categorie analitiche all'interno di un sistema di conoscenza organizzato. Le proprietà che possono essere usate con questa classe sono desmos:coarserThan, desmos:constrainsFormalUnit, desmos:constrainsSemanticUnit, desmos:constraintOrigin, desmos:finerThan, desmos:involvesOperation, skos:broader, skos:closeMatch, skos:exactMatch, skos:inScheme, skos:narrower e skos:related."@it ;
    rdfs:isDefinedBy skos: .

: a owl:Ontology ;
    rdfs:label "DeSMòS"@en,
        "DeSMòS"@it ;
    dcterms:bibliographicCitation "Bruno, Enrica. (2026). DeSMòS: Descriptive Semantic Model for Structured Texts (Version 1.2.0) [Ontology]." ;
    dcterms:creator <https://orcid.org/0009-0007-5620-3834> ;
    dcterms:description "DeSMòS (Descriptive Semantic Model for Structured Texts) is an OWL 2 ontology for the formal representation of literary constraints as text-generative procedures, with particular reference to the Oulipian tradition. The model treats constraints as conceptual entities distinct from works and their bibliographic realisations, represented through LRMoo, and describes their use in expression creation events, distinguishing the procedure from both the creative process and the resulting text. Constrained rewriting is represented through derivation and intertextual relations between expressions, allowing the identification of the textual passages involved. The typological characterisation distinguishes formal and semantic constraints, with a specific category for visual constraints, and describes the constrained units, procedural operations, and origins through SKOS controlled vocabularies. The model also supports the documentation of constraint use through intratextual evidence and paratextual statements, whether peritextual or epitextual, distinguishing responsibility for such statements from responsibility for textual creation. Through the reuse of and alignment with CIDOC CRM, LRMoo, PROV-O, SKOS, INTRO, Dublin Core Terms, and Schema.org, DeSMòS supports the description, comparative analysis, and SPARQL querying of constrained writing practices across heterogeneous corpora."@en,
        "DeSMòS (Descriptive Semantic Model for Structured Texts) è un'ontologia OWL 2 per la rappresentazione formale delle costrizioni letterarie come procedure generative del testo, con particolare riferimento alla tradizione oulipiana. Il modello riconosce alla costrizione un'autonomia concettuale rispetto all'opera e alle sue realizzazioni bibliografiche, rappresentate mediante LRMoo, e ne descrive l'impiego nell'evento di creazione dell'espressione, distinguendo la procedura dal processo compositivo e dal testo prodotto. La riscrittura vincolata è rappresentata attraverso le relazioni di derivazione e i rapporti intertestuali tra espressioni, con la possibilità di identificare i passaggi testuali coinvolti. La caratterizzazione tipologica distingue costrizioni formali e semantiche, con una specificazione delle costrizioni visive, e ne descrive le unità vincolate, le operazioni procedurali e l'origine mediante vocabolari controllati SKOS. Il modello consente inoltre di documentare l'impiego delle costrizioni attraverso evidenze intratestuali e dichiarazioni paratestuali, peritestuali o epitestuali, distinguendo la responsabilità delle dichiarazioni da quella della creazione testuale. Attraverso il riuso e l'allineamento con CIDOC CRM, LRMoo, PROV-O, SKOS, INTRO, Dublin Core Terms e Schema.org, DeSMòS supporta la descrizione, l'analisi comparativa e l'interrogazione SPARQL delle pratiche di scrittura vincolata in corpora eterogenei."@it ;
    dcterms:hasVersion "1.2.0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-22"^^xsd:date ;
    dcterms:source lrmoo:,
        dcterms:,
        schema1:,
        crm:,
        skos:,
        prov:,
        intro: ;
    dcterms:title "DeSMòS (Descriptive Semantic Model for Structured Texts)"@en,
        "DeSMòS (Descriptive Semantic Model for Structured Texts)"@it ;
    vann:preferredNamespacePrefix "desmos" ;
    vann:preferredNamespaceUri "https://w3id.org/desmos/" ;
    rdfs:comment "DeSMòS adopts an \"alignment-by-reference\" pattern to keep the ontology lightweight and reasoner-friendly."@en,
        "DeSMòS adotta un pattern di \"allineamento per riferimento\" per mantenere l'ontologia leggera e compatibile con i reasoner."@it ;
    owl:priorVersion <https://zenodo.org/records/19610250/files/desmos.owl> ;
    owl:versionIRI :v1.2.0 ;
    owl:versionInfo "Version 1.2.0"@en,
        "Versione 1.2.0"@it .

