@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

crm:E73_Information_Object a owl:Class ;
    rdfs:label "E73 Information Object"@en,
        "E73 Oggetto Informativo"@it ;
    rdfs:comment "In DeSMòS, E73 Information Object is used as a general category for information objects involved in the representation of texts and their associated procedures, through specialised classes reused from CIDOC CRM, LRMoo, and INTRO."@en,
        "In DeSMòS, E73 Information Object è utilizzata come categoria generale per gli oggetti informativi coinvolti nella rappresentazione del testo e delle procedure ad esso associate, attraverso le classi specializzate riprese da CIDOC CRM, LRMoo e INTRO."@it ;
    rdfs:isDefinedBy crm: ;
    rdfs:subClassOf crm:E89_Propositional_Object,
        crm:E90_Symbolic_Object .

