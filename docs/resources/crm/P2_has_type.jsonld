        "@id": "http://www.cidoc-crm.org/cidoc-crm/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "P2 has type"
      },
      {
        "@language": "it",
        "@value": "P2 ha tipo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
