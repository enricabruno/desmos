@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

crm:P67_refers_to a owl:ObjectProperty ;
    rdfs:label "P67 refers to"@en,
        "P67 si riferisce a"@it ;
    rdfs:comment "In DeSMòS, it relates a declaration (linguistic object) to the textual expression it refers to. The original property has domain crm:E89_Propositional_Object and range crm:E1_CRM_Entity. In DeSMòS, the same property has domain crm:E33_Linguistic_Object and range lrmoo:F2_Expression."@en,
        "In DeSMòS collega una dichiarazione (oggetto linguistico) all'espressione testuale a cui fa riferimento. La proprietà originale ha come domain crm:E89_Propositional_Object e come range crm:E1_CRM_Entity. In DeSMòS la stessa proprietà ha come domain crm:E33_Linguistic_Object e come range lrmoo:F2_Expression."@it ;
    rdfs:domain crm:E89_Propositional_Object ;
    rdfs:isDefinedBy crm: ;
    rdfs:range crm:E1_CRM_Entity ;
    owl:inverseOf crm:P67i_is_referred_to_by .

