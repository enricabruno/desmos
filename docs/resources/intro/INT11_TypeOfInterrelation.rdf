  <rdf:Description rdf:about="https://w3id.org/lso/intro/beta202506#INT11_TypeOfInterrelation">
    <rdfs:label xml:lang="it">INT11 Tipo di interrelazione</rdfs:label>
    <rdfs:label xml:lang="en">INT11 Type of Interrelation</rdfs:label>
    <rdfs:comment xml:lang="it">In DeSMòS, INT11 Type of Interrelation è utilizzata come categoria generale per i tipi che qualificano le relazioni intertestuali rappresentate attraverso INTRO.</rdfs:comment>
    <rdfs:comment xml:lang="en">In DeSMòS, INT11 Type of Interrelation is used as a general category for the types that qualify intertextual relations represented through INTRO.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/lso/intro/beta202506#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
  </rdf:Description>
</rdf:RDF>
