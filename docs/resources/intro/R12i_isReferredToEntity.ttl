@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix intro: <https://w3id.org/lso/intro/beta202506#> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

intro:R12i_isReferredToEntity a owl:ObjectProperty ;
    rdfs:label "R12i is referred to entity of"@en,
        "R12i è entità a cui si riferisce di"@it ;
    rdfs:comment "Inverse of R12 has referred to entity: in DeSMòS, it relates a hypotextual entity (expression or passage) to the intertextual relation in which it is the entity referred to. The original property has domain the union of lrmoo:F1_Work, crm:E73_Information_Object, intro:INT1_Passage, intro:INT2_ActualizationOfFeature and intro:INT6_Architext and range intro:INT3_Interrelation. In DeSMòS, the same property has domain lrmoo:F2_Expression or intro:INT21_TextPassage and range intro:INT31_IntertextualRelation."@en,
        "Inversa di R12 has referred to entity: in DeSMòS collega un'entità ipotestuale (espressione o passaggio) alla relazione intertestuale in cui è l'entità a cui si fa riferimento. La proprietà originale ha come domain l'unione di lrmoo:F1_Work, crm:E73_Information_Object, intro:INT1_Passage, intro:INT2_ActualizationOfFeature e intro:INT6_Architext e come range intro:INT3_Interrelation. In DeSMòS la stessa proprietà ha come domain lrmoo:F2_Expression o intro:INT21_TextPassage e come range intro:INT31_IntertextualRelation."@it ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( lrmoo:F1_Work crm:E73_Information_Object intro:INT1_Passage intro:INT2_ActualizationOfFeature intro:INT6_Architext ) ] ;
    rdfs:isDefinedBy intro: ;
    rdfs:range intro:INT3_Interrelation .

