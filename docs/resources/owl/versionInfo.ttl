@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

owl:versionInfo a owl:AnnotationProperty ;
    rdfs:label "version info"@en,
        "informazioni sulla versione"@it ;
    rdfs:comment "A string identifying the version of this ontology."@en,
        "Una stringa che identifica la versione di questa ontologia."@it ;
    rdfs:isDefinedBy owl: .

