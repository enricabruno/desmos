@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

dcterms:bibliographicCitation a owl:AnnotationProperty ;
    rdfs:label "bibliographic citation"@en,
        "citazione bibliografica"@it ;
    rdfs:comment "A bibliographic reference for the resource."@en,
        "Il riferimento bibliografico con cui citare la risorsa."@it ;
    rdfs:isDefinedBy dcterms: .

