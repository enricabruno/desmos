@prefix : <https://w3id.org/desmos/> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:hasFeature a owl:ObjectProperty ;
    rdfs:label "has feature"@en,
        "ha caratteristica"@it ;
    rdfs:comment "This property relates a textual expression to an observable textual feature of a constraint. The property has domain lrmoo:F2_Expression and range desmos:TextualFeature."@en,
        "Questa proprietà collega un'espressione testuale all'evidenza testuale osservabile di una costrizione. La proprietà ha come domain lrmoo:F2_Expression e come range desmos:TextualFeature."@it ;
    rdfs:domain lrmoo:F2_Expression ;
    rdfs:isDefinedBy : ;
    rdfs:range :TextualFeature .

