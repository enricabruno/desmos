@prefix : <https://w3id.org/desmos/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

:finerThan a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has finer granularity than"@en,
        "ha granularità più fine di"@it ;
    rdfs:comment "Relates a formal unit to a formal unit of coarser textual granularity (e.g., a letter with respect to a syllable or a word), exclusively within the FormalUnitScheme. The property has domain skos:Concept and range skos:Concept."@en,
        "Collega un'unità formale a un'unità formale di granularità testuale più ampia (es. la lettera rispetto a sillaba e parola), esclusivamente entro il FormalUnitScheme. La proprietà ha come domain skos:Concept e come range skos:Concept."@it ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy : ;
    rdfs:range skos:Concept ;
    owl:inverseOf :coarserThan .

