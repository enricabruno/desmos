<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/desmos/isSemanticUnitConstrainedBy">
    <rdfs:comment xml:lang="en">Inverse of constrainsSemanticUnit: relates a unit of the content plane to the semantic constraints that determine it. The property has domain skos:Concept and range desmos:SemanticConstraint.</rdfs:comment>
    <rdfs:comment xml:lang="it">Inversa di constrainsSemanticUnit: collega un'unità del piano del contenuto alle costrizioni semantiche che la determinano. La proprietà ha come domain skos:Concept e come range desmos:SemanticConstraint.</rdfs:comment>
    <rdfs:label xml:lang="en">is semantic unit constrained by</rdfs:label>
    <rdfs:label xml:lang="it">è unità semantica vincolata da</rdfs:label>
    <owl:inverseOf rdf:resource="https://w3id.org/desmos/constrainsSemanticUnit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/desmos/SemanticConstraint"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/desmos/"/>
  </rdf:Description>
</rdf:RDF>
