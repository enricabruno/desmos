<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/desmos/isConstraintUsedIn">
    <owl:inverseOf rdf:resource="https://w3id.org/desmos/usedConstraint"/>
    <rdfs:comment xml:lang="en">This property relates a literary constraint to the expression creation events in which it was employed as a generative device; subproperty of crm:P33i_was_used_by. The property has domain desmos:LiteraryConstraint and range lrmoo:F28_Expression_Creation.</rdfs:comment>
    <rdfs:comment xml:lang="it">Questa proprietà collega una costrizione letteraria agli eventi di creazione dell'espressione in cui è stata impiegata come dispositivo generativo; sottoproprietà di crm:P33i_was_used_by. La proprietà ha come domain desmos:LiteraryConstraint e come range lrmoo:F28_Expression_Creation.</rdfs:comment>
    <rdfs:label xml:lang="en">is constraint used in</rdfs:label>
    <rdfs:label xml:lang="it">è costrizione usata in</rdfs:label>
    <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
    <rdfs:domain rdf:resource="https://w3id.org/desmos/LiteraryConstraint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P33i_was_used_by"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/desmos/"/>
  </rdf:Description>
</rdf:RDF>
