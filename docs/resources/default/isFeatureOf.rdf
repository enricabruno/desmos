<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/desmos/isFeatureOf">
    <rdfs:label xml:lang="en">is feature of</rdfs:label>
    <rdfs:label xml:lang="it">è caratteristica di</rdfs:label>
    <owl:inverseOf rdf:resource="https://w3id.org/desmos/hasFeature"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Inverse of hasFeature: relates a textual feature of a constraint to the expression in which it is manifest. The property has domain desmos:TextualFeature and range lrmoo:F2_Expression.</rdfs:comment>
    <rdfs:comment xml:lang="it">Inversa di hasFeature: collega un'evidenza testuale della costrizione all'espressione in cui è manifesta. La proprietà ha come domain desmos:TextualFeature e come range lrmoo:F2_Expression.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/desmos/TextualFeature"/>
    <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/desmos/"/>
  </rdf:Description>
</rdf:RDF>
