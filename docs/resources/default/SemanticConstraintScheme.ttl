@prefix : <https://w3id.org/desmos/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

:SemanticConstraintScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Semantic Constraint Scheme"@en,
        "Schema delle costrizioni semantiche"@it ;
    rdfs:comment "Concept scheme collecting semantic constraints, which intervene primarily on the signified of the text."@en,
        "Schema concettuale che raccoglie le costrizioni semantiche, che intervengono prioritariamente sul significato del testo."@it ;
    rdfs:isDefinedBy : .

