        "@id": "https://w3id.org/desmos/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "it",
        "@value": "è l'operazione coinvolta in"
      },
      {
        "@language": "en",
        "@value": "is operation involved in"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
