        "@id": "https://w3id.org/desmos/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "is feature of"
      },
      {
        "@language": "it",
        "@value": "è caratteristica di"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
