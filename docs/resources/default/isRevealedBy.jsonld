      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "is revealed by"
      },
      {
        "@language": "it",
        "@value": "è rivelata da"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/desmos/TextualFeature"
      }
    ],
