@prefix : <https://w3id.org/desmos/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:SemanticConstraint a owl:Class ;
    rdfs:label "Semantic constraint"@en,
        "Costrizione semantica"@it ;
    rdfs:comment "A constraint that operates primarily at the level of the signified. The properties that can be used with this class are desmos:constrainsSemanticUnit, desmos:constraintOrigin, desmos:involvesOperation, skos:inScheme and skos:related."@en,
        "Costrizione che interviene prioritariamente sul significato. Le proprietà che possono essere usate con questa classe sono desmos:constrainsSemanticUnit, desmos:constraintOrigin, desmos:involvesOperation, skos:inScheme e skos:related."@it ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf :LiteraryConstraint ;
    owl:disjointWith :FormalConstraint .

