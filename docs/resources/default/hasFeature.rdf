<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/desmos/hasFeature">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/desmos/"/>
    <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
    <rdfs:label xml:lang="it">ha caratteristica</rdfs:label>
    <rdfs:label xml:lang="en">has feature</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/desmos/TextualFeature"/>
    <rdfs:comment xml:lang="en">This property relates a textual expression to an observable textual feature of a constraint. The property has domain lrmoo:F2_Expression and range desmos:TextualFeature.</rdfs:comment>
    <rdfs:comment xml:lang="it">Questa proprietà collega un'espressione testuale all'evidenza testuale osservabile di una costrizione. La proprietà ha come domain lrmoo:F2_Expression e come range desmos:TextualFeature.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
</rdf:RDF>
