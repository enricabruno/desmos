@prefix : <https://w3id.org/desmos/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

:LiteraryConstraint a owl:Class ;
    rdfs:label "Literary constraint"@en,
        "Costrizione letteraria"@it ;
    rdfs:comment "A formal or semantic procedure intervening in the process of textual generation (F28 Expression Creation). Its presence may be documented through objective evidence (TextualFeature) or paratextual statements (E33 Linguistic Object)."@en,
        "Procedura formale o semantica che interviene nel processo di generazione testuale (F28 Expression Creation). La sua presenza può essere documentata attraverso evidenze oggettive (TextualFeature) o dichiarazioni paratestuali (E33 Linguistic Object)."@it ;
    rdfs:isDefinedBy : ;
    rdfs:subClassOf crm:E29_Design_or_Procedure,
        skos:Concept .

