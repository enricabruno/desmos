        "@id": "https://w3id.org/desmos/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "is formal unit constrained by"
      },
      {
        "@language": "it",
        "@value": "è unità formale vincolata da"
      }
    ],
