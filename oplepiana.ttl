### Constraint ###
<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_01> a desmos:LiteraryConstraint ;
	rdfs:label "Heterogram"@en ;
	rdfs:label "Eterogramma"@it ;
	rdfs:comment "Constraint requiring a word or letter string in which no letter is repeated (each grapheme occurs at most once)."@en ;
	rdfs:comment "Costrizione che impone la scrittura di una parola o stringa in cui nessuna lettera si ripete (ogni grafema può comparire al massimo una volta)."@it ; desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_02> a desmos:LiteraryConstraint ;
	rdfs:label "Anagram"@en ;
	rdfs:label "Anagramma"@it ;
	rdfs:comment "Constraint based on the rearrangement of the letters of a word or expression to form another, while preserving the same set of characters."@en ; rdfs:comment "Costrizione che prevede la riorganizzazione delle lettere di una parola o espressione per formarne un’altra, mantenendo invariato l’insieme dei caratteri."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_03> a desmos:LiteraryConstraint ;
	rdfs:label "Regraphing"@en ;
	rdfs:label "Rigrafia"@it ;
	rdfs:comment "Constraint consisting in composing a derived text by reordering typographic lines taken from a source text, kept unchanged and used as combinatorial tiles."@en ;
	rdfs:comment "Costrizione che consiste nel comporre un testo derivato riordinando righe tipografiche tratte da un testo base, mantenute inalterate e usate come tessere combinatorie."@it ;
	desmos:constraintOrigin desmos:original ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_04> a desmos:LiteraryConstraint ;
	rdfs:label "Quatrain"@en ;
	rdfs:label "Quartina"@it ;
	rdfs:comment "Stanzaic constraint requiring the text to be organized into four-line stanzas, optionally following a predefined metrical/rhyme scheme."@en ;
	rdfs:comment "Costrizione strofica che impone l’organizzazione del testo in strofe di quattro versi, eventualmente secondo uno schema metrico-rimico prefissato."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_05> a desmos:LiteraryConstraint ;
	rdfs:label "Alternating rhyme"@en ;
	rdfs:label "Rima alternata"@it ;
	rdfs:comment "Rhyme constraint requiring an alternating rhyme pattern (typically ABAB) across adjacent lines within a stanza or section."@en ;
	rdfs:comment "Costrizione rimica che impone un andamento alternato delle rime (tipicamente schema ABAB) tra versi contigui di una strofa o sezione."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_06> a desmos:LiteraryConstraint ;
	rdfs:label "Mythographic units"@en ;
	rdfs:label "Mitografemi"@it ;
	rdfs:comment "Constraint that turns a sequence of mythological names into a poem through caesuras and punctuation: the names function as graphic units (graphemes)."@en ;
	rdfs:comment "Costrizione che trasforma una sequenza di nomi mitologici in componimento attraverso cesure e punteggiatura: i nomi funzionano come unità grafiche (grafemi)."@it ;
	desmos:constraintOrigin desmos:original ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_07> a desmos:LiteraryConstraint ;
	rdfs:label "Hendecasyllable"@en ;
	rdfs:label "Endecasillabo"@it ;
	rdfs:comment "Metrical constraint that requires the use of verses composed of eleven syllables."@en ;
	rdfs:comment "Costrizione metrica che impone l’uso di versi composti da undici sillabe."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_08> a desmos:LiteraryConstraint ;
	rdfs:label "Terzine"@en ;
	rdfs:label "Terzina"@it ;
	rdfs:comment "Stanzaic constraint requiring the text to be organized into three-line stanzas, optionally following a predefined metrical/rhyme scheme."@en ;
	rdfs:comment "Costrizione strofica che impone l’organizzazione del testo in strofe di tre versi, eventualmente secondo uno schema metrico-rimico determinato."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_09> a desmos:LiteraryConstraint ;
	rdfs:label "Palindrome"@en ;
	rdfs:label "Palindromo"@it ;
	rdfs:comment "Constraint requiring a linguistic sequence (word/sentence/text) to be identical when read forward and backward."@en ;
	rdfs:comment "Costrizione che richiede la costruzione di una sequenza linguistica (parola/frase/testo) che risulti identica se letta da sinistra a destra e viceversa."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_10> a desmos:LiteraryConstraint ;
	rdfs:label "Cento"@en ;
	rdfs:label "Centone"@it ;
	rdfs:comment "Constraint consisting in composing a text by stitching together pre-existing lines or fragments from one or more sources/authors, with minimal alteration."@en ;
	rdfs:comment "Costrizione che consiste nel comporre un testo assemblando versi o frammenti preesistenti tratti da uno o più testi/autori, con interventi minimi."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_11> a desmos:LiteraryConstraint ;
	rdfs:label "Fixed rhyme"@en ;
	rdfs:label "Rima fissa"@it ;
	rdfs:comment "Rhyme constraint that fixes a predefined set of rhymes (ending sounds or rhyme-words) and their required placement/recurrence throughout the text."@en ;
	rdfs:comment "Costrizione rimica che impone un insieme prefissato di rime (suoni finali o parole-rima) e la loro ricorrenza in posizioni determinate lungo il testo."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_12> a desmos:LiteraryConstraint ;
	rdfs:label "Homographic translation"@en ;
	rdfs:label "Traduzione omografica"@it ;
	rdfs:comment "Bilingual constraint that produces two texts, each in a different language, from the same written sequence: the same letter string is segmented differently (word breaks/punctuation), yielding two autonomous linguistic readings."@en ;
	rdfs:comment "Costrizione bilingue che produce due testi, ciascuno in una lingua diversa, a partire da una medesima sequenza grafica: la stessa stringa di lettere viene segmentata in modi differenti (spaziatura/punteggiatura), generando due letture linguistiche autonome."@it ;
	desmos:constraintOrigin desmos:original ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_13> a desmos:LiteraryConstraint ;
    rdfs:label "Alfabeto raffigurato"@it ;
    rdfs:label "Figured Alphabet"@en ;
    rdfs:comment "Costrizione grafico-visiva che consiste nel comporre un testo all'interno di una griglia letteraria intesa come spazio geometrico delimitato, dove la disposizione delle lettere è finalizzata a riprodurre visivamente il disegno della lettera stessa."@it ;
    rdfs:comment "A graphic-visual constraint consisting of the composition of a text within a literary grid, understood as a defined geometric space, where the arrangement of letters is designed to visually reproduce the shape of the letter itself, effectively turning the script into a figurative geometry."@en ;
    desmos:constraintOrigin desmos:original ;
    desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_14> a desmos:LiteraryConstraint ;
	rdfs:label "Fixed text length constraint"@en ;
	rdfs:label "Lunghezza del testo fissa"@it ;
	rdfs:comment "Constraint requiring an exact predetermined text length, measured under an explicit criterion (e.g., number of characters including spaces)."@en ;
	rdfs:comment "Costrizione che impone una lunghezza esatta predeterminata del testo, misurata secondo un criterio esplicito (es. numero di caratteri, spazi inclusi)."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_15> a desmos:LiteraryConstraint ;
	rdfs:label "Typographic constraints"@en ;
	rdfs:label "Norme tipografiche"@it ;
	rdfs:comment "Constraint requiring adherence to typographic and editorial conventions defined by a reference model (e.g., house style: quotation marks, italics, paragraphing, etc.)."@en ;
	rdfs:comment "Costrizione che impone l’adozione di convenzioni tipografiche e redazionali definite da un modello di riferimento (es. norme editoriali: uso di virgolette, corsivi, capoversi, ecc.)."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_16> a desmos:LiteraryConstraint ;
	rdfs:label "Constraint on narrative characters"@en ;
	rdfs:label "Costrizione sui personaggi narrativi"@it ;
	rdfs:comment "Constraint fixing a predefined set of characters (number, names and/or roles) and possibly requiring mandatory attributes by which they must be characterized in the text."@en ;
	rdfs:comment "Costrizione che impone un insieme prefissato di personaggi (numero, nomi e/o ruoli) e può prescrivere attributi obbligatori con cui devono essere caratterizzati nel testo."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:semantic .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_17> a desmos:LiteraryConstraint ;
	rdfs:label "Fixed narrative setting"@en ;
	rdfs:label "Ambientazione fissa"@it ;
	rdfs:comment "Constraint requiring the narrative setting."@en ;
	rdfs:comment "Costrizione che rende obbligata l’ambientazione narrativa."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:semantic .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_18> a desmos:LiteraryConstraint ;
	rdfs:label "Mandatory sentence inclusion constraint"@en ;
	rdfs:label "Inclusione obbligatoria di una frase"@it ;
	rdfs:comment "Constraint requiring the verbatim inclusion of a given sentence (or verbal sequence) at some point in the text."@en ;
	rdfs:comment "Costrizione che impone l’inserzione letterale di una frase data (o sequenza verbale) in un punto qualsiasi del testo."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_19> a desmos:LiteraryConstraint ;
	rdfs:label "Literary genre constraint"@en ;
	rdfs:label "Costrizione del genere letterario"@it ;
	rdfs:comment "Constraint requiring adherence to a specified literary genre and its pragmatic and structural conventions (e.g., giallo)."@en ;
	rdfs:comment "Costrizione che impone l’adesione a un genere letterario determinato e alle sue convenzioni pragmatiche e strutturali (es. detective)."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:semantic .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_20> a desmos:LiteraryConstraint ;
	rdfs:label "Fixed title length constraint"@en ;
	rdfs:label "Lunghezza del titolo fissa"@it ;
	rdfs:comment "Constraint requiring an exact title length under a predefined criterion (e.g., number of letters), typically separate from the main text count."@en ;
	rdfs:comment "Costrizione che impone una lunghezza esatta del titolo secondo un criterio prefissato (es. numero di lettere), tipicamente distinta dal conteggio del corpo del testo."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:formal .

<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_21> a desmos:LiteraryConstraint ;
	rdfs:label "Page format constraint"@en ;
	rdfs:label "Costrizione di formato pagina"@it ;
	rdfs:comment "Constraint requiring a predetermined page format or spatial structure."@en ;
	rdfs:comment "Costrizione che impone un formato di pagina o una struttura spaziale predeterminata."@it ;
	desmos:constraintOrigin desmos:historical ;
	desmos:constraintScope desmos:formal .

### Linguistic Object ###
<https://w3id.org/desmos/oplepiana/ling_obj/ling_obj_01> a crm:E33_Linguistic_Object ;
	crm:P3_has_note "Il componimento è basato su di un eterogramma anagrammato cento volte in altrettante stringhe."^^xsd:string ;
	crm:P129_is_about <https://w3id.org/desmos/oplepiana/constraint/literary_constraint_01> ,
		<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_02> ;
	prov:wasAttributedTo <https://w3id.org/desmos/oplepiana/author/author_01> .

<https://w3id.org/desmos/oplepiana/ling_obj/ling_obj_02> a crm:E33_Linguistic_Object ;
	crm:P3_has_note "Rigrafia è la scrittura di un testo a partire da un altro testo dato."^^xsd:string ;
	crm:P129_is_about <https://w3id.org/desmos/oplepiana/constraint/literary_constraint_03> ;
	prov:wasAttributedTo <https://w3id.org/desmos/oplepiana/author/author_02> .

<https://w3id.org/desmos/oplepiana/ling_obj/ling_obj_03> a crm:E33_Linguistic_Object ;
	crm:P3_has_note "Una semplice sequenza ininterrotta di nomi di personaggi mitologici [...] si trasforma in un componimento poetico."^^xsd:string ;
	crm:P129_is_about <https://w3id.org/desmos/oplepiana/constraint/literary_constraint_06> ;
	prov:wasAttributedTo <https://w3id.org/desmos/oplepiana/author/author_03> .

<https://w3id.org/desmos/oplepiana/ling_obj/ling_obj_04> a crm:E33_Linguistic_Object ;
	crm:P3_has_note "Canto tenero è costituito da 14 strofe, ciascuna di 4 endecasillabi a rima alterna, con schema metrico ABAB CDCD."^^xsd:string ;
	crm:P129_is_about <https://w3id.org/desmos/oplepiana/constraint/literary_constraint_04> ,
		<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_05> ,
		<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_07> ;
	prov:wasAttributedTo <https://w3id.org/desmos/oplepiana/author/author_03> .

<https://w3id.org/desmos/oplepiana/ling_obj/ling_obj_05> a crm:E33_Linguistic_Object ;
	crm:P3_has_note "È parso interessante all’Autore «innestare il palindromo su una struttura: il sonetto»."^^xsd:string ;
	crm:P129_is_about <https://w3id.org/desmos/oplepiana/constraint/literary_constraint_04> ,
		<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_08> ,
		<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_09> ;
	prov:wasAttributedTo <https://w3id.org/desmos/oplepiana/author/author_01> .

<https://w3id.org/desmos/oplepiana/ling_obj/ling_obj_06> a crm:E33_Linguistic_Object ;
	crm:P3_has_note "Estratte dalla Commedia e dal Canzoniere [...] tutte le rime in -ita [...] ho cercato di combinarle, tentando anche, quando possibile, di [...] alternare i versi dell’uno e dell’altro poeta."^^xsd:string ;
	crm:P129_is_about <https://w3id.org/desmos/oplepiana/constraint/literary_constraint_10> ,
		<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_11> ;
	prov:wasAttributedTo <https://w3id.org/desmos/oplepiana/author/author_04> .

<https://w3id.org/desmos/oplepiana/ling_obj/ling_obj_07> a crm:E33_Linguistic_Object ;
	crm:P3_has_note "Mi son chiesta, però, cosa sarebbe successo se avessi preso una sola sequenza di lettere (un unico testo, dunque) e avessi provato a spezzare simultaneamente in due differenti modi tale sequenza, al fine di pervenire a parole diverse che, con aggiustamenti di punteggiatura, formassero due differenti testi, per di più bilingui."^^xsd:string ;
	crm:P129_is_about <https://w3id.org/desmos/oplepiana/constraint/literary_constraint_12> ;
	prov:wasAttributedTo <https://w3id.org/desmos/oplepiana/author/author_05> .

<https://w3id.org/desmos/oplepiana/ling_obj/ling_obj_08> a crm:E33_Linguistic_Object ;
	crm:P3_has_note "La struttura del «gioco dell’alfabeto raffigurato» si basa sulla costruzione di una «griglia letteraria»."^^xsd:string ;
	crm:P129_is_about <https://w3id.org/desmos/oplepiana/constraint/literary_constraint_13> ;
	prov:wasAttributedTo <https://w3id.org/desmos/oplepiana/author/author_06> .

<https://w3id.org/desmos/oplepiana/ling_obj/ling_obj_09> a crm:E33_Linguistic_Object ;
	crm:P3_has_note "Le regole sono: (1) la lunghezza di ogni testo è fissata in 25.586 caratteri (spazi inclusi); (2) per quanto riguarda le norme tipografiche si fa riferimento a quelle in uso nei volumi pubblicati dalla Casa Editrice Einaudi; (3) in ogni testo compaiono e agiscono quattro personaggi fissi e unici (O, P, L, E), ciascuno caratterizzato in modo esplicito da almeno un attributo che inizi con la lettera del proprio nome; (4) l’ambientazione scelta è Anghiari nell’anno 1996; (5) ogni testo deve contenere, in un punto qualsiasi della narrazione, la seguente frase: Ogni piccola luce evoca profonde oscurità; (6) il tema del racconto deve essere: mistery story o suspense; (7) il titolo del racconto, escluso dal computo dei caratteri del testo, deve essere di 13 lettere."^^xsd:string ;
	crm:P129_is_about <https://w3id.org/desmos/oplepiana/constraint/literary_constraint_14> ,
		<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_15> ,
		<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_16> ,
		<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_17> ,
		<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_18> ,
		<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_19> ,
		<https://w3id.org/desmos/oplepiana/constraint/literary_constraint_20> ;
	prov:wasAttributedTo <https://w3id.org/desmos/oplepiana/author/author_07> .

<https://w3id.org/desmos/oplepiana/ling_obj/ling_obj_10> a crm:E33_Linguistic_Object ;
	crm:P3_has_note "Tutti i 151 versi che compongono il Cruccio sono indiscutibilmente di mano del poeta, poiché rintracciabili esattamente fra quelli dei cento canti tradizionali."^^xsd:string ;
	crm:P129_is_about <https://w3id.org/desmos/oplepiana/constraint/literary_constraint_10> ;
	prov:wasAttributedTo <https://w3id.org/desmos/oplepiana/author/author_08> .

<https://w3id.org/desmos/oplepiana/ling_obj/ling_obj_11> a crm:E33_Linguistic_Object ;
	crm:P3_has_note "Restrizioni puramente quantitative sulla lunghezza dei brani […] in un caso una paginetta di una Moleskine […] nell’altro […] centosessanta caratteri degli SMS."^^xsd:string ;
	crm:P129_is_about <https://w3id.org/desmos/oplepiana/constraint/literary_constraint_21> ;
	prov:wasAttributedTo <https://w3id.org/desmos/oplepiana/author/author_09> .

