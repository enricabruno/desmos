	lrmoo:R15_has_fragment <https://w3id.org/desmos/oplepiana/ling_obj/ling_obj_02> ;
	lrmoo:R76_is_derivative_of <https://w3id.org/desmos/oplepiana/expression/expression_01> ;
	rdfs:seeAlso <https://www.oplepo.com/copia-di-p1> .

<https://w3id.org/desmos/oplepiana/expression/e_plaquette_03> a lrmoo:F2_Expression ;
