	lrmoo:R15_has_fragment <https://w3id.org/desmos/oplepiana/ling_obj/ling_obj_03> ;
	lrmoo:R76_is_derivative_of <https://w3id.org/desmos/oplepiana/expression/expression_02> ;
	rdfs:seeAlso <https://www.oplepo.com/copia-di-p1-1> .

<https://w3id.org/desmos/oplepiana/expression/e_plaquette_04> a lrmoo:F2_Expression ;
	dcterms:title "Deliri edipici"^^xsd:string ;
	lrmoo:R15_has_fragment <https://w3id.org/desmos/oplepiana/ling_obj/ling_obj_04> ,
		<https://w3id.org/desmos/oplepiana/ling_obj/ling_obj_05> ;
	rdfs:seeAlso <https://www.oplepo.com/copia-di-p2> .

