<?xml version="1.0"?>
<rdf:RDF xmlns:desmos="https://w3id.org/desmos/"
    xmlns="https://w3id.org/desmos/"
    xml:base="https://w3id.org/desmos/"
    xmlns:crm="http://www.cidoc-crm.org/cidoc-crm/"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:xml="http://www.w3.org/XML/1998/namespace"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:prov="http://www.w3.org/ns/prov#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:vann="http://purl.org/vocab/vann/"
    xmlns:lrmoo="http://iflastandards.info/ns/lrm/lrmoo/"
    xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/desmos/">
        <owl:versionIRI rdf:resource="https://w3id.org/desmos/v1.1.0"/>
        <dcterms:creator xml:lang="it">Anonimo (in revisione)</dcterms:creator>
        <dcterms:creator xml:lang="en">Anonymous (under review)</dcterms:creator>
        <dcterms:description xml:lang="en">DeSMòS (Descriptive Semantic Model for Structured Texts) is an OWL ontology designed to represent literary constraints as generative devices within the creative process. By modeling constraints as productive principles that steer writing and yield specific textual forms, the ontology provides a structured conceptual layer to describe: (i) constraints as procedures; (ii) their origin (tradition vs. authorial invention) via SKOS-encoded controlled vocabularies; and (iii) the evidence ensuring their identifiability (textual features and authorial declarations). DeSMòS supports the documentation and semantic querying of constrained writing practices and is aligned by reference with CIDOC CRM, LRMoo, PROV-O, SKOS, and Dublin Core.
        </dcterms:description>
        <dcterms:description xml:lang="it">DeSMòS (Descriptive Semantic Model for Structured Texts) è un’ontologia OWL finalizzata alla rappresentazione delle costrizioni letterarie intese come dispositivi generativi della creazione artistica. Il modello interpreta i vincoli come principi produttivi che orientano il processo di scrittura e determinano la genesi di forme testuali specifiche, fornendo un framework concettuale per descrivere: (i) le costrizioni come procedure; (ii) la loro origine (tradizione vs. invenzione autoriale) mediata da vocabolari controllati SKOS; e (iii) le evidenze che ne permettono l'identificazione (caratteristiche testuali e dichiarazioni autoriali). L'ontologia supporta la documentazione e l'interrogazione semantica delle pratiche di scrittura vincolata ed è allineata per riferimento agli standard CIDOC CRM, LRMoo, PROV-O, SKOS e Dublin Core.
        </dcterms:description>
        <dcterms:hasVersion>1.1.0</dcterms:hasVersion>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:source rdf:resource="http://www.cidoc-crm.org/cidoc-crm/"/>
        <dcterms:source rdf:resource="http://www.w3.org/2004/02/skos/core"/>
        <dcterms:source rdf:resource="https://cidoc-crm.org/extensions/lrmoo/"/>
        <dcterms:source rdf:resource="https://www.w3.org/ns/prov-o"/>
        <dcterms:title xml:lang="en">DeSMòS (Descriptive Semantic Model for Structured texts) Ontology</dcterms:title>
        <dcterms:title xml:lang="it">Ontologia DeSMòS (Descriptive Semantic Model for Structured texts)</dcterms:title>
        <vann:preferredNamespacePrefix>desmos</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/desmos/</vann:preferredNamespaceUri>
        <owl:versionInfo>1.1.0</owl:versionInfo>
    </owl:Ontology>
    



