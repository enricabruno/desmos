        <rdfs:comment xml:lang="en">Used to indicate a resource that might provide additional information about the subject resource.</rdfs:comment>
        <rdfs:label xml:lang="en">See also</rdfs:label>
        <rdfs:label xml:lang="it">Vedi anche</rdfs:label>
